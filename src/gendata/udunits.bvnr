  # ── Time ─────────────────────────────────────────────────────────────────
  # bovnar's yr is 31557600 s (365.25 d) and its mo is 2629800 s -- the JULIAN
  # year and its twelfth. UDUNITS' unqualified "year" is NOT that: it is
  # 3.15569259747e7 s, the TROPICAL year, and its "month" is that over twelve.
  # The two differ by 674 s -- eleven minutes a year, an hour every five -- which
  # is dimensionally perfect and invisible downstream, so "year", "yr" and
  # "month" are refused below and the Julian spelling is what maps.
  { .code = "min";         .bovnar = "min"; .metric = false; },
  { .code = "minute";      .bovnar = "min"; .metric = false; },
  { .code = "h";           .bovnar = "h";   .metric = false; },
  { .code = "hr";          .bovnar = "h";   .metric = false; },
  { .code = "hour";        .bovnar = "h";   .metric = false; },
  { .code = "d";           .bovnar = "d";   .metric = false; },
  { .code = "day";         .bovnar = "d";   .metric = false; },
  { .code = "week";        .bovnar = "wk";  .metric = false; },
  { .code = "Julian_year"; .bovnar = "yr";  .metric = false; },
  { .code = "fortnight";   .bovnar = "fn";  .metric = false; },

  # ── Temperature ──────────────────────────────────────────────────────────
  # The native affine discipline applies unchanged: valid at exponent 1 only,
  # and a compound containing one yields no conversion value.
  { .code = "degC";             .bovnar = "°C"; .metric = false; },
  { .code = "celsius";          .bovnar = "°C"; .metric = false; },
  { .code = "degree_Celsius";   .bovnar = "°C"; .metric = false; },
  { .code = "degrees_Celsius";  .bovnar = "°C"; .metric = false; },
  { .code = "degF";             .bovnar = "°F"; .metric = false; },
  { .code = "degree_Fahrenheit"; .bovnar = "°F"; .metric = false; },
  { .code = "degR";             .bovnar = "°Ra"; .metric = false; },

  # ── Angle ────────────────────────────────────────────────────────────────
  { .code = "degree";     .bovnar = "°";      .metric = false; },
  { .code = "degrees";    .bovnar = "°";      .metric = false; },
  { .code = "deg";        .bovnar = "°";      .metric = false; },
  { .code = "arcdeg";     .bovnar = "°";      .metric = false; },
  { .code = "arcmin";     .bovnar = "arcmin"; .metric = false; },
  { .code = "arcminute";  .bovnar = "arcmin"; .metric = false; },
  { .code = "arcsec";     .bovnar = "arcsec"; .metric = false; },
  { .code = "arcsecond";  .bovnar = "arcsec"; .metric = false; },
  { .code = "grade";      .bovnar = "grad";   .metric = false; },

  # ── Imperial and US customary: length ────────────────────────────────────
  # The international foot and its multiples only. UDUNITS defines "chain",
  # "rod", "furlong" and "fathom" on the US SURVEY foot (1200/3937 m), not on
  # the international one, so they are 2 ppm off the native atoms of the same
  # name and are refused below rather than mapped -- the same rule ucum.bvnr
  # applies to the survey inch and the survey mile.
  { .code = "in";                  .bovnar = "in";   .metric = false; },
  { .code = "inch";                .bovnar = "in";   .metric = false; },
  { .code = "international_inch";  .bovnar = "in";   .metric = false; },
  { .code = "ft";                  .bovnar = "ft";   .metric = false; },
  { .code = "foot";                .bovnar = "ft";   .metric = false; },
  { .code = "feet";                .bovnar = "ft";   .metric = false; },
  { .code = "international_foot";  .bovnar = "ft";   .metric = false; },
  { .code = "yd";                  .bovnar = "yd";   .metric = false; },
  { .code = "yard";                .bovnar = "yd";   .metric = false; },
  { .code = "international_yard";  .bovnar = "yd";   .metric = false; },
  { .code = "mi";                  .bovnar = "mi";   .metric = false; },
  { .code = "mile";                .bovnar = "mi";   .metric = false; },
  { .code = "international_mile";  .bovnar = "mi";   .metric = false; },
  { .code = "nmi";                 .bovnar = "nmi";  .metric = false; },
  { .code = "nmile";               .bovnar = "nmi";  .metric = false; },
  { .code = "nautical_mile";       .bovnar = "nmi";  .metric = false; },
  { .code = "US_survey_foot";      .bovnar = "ftUS"; .metric = false; },
  { .code = "mil";                 .bovnar = "thou"; .metric = false; },

  # ── Imperial and US customary: mass ──────────────────────────────────────
  # "oz" is NOT here: in UDUNITS it is a symbol of the US FLUID ounce, a
  # volume. See the volume block. The avoirdupois ounce is spelled out.
  { .code = "lb";                  .bovnar = "lb";   .metric = false; },
  { .code = "pound";               .bovnar = "lb";   .metric = false; },
  { .code = "avoirdupois_pound";   .bovnar = "lb";   .metric = false; },
  { .code = "avoirdupois_ounce";   .bovnar = "oz";   .metric = false; },
  { .code = "dr";                  .bovnar = "dr";   .metric = false; },
  { .code = "dram";                .bovnar = "dr";   .metric = false; },
  { .code = "grain";               .bovnar = "gr";   .metric = false; },
  # The apothecary spellings are accepted and never emitted, the same call
  # ucum.bvnr makes for "[oz_ap]": all three are worth one troy ounce, and only
  # "troy_ounce" says so. Without the flag "apounce" wins on length and every
  # troy ounce leaves this writer calling itself apothecary.
  { .code = "troy_ounce";          .bovnar = "oz_t"; .metric = false; },
  { .code = "apothecary_ounce";    .bovnar = "oz_t"; .metric = false; .reverse = false; },
  { .code = "apounce";             .bovnar = "oz_t"; .metric = false; .reverse = false; },
  { .code = "pennyweight";         .bovnar = "dwt";  .metric = false; },
  { .code = "scruple";             .bovnar = "sc";   .metric = false; },
  { .code = "carat";               .bovnar = "ct";   .metric = false; },
  { .code = "slug";                .bovnar = "slug"; .metric = false; },
  { .code = "ton";                 .bovnar = "tn_sh"; .metric = false; },
  { .code = "short_ton";           .bovnar = "tn_sh"; .metric = false; },
  { .code = "long_ton";            .bovnar = "tn_l";  .metric = false; },
  { .code = "metric_ton";          .bovnar = "t";     .metric = false; },

  # ── Imperial and US customary: volume ────────────────────────────────────
  # UDUNITS' bare "oz", "floz", "cup", "gill", "pint" and "quart" are the US
  # LIQUID measures; the UK ones carry a UK_ prefix and are separate atoms
  # here, as they are natively.
  { .code = "gallon";              .bovnar = "gal";      .metric = false; },
  { .code = "US_liquid_gallon";    .bovnar = "gal";      .metric = false; },
  { .code = "quart";               .bovnar = "qt";       .metric = false; },
  { .code = "US_liquid_quart";     .bovnar = "qt";       .metric = false; },
  { .code = "pint";                .bovnar = "pt";       .metric = false; },
  { .code = "US_liquid_pint";      .bovnar = "pt";       .metric = false; },
  # "pt" is UDUNITS' SYMBOL for the pint, and leaving it out did not make it an
  # error -- it made it a PICOTONNE. With no atom row the expression parser fell
  # back on the prefixed reading, p + t, so "udunits:pt" parsed clean and
  # returned 1e-9 kg for a document that said 473 mL: a mass where a volume was
  # written, no warning, wrong by nine orders of magnitude and a wrong dimension.
  #
  # This is the one thing an incomplete atom table can cost that an error message
  # cannot, and it is why closing the table matters beyond tidiness. A whole atom
  # outranks a prefixed reading (doc/11 §3.2), so the row is the entire fix.
  { .code = "pt";                  .bovnar = "pt";       .metric = false; .reverse = false; },
  { .code = "cup";                 .bovnar = "cup";      .metric = false; },
  { .code = "US_liquid_cup";       .bovnar = "cup";      .metric = false; },
  { .code = "gill";                .bovnar = "gi";       .metric = false; },
  { .code = "US_liquid_gill";      .bovnar = "gi";       .metric = false; },
  { .code = "oz";                  .bovnar = "fl_oz";    .metric = false; },
  { .code = "floz";                .bovnar = "fl_oz";    .metric = false; },
  { .code = "fluid_ounce";         .bovnar = "fl_oz";    .metric = false; },
  { .code = "US_fluid_ounce";      .bovnar = "fl_oz";    .metric = false; },
  { .code = "US_liquid_ounce";     .bovnar = "fl_oz";    .metric = false; },
  { .code = "fldr";                .bovnar = "fl_dr";    .metric = false; },
  { .code = "fluid_dram";          .bovnar = "fl_dr";    .metric = false; },
  { .code = "tbsp";                .bovnar = "tbsp";     .metric = false; },
  { .code = "tablespoon";          .bovnar = "tbsp";     .metric = false; },
  { .code = "tsp";                 .bovnar = "tsp";      .metric = false; },
  { .code = "teaspoon";            .bovnar = "tsp";      .metric = false; },
  { .code = "pk";                  .bovnar = "pk";       .metric = false; },
  { .code = "peck";                .bovnar = "pk";       .metric = false; },
  { .code = "bu";                  .bovnar = "bsh";      .metric = false; },
  { .code = "bushel";              .bovnar = "bsh";      .metric = false; },
  { .code = "bbl";                 .bovnar = "bbl";      .metric = false; },
  { .code = "barrel";              .bovnar = "bbl";      .metric = false; },
  { .code = "UK_liquid_gallon";    .bovnar = "gal_uk";   .metric = false; },
  { .code = "UK_liquid_quart";     .bovnar = "qt_uk";    .metric = false; },
  { .code = "UK_liquid_pint";      .bovnar = "pt_uk";    .metric = false; },
  { .code = "UK_liquid_gill";      .bovnar = "gi_uk";    .metric = false; },
  { .code = "UK_fluid_ounce";      .bovnar = "fl_oz_uk"; .metric = false; },
  { .code = "UK_liquid_ounce";     .bovnar = "fl_oz_uk"; .metric = false; },

  # ── Area ─────────────────────────────────────────────────────────────────
  # "are" is 100 m², a hundredth of the hectare, which is the same target UCUM
  # reaches for its "ar". "acre" is NOT native ac: UDUNITS defines it as 160
  # rod² on the survey rod, so it is the US SURVEY acre, 4 ppm off. It was
  # refused for that until the registry gained acUS; it maps there now, with
  # the survey series, below.
  { .code = "are";                 .bovnar = "c~ha"; .metric = false; },

  # ── Force, pressure, energy, power ───────────────────────────────────────
  # The unqualified "calorie" is NOT native cal. UDUNITS defines it as 4.1868 J,
  # the IT calorie, while bovnar's cal is the thermochemical 4.184 J -- 0.067 %
  # apart, dimensionally identical, and invisible to every later check. It was
  # refused for that until the registry gained cal_IT; it maps there now, and
  # the spelled-out thermochemical_calorie still maps to cal. UDUNITS' "Btu"
  # goes the other way: it is 1.05505585262e3 J, the IT BTU, which is exactly
  # what native Btu is, so it maps where UCUM's unqualified "[Btu]" cannot.
  { .code = "psi";                    .bovnar = "psi";  .metric = false; },
  { .code = "atm";                    .bovnar = "atm";  .metric = false; },
  { .code = "atmosphere";             .bovnar = "atm";  .metric = false; },
  { .code = "standard_atmosphere";    .bovnar = "atm";  .metric = false; },
  { .code = "at";                     .bovnar = "at";   .metric = false; },
  { .code = "technical_atmosphere";   .bovnar = "at";   .metric = false; },
  { .code = "torr";                   .bovnar = "Torr"; .metric = false; },
  { .code = "mmHg";                   .bovnar = "mmHg"; .metric = false; },
  { .code = "mm_Hg";                  .bovnar = "mmHg"; .metric = false; },
  { .code = "inHg";                   .bovnar = "inHg"; .metric = false; },
  { .code = "in_Hg";                  .bovnar = "inHg"; .metric = false; },

  # ── The units bu_survey_* and friends unblocked ──────────────────────
  #
  # UDUNITS builds chain, rod, furlong, fathom and acre on the US SURVEY
  # foot, which is why they could not map onto the international lengths of
  # the same name and had to be refused. They map onto the survey ones now.
  # `pole` and `perch` are UDUNITS' own aliases for the rod.
  { .code = "chain";        .bovnar = "chUS"; .metric = false; },
  { .code = "rod";          .bovnar = "rdUS"; .metric = false; },
  { .code = "pole";         .bovnar = "rdUS"; .metric = false; .reverse = false; },
  { .code = "perch";        .bovnar = "rdUS"; .metric = false; .reverse = false; },
  { .code = "furlong";      .bovnar = "furUS"; .metric = false; },
  { .code = "fathom";       .bovnar = "fathUS"; .metric = false; },
  { .code = "acre";         .bovnar = "acUS"; .metric = false; },
  { .code = "US_survey_yard";.bovnar = "ydUS"; .metric = false; },
  { .code = "US_survey_mile";.bovnar = "miUS"; .metric = false; },
  { .code = "US_statute_mile";.bovnar = "miUS"; .metric = false; .reverse = false; },
  { .code = "big_point";    .bovnar = "pnt"; .metric = false; },
  { .code = "shake";        .bovnar = "shake"; .metric = false; },
  # "no native form" was true until mo_syn arrived; UDUNITS' lunar month IS
  # the synodal month, 29.53059 d, which is exactly what mo_syn states.
  # It is also the only UDUNITS spelling of mo_syn, so it carries no
  # .reverse = false: without a writable row the profile could read the unit
  # and never write it, which gen_profiles.py refuses outright.
  { .code = "lunar_month";  .bovnar = "mo_syn"; .metric = false; },
  { .code = "darcy";        .bovnar = "darcy"; .metric = false; },
  { .code = "acre_foot";    .bovnar = "ac_ft"; .metric = false; },
  { .code = "acre_feet";    .bovnar = "ac_ft"; .metric = false; .reverse = false; },
  { .code = "board_foot";   .bovnar = "fbm"; .metric = false; },
  { .code = "board_feet";   .bovnar = "fbm"; .metric = false; .reverse = false; },
  { .code = "US_dry_gallon";.bovnar = "gal_dry"; .metric = false; },
  { .code = "US_dry_quart"; .bovnar = "qt_dry"; .metric = false; },
  { .code = "dry_quart";    .bovnar = "qt_dry"; .metric = false; .reverse = false; },
  { .code = "US_dry_pint";  .bovnar = "pt_dry"; .metric = false; },
  { .code = "dry_pint";     .bovnar = "pt_dry"; .metric = false; .reverse = false; },
  { .code = "refrigeration_ton";.bovnar = "ton_ref"; .metric = false; },
  { .code = "ton_of_refrigeration";.bovnar = "ton_ref"; .metric = false; .reverse = false; },
  { .code = "tons_of_refrigeration";.bovnar = "ton_ref"; .metric = false; .reverse = false; },

  # ── Water and mercury columns ─────────────────────────────────────────
  #
  # UDUNITS states both columns as pressure GRADIENTS -- `H2O` is
  # `gravity 1000 kg/m^3`, i.e. 9806.65 Pa per metre -- and then builds every
  # pressure as a LENGTH times one of them: cmH2O is `cm H2O`, inHg is
  # `inch Hg`. bovnar can say that exactly: mH2O/m and mmHg/m~m are the two
  # gradients, so the atoms map and the expressions built on them fall out of
  # the profile's own grammar rather than needing a row each.
  #
  # The water column needed bu_meter_water, which is why these were refused
  # until it existed; the mercury one did not, and was refused only because a
  # gradient was read as 'not a native unit'.
  { .code = "H2O";                     .bovnar = "mH2O/m";      .metric = false; .reverse = false; },
  { .code = "h2o";                     .bovnar = "mH2O/m";      .metric = false; .reverse = false; },
  { .code = "conventional_water";      .bovnar = "mH2O/m";      .metric = false; .reverse = false; },
  { .code = "water";                   .bovnar = "mH2O/m";      .metric = false; .reverse = false; },
  { .code = "cm_H2O";                  .bovnar = "c~mH2O";      .metric = false; .reverse = false; },
  { .code = "cmH2O";                   .bovnar = "c~mH2O";      .metric = false; },
  { .code = "ftH2O";                   .bovnar = "ft·mH2O/m";   .metric = false; .reverse = false; },
  { .code = "fth2o";                   .bovnar = "ft·mH2O/m";   .metric = false; .reverse = false; },
  { .code = "foot_water";              .bovnar = "ft·mH2O/m";   .metric = false; .reverse = false; },
  { .code = "feet_water";              .bovnar = "ft·mH2O/m";   .metric = false; .reverse = false; },
  { .code = "foot_H2O";                .bovnar = "ft·mH2O/m";   .metric = false; .reverse = false; },
  { .code = "feet_H2O";                .bovnar = "ft·mH2O/m";   .metric = false; .reverse = false; },
  { .code = "footH2O";                 .bovnar = "ft·mH2O/m";   .metric = false; .reverse = false; },
  { .code = "feetH2O";                 .bovnar = "ft·mH2O/m";   .metric = false; .reverse = false; },
  { .code = "Hg";                      .bovnar = "mmHg/m~m";    .metric = false; .reverse = false; },
  { .code = "mercury_0C";              .bovnar = "mmHg/m~m";    .metric = false; .reverse = false; },
  { .code = "mercuries_0C";            .bovnar = "mmHg/m~m";    .metric = false; .reverse = false; },
  { .code = "mercury_32F";             .bovnar = "mmHg/m~m";    .metric = false; .reverse = false; },
  { .code = "mercuries_32F";           .bovnar = "mmHg/m~m";    .metric = false; .reverse = false; },
  { .code = "conventional_mercury";    .bovnar = "mmHg/m~m";    .metric = false; .reverse = false; },
  { .code = "conventional_mercuries";  .bovnar = "mmHg/m~m";    .metric = false; .reverse = false; },

  # UDUNITS' unqualified calorie is the INTERNATIONAL TABLE one (4.1868 J);
  # its thermochemical_calorie is what bovnar spells `cal`. Both now have a
  # unit of their own to land on, so neither has to be refused to keep the
  # other honest.
  { .code = "calorie";                 .bovnar = "cal_IT";      .metric = false; .reverse = false; },
  { .code = "cal";                     .bovnar = "cal_IT";      .metric = false; },
  { .code = "IT_calorie";              .bovnar = "cal_IT";      .metric = false; .reverse = false; },

  # Apothecary and troy masses. The apothecary pound is twelve apothecary
  # ounces and an apothecary ounce IS a troy ounce, so all three spellings
  # are one unit; `troy_pound` is the one it is written back as.
  { .code = "troy_pound";              .bovnar = "lb_t";        .metric = false; },
  { .code = "apothecary_pound";        .bovnar = "lb_t";        .metric = false; .reverse = false; },
  { .code = "appound";                 .bovnar = "lb_t";        .metric = false; .reverse = false; },
  { .code = "apdram";                  .bovnar = "dr_ap";       .metric = false; },
  { .code = "long_hundredweight";      .bovnar = "cwt_l";       .metric = false; },
  { .code = "inch_Hg";                .bovnar = "inHg"; .metric = false; },
  { .code = "lbf";                    .bovnar = "lbf";  .metric = false; },
  { .code = "pound_force";            .bovnar = "lbf";  .metric = false; },
  { .code = "force_pound";            .bovnar = "lbf";  .metric = false; },
  { .code = "kgf";                    .bovnar = "kgf";  .metric = false; },
  { .code = "kilogram_force";         .bovnar = "kgf";  .metric = false; },
  { .code = "force_kilogram";         .bovnar = "kgf";  .metric = false; },
  { .code = "dyne";                   .bovnar = "dyn";  .metric = false; },
  { .code = "gravity";                .bovnar = "gn";   .metric = false; },
  { .code = "standard_free_fall";     .bovnar = "gn";   .metric = false; },
  { .code = "thermochemical_calorie"; .bovnar = "cal";  .metric = false; },
  { .code = "Btu";                    .bovnar = "Btu";  .metric = false; },
  { .code = "kip";                    .bovnar = "kip";  .metric = false; },
  { .code = "metric_horsepower";      .bovnar = "PS";   .metric = false; },
  { .code = "IT_Btu";                 .bovnar = "Btu";  .metric = false; },
  { .code = "therm";                  .bovnar = "thm";  .metric = false; },
  { .code = "US_therm";               .bovnar = "thm";  .metric = false; },
  # The EC therm. This was refused as "native thm is the US therm" long after
  # thm_ec arrived -- true about thm, and not the question. UDUNITS states the
  # EC therm as 1.05506e8 J, a six-digit rounding of the exact 100 000 Btu_IT =
  # 105 505 585.262 J that native thm_ec carries; the row two lines up shows the
  # same file stating the US therm exactly, which is what a rounding rather than
  # a different unit looks like. Waived by name in check_profile_factors.py.
  { .code = "EC_therm";               .bovnar = "thm_ec";  .metric = false; },
  { .code = "erg";                    .bovnar = "erg";  .metric = false; },
  { .code = "electron_volt";          .bovnar = "eV";   .metric = true;  },
  { .code = "horsepower";             .bovnar = "hp";   .metric = false; },
  { .code = "shaft_horsepower";       .bovnar = "hp";   .metric = false; },
  { .code = "voltampere";             .bovnar = "VA";   .metric = false; },
  { .code = "VA";                     .bovnar = "VA";   .metric = false; },

  # ── Speed, rotation, mass concentration ──────────────────────────────────
  { .code = "knot";                .bovnar = "kn";      .metric = false; },
  { .code = "kt";                  .bovnar = "kn";      .metric = false; },
  { .code = "international_knot";  .bovnar = "kn";      .metric = false; },
  { .code = "revolution";          .bovnar = "rev";     .metric = false; },
  { .code = "rotation";            .bovnar = "rev";     .metric = false; },
  { .code = "turn";                .bovnar = "rev";     .metric = false; },
  { .code = "cycle";               .bovnar = "rev";     .metric = false; },
  { .code = "circle";              .bovnar = "rev";     .metric = false; },
  # UDUNITS defines rpm as "rotation/minute", i.e. an ANGULAR velocity, which is
  # rev/min here and not native rpm -- rpm counts revolutions and comes out 2π
  # too small against it. Same reading as qudt:REV-PER-MIN and unece:M46, and
  # the reason all three now land on one target.
  { .code = "rpm";                 .bovnar = "rev/min"; .metric = false; },
  { .code = "denier";              .bovnar = "den";     .metric = false; },
  { .code = "tex";                 .bovnar = "tex";     .metric = false; },

  # ── CGS electromagnetic, photometric, radiological ───────────────────────
  # "b" is the BARN here, not the bit -- the same collision UCUM has, and the
  # reason doc/11 §6.2 exists. Native "b" is unaffected: a profile code is
  # only ever read against its own atom table.
  { .code = "poise";      .bovnar = "P";     .metric = false; },
  { .code = "stokes";     .bovnar = "St";    .metric = false; },
  { .code = "gauss";      .bovnar = "G";     .metric = false; },
  # "gal" is the GALILEO, 1 cm/s². The gallon is spelled out -- UDUNITS does
  # not abbreviate it -- so the two cannot be confused here, but a table built
  # by guessing at abbreviations would map a volume onto an acceleration.
  { .code = "gal";        .bovnar = "Gal";   .metric = false; },
  { .code = "maxwell";    .bovnar = "Mx";    .metric = false; },
  { .code = "oersted";    .bovnar = "Oe";    .metric = false; },
  { .code = "abampere";   .bovnar = "da~A";  .metric = false; },
  { .code = "stilb";      .bovnar = "sb";    .metric = false; },
  { .code = "phot";       .bovnar = "ph";    .metric = false; },
  { .code = "nit";        .bovnar = "cd/m^2"; .metric = false; },
  { .code = "nt";         .bovnar = "cd/m^2"; .metric = false; },
  { .code = "b";          .bovnar = "barn";  .metric = false; },
  { .code = "curie";      .bovnar = "Ci";    .metric = false; },
  { .code = "roentgen";   .bovnar = "R";     .metric = false; },
  { .code = "R";          .bovnar = "R";     .metric = false; },
  { .code = "rem";        .bovnar = "rem";   .metric = false; },

  # ── Mass of an atom ──────────────────────────────────────────────────────
  # "unified_atomic_mass_unit" is UDUNITS' fourth spelling and now maps too, in
  # the completion block below. It could not when this block was written: at 24
  # bytes it pushed this profile's worst-case emitted string past
  # BVNR_UNIT_STRING_MAX, which gen_profiles.py refuses to generate, and the
  # constant went from 1024 to 1088 to take it.
  #
  # It was raised further than 24 bytes alone needed, for
  # "astronomical_unit_BIPM_2006" at 27 -- a row since found UNREACHABLE (see
  # the head of .unsupported) and moved out of the emitted set. 24 bytes is the
  # longest emittable code again, so the bound this profile actually requires is
  # back under 1024. The constant STAYS at 1088: a maximum larger than the
  # tables need costs a caller nothing, while shrinking a published constant
  # every consumer sizes its buffers from is churn no defect asks for.
  { .code = "u";                  .bovnar = "Da"; .metric = false; },
  { .code = "amu";                .bovnar = "Da"; .metric = false; },
  { .code = "atomic_mass_unit";   .bovnar = "Da"; .metric = false; },

  # ── Ratios and logarithms ────────────────────────────────────────────────
  { .code = "percent";   .bovnar = "%";   .metric = false; },
  { .code = "%";         .bovnar = "%";   .metric = false; },
  { .code = "ppm";       .bovnar = "ppm"; .metric = false; },
  { .code = "ppb";       .bovnar = "ppb"; .metric = false; },
  # The two below ppb. UDUNITS states them exactly (1e-12, 1e-15) and agrees
  # with UCUM's [pptr]; the native symbol is `pptr` rather than `ppt` because
  # `ppt` already resolves as p~pt, the picopint -- see the note in units.bvnr.
  { .code = "ppt";       .bovnar = "pptr"; .metric = false; },
  { .code = "ppq";       .bovnar = "ppq"; .metric = false; },
  { .code = "dB";        .bovnar = "dB";  .metric = false; },
  { .code = "decibel";   .bovnar = "dB";  .metric = false; },
  { .code = "Np";        .bovnar = "Np";  .metric = true;  },
  { .code = "neper";     .bovnar = "Np";  .metric = true;  },
  { .code = "pH";        .bovnar = "pH";  .metric = false; },

  # ── Information ──────────────────────────────────────────────────────────
  # UDUNITS' "byte" is defined as 8 (dimensionless), i.e. eight bits; bovnar
  # models bit and byte as two base units of information with no factor
  # between them, so the 8 is a modelling difference and not a scale to fold.
  { .code = "bit";       .bovnar = "b";   .metric = true;  },
  { .code = "byte";      .bovnar = "B";   .metric = true;  },
  { .code = "baud";      .bovnar = "Bd";  .metric = true;  },
  { .code = "Bd";        .bovnar = "Bd";  .metric = true;  },

  # ── Closing the table against the UDUNITS-2 database ─────────────────────
  #
  # Every spelling below is one UDUNITS defines and this table did not name, so
  # it came back as error_unit_illegal -- "that is not a UDUNITS unit" -- about
  # units UDUNITS does define. Most are ALIASES of a unit already mapped here:
  # UDUNITS treats "kelvin", "degrees_kelvin", "degK" and "deg_K" as spellings
  # of one unit, and a table that takes the first and rejects the last is
  # refusing CF's commonest spelling of a unit it already carries.
  #
  # .reverse = false throughout. These rows exist so a producer's string is
  # READ; none of them should change what bovnar WRITES, and leaving the
  # reverse table untouched keeps §5.3's round-trip sweep where it is.
  #
  # .metric is inherited from the sibling that was already mapped, and is false
  # for a unit that had no sibling: refusing a prefixed spelling costs an error
  # message, accepting one nothing checked costs a wrong number.
  { .code = "Ω";                       .bovnar = "Ω";             .metric = true;  .reverse = false; },  # alias of ohm
  { .code = "Ω";                       .bovnar = "Ω";             .metric = true;  .reverse = false; },  # alias of ohm
  { .code = "°C";                      .bovnar = "°C";            .metric = false; .reverse = false; },  # alias of degree_Celsius
  { .code = "°";                       .bovnar = "°";             .metric = false; .reverse = false; },  # alias of degree
  { .code = "arc_degree";              .bovnar = "°";             .metric = false; .reverse = false; },  # alias of degree
  { .code = "angular_degree";          .bovnar = "°";             .metric = false; .reverse = false; },  # alias of degree
  { .code = "'";                       .bovnar = "arcmin";        .metric = false; .reverse = false; },  # alias of arcminute
  { .code = "′";                       .bovnar = "arcmin";        .metric = false; .reverse = false; },  # alias of arcminute
  { .code = "arc_minute";              .bovnar = "arcmin";        .metric = false; .reverse = false; },  # alias of arcminute
  { .code = "angular_minute";          .bovnar = "arcmin";        .metric = false; .reverse = false; },  # alias of arcminute
  { .code = "\"";                       .bovnar = "arcsec";        .metric = false; .reverse = false; },  # alias of arcsecond
  { .code = "″";                       .bovnar = "arcsec";        .metric = false; .reverse = false; },  # alias of arcsecond
  { .code = "arc_second";              .bovnar = "arcsec";        .metric = false; .reverse = false; },  # alias of arcsecond
  { .code = "angular_second";          .bovnar = "arcsec";        .metric = false; .reverse = false; },  # alias of arcsecond
  { .code = "unified_atomic_mass_unit"; .bovnar = "Da";            .metric = false; .reverse = false; },  # alias of u
  { .code = "atomicmassunit";          .bovnar = "Da";            .metric = false; .reverse = false; },  # alias of u
  { .code = "knot_international";      .bovnar = "kn";            .metric = false; .reverse = false; },  # alias of international_knot
  { .code = "Å";                       .bovnar = "Å";             .metric = false; .reverse = false; },  # alias of Å
  { .code = "ångström";                .bovnar = "Å";             .metric = false; .reverse = false; },  # alias of Å
  { .code = "a";                       .bovnar = "c~ha";          .metric = false; .reverse = false; },  # alias of are
  { .code = "Ci";                      .bovnar = "Ci";            .metric = false; .reverse = false; },  # alias of curie
  { .code = "°K";                      .bovnar = "K";             .metric = false; .reverse = false; },
  { .code = "degree_kelvin";           .bovnar = "K";             .metric = false; .reverse = false; },
  { .code = "degrees_kelvin";          .bovnar = "K";             .metric = false; .reverse = false; },
  { .code = "degree_K";                .bovnar = "K";             .metric = false; .reverse = false; },
  { .code = "degrees_K";               .bovnar = "K";             .metric = false; .reverse = false; },
