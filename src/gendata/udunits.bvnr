  { .code = "langley";                 .bovnar = "cal/c~m^2";     .metric = false; .reverse = false; },
  { .code = "kayser";                  .bovnar = "c~m^-1";        .metric = false; .reverse = false; },
  { .code = "gp";                      .bovnar = "gn";            .metric = false; .reverse = false; },
  { .code = "geopotential";            .bovnar = "gn";            .metric = false; .reverse = false; },
  { .code = "dynamic";                 .bovnar = "gn";            .metric = false; .reverse = false; },
  { .code = "PVU";                     .bovnar = "m~m^2·K/s·k~g"; .metric = false; .reverse = false; },
  { .code = "potential_vorticity_unit"; .bovnar = "m~m^2·K/s·k~g"; .metric = false; .reverse = false; },
  { .code = "octet";                   .bovnar = "B";             .metric = true;  .reverse = false; },  # alias of byte
];

# UDUNITS has no assay-defined units the way UCUM does; everything either maps
# onto the native registry or is refused, so this profile owns no opaque range.
.opaque = [];

.unsupported = [
  # ── Reference time ───────────────────────────────────────────────────────
  # The construct this profile is most often asked for, and the one it cannot
  # carry. A bovnar timestamp is <datetime:width,epoch>: the EPOCH lives in the
  # type spec's base slot, which a unit-slot expression cannot reach, and the
  # CARRIER is defined as a count of seconds, which "days since ..." is not.
  # Both would have to change for this to land, and neither is a unit question.
  #
  # The refusal is NOT driven by this row. A reference-time expression cannot be
  # split into atoms at all -- the lexer has already deleted its spaces, so
  # "days since 1970-01-01" arrives as one token -- so bovnar_profiles.c refuses
  # any udunits code CONTAINING "since", via the refuse_substr hook on the
  # registry row. The row is kept because this is where a maintainer looks for
  # the reason, and because it makes a bare "udunits:since" refuse identically.
  { .code = "since"; .why = "reference time — a bovnar timestamp is <datetime:width,epoch>; the epoch is a type parameter, not a unit, and the carrier counts seconds"; },

  # ── Dimensionless placeholders ───────────────────────────────────────────
  # CF writes a dimensionless variable's units as "1". There is no row for "1"
  # here: the shared expr parser resolves a bare power of ten to UNITY before
  # any table is consulted, so "udunits:1" yields a value with no unit, exactly
  # as "ucum:1" does. That is the right answer and listing it would be dead
  # data. "count" is a name rather than a numeral and does need a row.
  { .code = "count"; .why = "a bare count — omit the unit slot instead"; },

  # ── Coordinate pseudo-units ──────────────────────────────────────────────
  # CF's rotated-pole and geographic direction markers. These are not units at
  # all: they say which way an angle is measured, which is a coordinate-system
  # statement bovnar's unit model has no place for.
  { .code = "degrees_north"; .why = "a coordinate direction, not a unit — write ° and record the direction elsewhere"; },
  { .code = "degrees_east";  .why = "a coordinate direction, not a unit — write ° and record the direction elsewhere"; },
  { .code = "degrees_south"; .why = "a coordinate direction, not a unit"; },
  { .code = "degrees_west";  .why = "a coordinate direction, not a unit"; },
  { .code = "degree_north";  .why = "a coordinate direction, not a unit"; },
  { .code = "degree_east";   .why = "a coordinate direction, not a unit"; },

  # ── Logarithms with a reference level ────────────────────────────────────
  # UDUNITS spells these lg(re 1 mW) and similar; bovnar's dB carries no
  # reference, so translating would let a power level compare equal to a
  # voltage level.
  { .code = "dBm";  .why = "dB relative to a milliwatt — dB carries no reference level"; },
  { .code = "dBW";  .why = "dB relative to a watt — dB carries no reference level"; },
  { .code = "dBV";  .why = "dB relative to a volt — dB carries no reference level"; },

  # ── Sidereal and tropical time ───────────────────────────────────────────
  # bovnar's yr is the Julian year exactly; these are different lengths and
  # have no native form.
  #
  # "year", "yr" and "month" belong to this list and not to .mapped, which is
  # the correction this block exists to record. UDUNITS' unqualified year is
  # 3.15569259747e7 s -- the TROPICAL year -- not the Julian 3.15576e7 s the
  # native yr is. Mapping them onto yr was wrong by 674 s per year: the same
  # shape of error doc/11 §6.3 records for the BTU, and just as invisible.
  # "Julian_year" is UDUNITS' own spelling for what bovnar means and it maps.
  { .code = "year";          .why = "the unqualified UDUNITS year is the tropical year (3.15569259747e7 s); bovnar's yr is the Julian year — write Julian_year"; },
  { .code = "yr";            .why = "the unqualified UDUNITS yr is the tropical year; bovnar's yr is the Julian year — write Julian_year"; },
  { .code = "month";         .why = "a twelfth of the tropical year; bovnar's mo is a twelfth of the Julian year"; },
  { .code = "tropical_year"; .why = "no native form — bovnar's yr is the Julian year"; },
  { .code = "sidereal_year"; .why = "no native form — bovnar's yr is the Julian year"; },
  { .code = "Gregorian_year"; .why = "no native form — bovnar's yr is the Julian year"; },
  { .code = "common_year";   .why = "365 days exactly — no native form"; },
  { .code = "leap_year";     .why = "366 days exactly — no native form"; },
  { .code = "sidereal_day";  .why = "no native form — bovnar's d is the solar day"; },
  { .code = "lunar_month";   .why = "synodal month — no native form"; },
  { .code = "sidereal_month"; .why = "no native form — bovnar's mo is the Julian month"; },
  { .code = "tropical_month"; .why = "no native form — bovnar's mo is the Julian month"; },

  # ── Survey-foot lengths ──────────────────────────────────────────────────
  # UDUNITS builds these on the US survey foot (1200/3937 m), so each is
  # 2 ppm longer than the native atom that shares its name -- and the acre,
  # being an area, is 4 ppm out. Mapping them would be dimensionally perfect
  # and silently wrong, which is the one failure this format exists to stop.
  # ucum.bvnr refuses the survey inch and mile for exactly this reason.
  { .code = "chain";   .why = "US survey chain (66 survey feet); native ch is the international chain"; },
  { .code = "rod";     .why = "US survey rod (16.5 survey feet); native rd is the international rod"; },
  { .code = "furlong"; .why = "US survey furlong (660 survey feet); native fur is the international furlong"; },
  { .code = "fathom";  .why = "US survey fathom (6 survey feet); native fath is the international fathom"; },
  { .code = "acre";    .why = "US survey acre (160 survey rod²); native ac is the international acre"; },

  # ── Calories that are not the thermochemical one ─────────────────────────
  # Native cal is 4.184 J. UDUNITS' unqualified "calorie" is the IT calorie,
  # 4.1868 J -- 0.067 % away and dimensionally identical, so it cannot map.
  #
  # UDUNITS' own "thermochemical_calorie" IS native cal exactly and now maps.
  # It could not when this block was written: at 22 bytes it put the profile's
  # worst case over BVNR_UNIT_STRING_MAX, which was 192. That constant is 1024
  # now, so the spelling fits and the unqualified forms below stay refused.
  { .code = "calorie";                .why = "the unqualified UDUNITS calorie is the IT calorie (4.1868 J); native cal is thermochemical — write the native cal"; },
  { .code = "cal";                    .why = "the unqualified UDUNITS cal is the IT calorie; native cal is thermochemical — write the native cal"; },
  { .code = "IT_calorie";             .why = "IT calorie (4.1868 J); native cal is thermochemical"; },

  # ── Scales with no decade to fold into ───────────────────────────────────
  { .code = "shake"; .why = "1e-8 s — there is no SI prefix for 10⁻⁸"; },

  # ── Closing the table against the UDUNITS-2 database ─────────────────────
  #
  # The other half of the same pass. A code here is one UDUNITS defines and this
  # build cannot carry, so it now fails as error_unit_profile_unsupported and
  # says why, instead of as error_unit_illegal. None of these needed a
  # conversion factor to be written down.
  #
  # Where a family shares an argument -- the referenced bels, the CGS
  # electrostatic units, the 1/pi photometric units, the water column -- every
  # spelling of it carries the same reason, so a producer who meets one and
  # then another is told the same thing twice rather than two different things.
  { .code = "π";                       .why = "the number pi — a constant, not a unit"; },
  { .code = "pi";                      .why = "the number pi — a constant, not a unit"; },
  { .code = "einstein";                .why = "a mole of photons; UDUNITS defines it as the bare mole, and carrying it as mol would lose the photon"; },
  { .code = "avogadro_constant";       .why = "Avogadro's number — a constant, not a unit"; },
  { .code = "ppv";                     .why = "parts per volume — UDUNITS defines it as the number one, which is worth what every native ratio is worth"; },
  { .code = "ppt";                     .why = "parts per trillion — native ratios stop at ppb"; },
  { .code = "pptv";                    .why = "parts per trillion — native ratios stop at ppb"; },
  { .code = "ppq";                     .why = "parts per quadrillion — native ratios stop at ppb"; },
  { .code = "ppqv";                    .why = "parts per quadrillion — native ratios stop at ppb"; },
  { .code = "degree_N";                .why = "a coordinate direction, not a unit"; },
  { .code = "degrees_N";               .why = "a coordinate direction, not a unit"; },
  { .code = "degreeN";                 .why = "a coordinate direction, not a unit"; },
  { .code = "degreesN";                .why = "a coordinate direction, not a unit"; },
  { .code = "degree_E";                .why = "a coordinate direction, not a unit"; },
  { .code = "degrees_E";               .why = "a coordinate direction, not a unit"; },
  { .code = "degreeE";                 .why = "a coordinate direction, not a unit"; },
  { .code = "degreesE";                .why = "a coordinate direction, not a unit"; },
  { .code = "degree_true";             .why = "a coordinate direction, not a unit"; },
  { .code = "degrees_true";            .why = "a coordinate direction, not a unit"; },
  { .code = "degree_T";                .why = "a coordinate direction, not a unit"; },
  { .code = "degrees_T";               .why = "a coordinate direction, not a unit"; },
  { .code = "degreeT";                 .why = "a coordinate direction, not a unit"; },
  { .code = "degreesT";                .why = "a coordinate direction, not a unit"; },
  { .code = "degree_west";             .why = "a coordinate direction, not a unit"; },
  { .code = "degree_W";                .why = "a coordinate direction, not a unit"; },
  { .code = "degrees_W";               .why = "a coordinate direction, not a unit"; },
  { .code = "degreeW";                 .why = "a coordinate direction, not a unit"; },
  { .code = "degreesW";                .why = "a coordinate direction, not a unit"; },
  { .code = "assay_ton";               .why = "assay ton (29.16667 g) — not a decade off any native mass"; },
  { .code = "long_hundredweight";      .why = "long hundredweight (112 lb) — 112 is not a decade"; },
  { .code = "troy_pound";              .why = "troy pound (12 troy ounces) — no native form"; },
  { .code = "apothecary_pound";        .why = "troy pound (12 troy ounces) — no native form"; },
  { .code = "apdram";                  .why = "apothecary dram; native dr is the avoirdupois dram"; },
  { .code = "appound";                 .why = "apothecary pound (12 troy ounces) — no native form"; },
  { .code = "bag";                     .why = "bag (94 lb) — 94 is not a decade"; },
  { .code = "printers_point";          .why = "printer's point — no native typographic length"; },
  { .code = "printers_pica";           .why = "printer's pica — no native typographic length"; },
  { .code = "pica";                    .why = "printer's pica — no native typographic length"; },
  { .code = "US_survey_yard";          .why = "US survey yard — bovnar carries only the survey foot"; },
  { .code = "US_survey_mile";          .why = "US survey mile — bovnar carries only the survey foot"; },
  { .code = "US_statute_mile";         .why = "US survey mile — bovnar carries only the survey foot"; },
  { .code = "pole";                    .why = "US survey rod (16.5 survey feet); native rd is the international rod"; },
  { .code = "perch";                   .why = "US survey rod (16.5 survey feet); native rd is the international rod"; },
  { .code = "big_point";               .why = "big point (1/72 inch) — no native typographic length"; },
  { .code = "barleycorn";              .why = "barleycorn (1/3 inch) — thirds are not decades"; },
  { .code = "arpentlin";               .why = "arpentlin (191.835 ft) — no native form"; },
  { .code = "rps";                     .why = "rotations per second — a rotation is 2*pi radian and 2*pi is not a decade"; },
  { .code = "cps";                     .why = "rotations per second — a rotation is 2*pi radian and 2*pi is not a decade"; },
  { .code = "rotation_per_second";     .why = "rotations per second — a rotation is 2*pi radian and 2*pi is not a decade"; },
  { .code = "rotations_per_second";    .why = "rotations per second — a rotation is 2*pi radian and 2*pi is not a decade"; },
  { .code = "perm_0C";                 .why = "permeance at 0 degC — no native form"; },
  { .code = "perms_0C";                .why = "permeance at 0 degC — no native form"; },
  { .code = "perm_23C";                .why = "permeance at 23 degC — no native form"; },
  { .code = "perms_23C";               .why = "permeance at 23 degC — no native form"; },
  { .code = "circular_mil";            .why = "circular mil — pi/4 of a square mil, irrational against the native units"; },
  { .code = "darcy";                   .why = "darcy — no native permeability unit"; },
  { .code = "acre_foot";               .why = "acre foot — no native form"; },
  { .code = "acre_feet";               .why = "acre foot — no native form"; },
  { .code = "board_foot";              .why = "board foot (144 cubic inches) — 144 is not a decade"; },
  { .code = "board_feet";              .why = "board foot (144 cubic inches) — 144 is not a decade"; },
  { .code = "US_dry_gallon";           .why = "US dry gallon — native gal is the liquid gallon"; },
  { .code = "register_ton";            .why = "register ton (100 cubic feet) — no native form"; },
  { .code = "US_dry_quart";            .why = "US dry quart — native qt is the liquid quart"; },
  { .code = "dry_quart";               .why = "US dry quart — native qt is the liquid quart"; },
  { .code = "US_dry_pint";             .why = "US dry pint — native pt is the liquid pint"; },
  { .code = "dry_pint";                .why = "US dry pint — native pt is the liquid pint"; },
  { .code = "firkin";                  .why = "firkin (a quarter barrel) — quarters are not decades"; },
  { .code = "BZ";                      .why = "bel relative to 1 mm^6/m^3 (radar reflectivity) — dB carries no reference level"; },
  { .code = "Bz";                      .why = "bel relative to 1 mm^6/m^3 (radar reflectivity) — dB carries no reference level"; },
  { .code = "sidereal_hour";           .why = "sidereal hour — native h is the ordinary one"; },
  { .code = "sidereal_minute";         .why = "sidereal minute — native min is the ordinary one"; },
  { .code = "sidereal_second";         .why = "sidereal second — native s is the ordinary one"; },
  { .code = "eon";                     .why = "eon (1e9 UDUNITS years) — UDUNITS' year is the tropical year and native yr is the Julian one, the same disagreement that keeps the bare year itself out of the mapped list"; },
  { .code = "H2O";                     .why = "water column — bovnar has no water-column unit; the technical atmosphere is exactly ten metres of water, so a mapping onto it would be numerically perfect and would hand a centimetre of water back as a millitechnical atmosphere. Same refusal as ucum m[H2O]"; },
  { .code = "h2o";                     .why = "water column — bovnar has no water-column unit; the technical atmosphere is exactly ten metres of water, so a mapping onto it would be numerically perfect and would hand a centimetre of water back as a millitechnical atmosphere. Same refusal as ucum m[H2O]"; },
  { .code = "conventional_water";      .why = "water column — bovnar has no water-column unit; the technical atmosphere is exactly ten metres of water, so a mapping onto it would be numerically perfect and would hand a centimetre of water back as a millitechnical atmosphere. Same refusal as ucum m[H2O]"; },
  { .code = "water";                   .why = "water column — bovnar has no water-column unit; the technical atmosphere is exactly ten metres of water, so a mapping onto it would be numerically perfect and would hand a centimetre of water back as a millitechnical atmosphere. Same refusal as ucum m[H2O]"; },
  { .code = "water_4C";                .why = "water column — bovnar has no water-column unit; the technical atmosphere is exactly ten metres of water, so a mapping onto it would be numerically perfect and would hand a centimetre of water back as a millitechnical atmosphere. Same refusal as ucum m[H2O]"; },
  { .code = "waters_4C";               .why = "water column — bovnar has no water-column unit; the technical atmosphere is exactly ten metres of water, so a mapping onto it would be numerically perfect and would hand a centimetre of water back as a millitechnical atmosphere. Same refusal as ucum m[H2O]"; },
  { .code = "water_39F";               .why = "water column — bovnar has no water-column unit; the technical atmosphere is exactly ten metres of water, so a mapping onto it would be numerically perfect and would hand a centimetre of water back as a millitechnical atmosphere. Same refusal as ucum m[H2O]"; },
  { .code = "waters_39F";              .why = "water column — bovnar has no water-column unit; the technical atmosphere is exactly ten metres of water, so a mapping onto it would be numerically perfect and would hand a centimetre of water back as a millitechnical atmosphere. Same refusal as ucum m[H2O]"; },
  { .code = "water_60F";               .why = "water column — bovnar has no water-column unit; the technical atmosphere is exactly ten metres of water, so a mapping onto it would be numerically perfect and would hand a centimetre of water back as a millitechnical atmosphere. Same refusal as ucum m[H2O]"; },
  { .code = "waters_60F";              .why = "water column — bovnar has no water-column unit; the technical atmosphere is exactly ten metres of water, so a mapping onto it would be numerically perfect and would hand a centimetre of water back as a millitechnical atmosphere. Same refusal as ucum m[H2O]"; },
  { .code = "Hg";                      .why = "the mercury column as a pressure GRADIENT (133322 Pa/m), which is how UDUNITS builds its mercury pressures — not a pressure itself and not a native unit. The pressures built on it, mmHg cmHg inHg, do map"; },
  { .code = "mercury_0C";              .why = "the mercury column as a pressure GRADIENT (133322 Pa/m), which is how UDUNITS builds its mercury pressures — not a pressure itself and not a native unit. The pressures built on it, mmHg cmHg inHg, do map"; },
  { .code = "mercuries_0C";            .why = "the mercury column as a pressure GRADIENT (133322 Pa/m), which is how UDUNITS builds its mercury pressures — not a pressure itself and not a native unit. The pressures built on it, mmHg cmHg inHg, do map"; },
  { .code = "mercury_32F";             .why = "the mercury column as a pressure GRADIENT (133322 Pa/m), which is how UDUNITS builds its mercury pressures — not a pressure itself and not a native unit. The pressures built on it, mmHg cmHg inHg, do map"; },
  { .code = "mercuries_32F";           .why = "the mercury column as a pressure GRADIENT (133322 Pa/m), which is how UDUNITS builds its mercury pressures — not a pressure itself and not a native unit. The pressures built on it, mmHg cmHg inHg, do map"; },
  { .code = "conventional_mercury";    .why = "the mercury column as a pressure GRADIENT (133322 Pa/m), which is how UDUNITS builds its mercury pressures — not a pressure itself and not a native unit. The pressures built on it, mmHg cmHg inHg, do map"; },
  { .code = "conventional_mercuries";  .why = "the mercury column as a pressure GRADIENT (133322 Pa/m), which is how UDUNITS builds its mercury pressures — not a pressure itself and not a native unit. The pressures built on it, mmHg cmHg inHg, do map"; },
  { .code = "mercury_60F";             .why = "60 degF mercury column — native mmHg is the conventional 0 degC one"; },
  { .code = "mercuries_60F";           .why = "60 degF mercury column — native mmHg is the conventional 0 degC one"; },
  { .code = "cm_H2O";                  .why = "water column — bovnar has no water-column unit; the technical atmosphere is exactly ten metres of water, so a mapping onto it would be numerically perfect and would hand a centimetre of water back as a millitechnical atmosphere. Same refusal as ucum m[H2O]"; },
  { .code = "cmH2O";                   .why = "water column — bovnar has no water-column unit; the technical atmosphere is exactly ten metres of water, so a mapping onto it would be numerically perfect and would hand a centimetre of water back as a millitechnical atmosphere. Same refusal as ucum m[H2O]"; },
  { .code = "inch_H2O_39F";            .why = "water column — bovnar has no water-column unit; the technical atmosphere is exactly ten metres of water, so a mapping onto it would be numerically perfect and would hand a centimetre of water back as a millitechnical atmosphere. Same refusal as ucum m[H2O]"; },
  { .code = "inches_H2O_39F";          .why = "water column — bovnar has no water-column unit; the technical atmosphere is exactly ten metres of water, so a mapping onto it would be numerically perfect and would hand a centimetre of water back as a millitechnical atmosphere. Same refusal as ucum m[H2O]"; },
