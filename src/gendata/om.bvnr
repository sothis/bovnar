  { .code = "shake";                                   .bovnar = "shake";               },
  { .code = "dryPint-US";                              .bovnar = "pt_dry";              },
  { .code = "dryQuart-US";                             .bovnar = "qt_dry";              },
  { .code = "dryGallon-US";                            .bovnar = "gal_dry";             },
  { .code = "pica-Postscript";                         .bovnar = "pca";                 },
  { .code = "point-Postscript";                        .bovnar = "pnt";                 },
  { .code = "tonOfRefrigeration";                      .bovnar = "ton_ref";             },

  # ── Refusals that an existing native expression already covered ───────
  #
  # None of these needed a new unit; each was a stale refusal. Three groups:
  # units the registry has under another spelling (are is a centihectare, the
  # apothecary pound IS the troy pound, the Réaumur degree was there all
  # along); compounds the registry can build (a poundal is lb·ft/s², a
  # footcandle a lumen per square foot -- NOT cd/ft², which is a luminance and
  # is what matching on dimension alone would have picked); and two shapes the
  # other profiles already spell -- a degree Celsius inside a compound, which
  # qudt.bvnr reads as K because K in a compound IS the interval, and a ratio
  # of two of the same unit, which unece.bvnr spells 3H as k~g/k~g to keep
  # 'a ratio OF WHAT'.
  { .code = "are";                                     .bovnar = "c~ha"; },   # 100 m^2; the native unit is the hectare, so this is a centihectare
  { .code = "centiare";                                .bovnar = "m^2"; },   # 1 m^2
  { .code = "degreeReaumur";                           .bovnar = "°Re"; },   # the SCALE's unit; ReaumurScale below is the scale itself
  { .code = "poundApothecaries";                       .bovnar = "lb_t"; },   # = the troy pound, twelve apothecary ounces
  { .code = "poundal";                                 .bovnar = "lb·ft/s^2"; },   # one pound accelerated at one foot per second squared
  { .code = "footPoundal";                             .bovnar = "lb·ft^2/s^2"; },   # a poundal through a foot
  { .code = "footcandle";                              .bovnar = "lm/ft^2"; },   # a LUMEN per square foot: illuminance, not cd/ft^2
  { .code = "kayser";                                  .bovnar = "c~m^-1"; },   # the reciprocal centimetre of spectroscopy
  { .code = "gilbert";                                 .bovnar = "Oe·c~m"; },   # one oersted centimetre
  { .code = "ton-Force-Short";                         .bovnar = "tn_sh·gn"; },   # a short ton under standard gravity
  { .code = "rhe";                                     .bovnar = "P^-1"; },   # the reciprocal poise
  { .code = "metreOfMercury";                          .bovnar = "k~mmHg"; },   # OM rounds the column; see the waiver
  { .code = "centimetreOfMercury";                     .bovnar = "da~mmHg"; },   # OM rounds the column; see the waiver
  { .code = "quart-Imperial";                          .bovnar = "qt_uk"; },   # OM states this one at five digits where its pint, gallon, gill and fluid ounce are exact; see the waiver
  { .code = "degreeCelsiusDay";                        .bovnar = "K·d"; },
  { .code = "degreeCelsiusPerHour";                    .bovnar = "K/h"; },
  { .code = "degreeCelsiusPerMinute-Time";             .bovnar = "K/min"; },
  { .code = "degreeCelsiusPerSecond-Time";             .bovnar = "K/s"; },
  { .code = "reciprocalDegreeCelsius";                 .bovnar = "K^-1"; },
  { .code = "metrePerMetre";                           .bovnar = "m/m"; },
  { .code = "gramPerGram";                             .bovnar = "g/g"; },
  { .code = "molePerMole";                             .bovnar = "mol/mol"; },
  { .code = "kilogramPerKilogram";                     .bovnar = "k~g/k~g"; },
  { .code = "squareMetrePerSquareMetre";               .bovnar = "m^2/m^2"; },
  { .code = "cubicMetrePerCubicmetre";                 .bovnar = "m^3/m^3"; },
  { .code = "cubicCentimetrePerCubicCentimetre";       .bovnar = "c~m^3/c~m^3"; },
  { .code = "cubicMillimetrePerCubicMillimetre";       .bovnar = "m~m^3/m~m^3"; },
