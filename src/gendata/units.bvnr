  {
    .id      = <uint:16> 114;
    .name    = "rpm";
    .symbol  = "rpm";
    .factor  = 0.016666666666666666;
    .dims    = { .time = -1; };
    .affine  = false;
    .offset  = 0.0;
    # Exact rational: 1 rpm = 1/60 Hz (non-terminating in base 10).
    #
    # rpm counts CYCLES per minute, so its SI target is s-1 and the factor is
    # 1/60 exactly. This deliberately does NOT agree with the compound "rev/min":
    # `revolution` below is an ANGLE of 2*pi radians, so rev/min is 2*pi/60 s-1.
    # Both conventions are standard and both are wanted. Do not reconcile them by
    # changing either factor -- the two are kept apart instead by the angle
    # quantity kind (bvni_kind_table in bovnar_si_units.c), which makes rev/min
    # and rpm incompatible rather than convertible-and-wrong.
    .factor_num = <sint:64>  1;
    .factor_den = <sint:64> 60;
    .prefix  = default;
    .aliases = ["rpm"];
  },
