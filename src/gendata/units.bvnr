  {
    # The acidity scale: dimensionless by construction (a negative decimal
    # logarithm of an activity), so it has no conversion factor and takes no
    # prefix — a milli-pH is not a quantity. Modelled for the same reason the
    # decibel and the neper are: a logarithmic scale is still a statement about
    # what the number means, and "7.2" alone is not. Without it "pH" parses as
    # p~H, the picohenry, which is why it also has to be a UNIT rather than
    # merely a refused spelling.
    .id      = <uint:32> 100163;
    .name    = "ph_scale";
    .symbol  = "pH";
    .factor  = 1.0;
    .dims    = {};
    .affine  = false;
    .offset  = 0.0;
    .prefix  = none;
    .aliases = ["pH"];
  },
  {
    # 1 mph = 1609.344 m / 3600 s = 0.44704 m/s exactly. Like the knot, this is
    # a customary speed unit people write as one token; unlike a compound it
    # cannot be prefixed (a kilo-mph is not a thing), hence .prefix = none.
    .id      = <uint:32> 100164;
    .name    = "mile_per_hour";
    .symbol  = "mph";
    .factor  = 0.44704;
    .dims    = { .length = 1; .time = -1; };
    .affine  = false;
    .offset  = 0.0;
    .prefix  = none;
    .aliases = ["mph"];
  },
  {
    # 1 kph = 1000 m / 3600 s = 5/18 m/s, which does not terminate in base 10 —
    # the stored decimal is only the rounded double, so the exact rational is
    # stated. "kmh" is the other spelling in the wild; "km/h" is the compound
    # and needs nothing here.
    .id      = <uint:32> 100165;
    .name    = "kilometer_per_hour";
    .symbol  = "kph";
    .factor  = 0.2777777777777778;
    .dims    = { .length = 1; .time = -1; };
    .affine  = false;
    .offset  = 0.0;
    .factor_num = <sint:64>  5;
    .factor_den = <sint:64> 18;
    .prefix  = none;
    .aliases = ["kph", "kmh"];
  },

  # ── Water hardness ──────────────────────────────────────────────────────
  # Six scales for the same physical quantity: the concentration of dissolved
  # alkaline-earth ions (Ca²⁺, Mg²⁺). Each is DEFINED as a mass of a reference
  # compound per litre, but the scales use different compounds — °dH counts CaO,
  # the others CaCO₃ or Ca — so mass concentration is NOT their common ground and
  # comparing them that way would be wrong by the ratio of two molar masses.
  # Amount concentration is: every scale converts to mol/m³ (which is mmol/L
  # exactly), and that is what the published conversion tables tabulate.
  #
  #   1 °dH = 10 mg CaO/L      / M(CaO)   = 0.178326 mmol/L
  #   1 °fH = 10 mg CaCO₃/L    / M(CaCO₃) = 0.099914 mmol/L
  #   1 °e  = 1 grain CaCO₃ per imperial gallon = 14.2538 mg/L → 0.142415 mmol/L
  #   1 °aH = 1 mg CaCO₃/L     / M(CaCO₃) = 0.009991 mmol/L   (the "ppm" scale)
  #   1 °rH = 1 mg Ca/L        / M(Ca)    = 0.024951 mmol/L
  #   1 mval/L = 0.5 mmol/L    (an equivalent of a DIVALENT ion — see .val)
  #
  # Molar masses are IUPAC 2021 standard atomic weights (Ca 40.078, C 12.011,
  # O 15.999 g/mol), so every factor here is measurement-derived rather than an
  # exact rational: .exact = false, and a lossless conversion reports
  # error_unit_inexact rather than inventing precision.
  #
  # mmol/L needs no unit of its own: it is the compound m~mol/L.
  {
    .id      = <uint:32> 100166;
    .name    = "german_hardness";
    .symbol  = "°dH";
    .factor  = 0.17832623000517145;
    .dims    = { .length = -3; .amount = 1; };
    .affine  = false;
    .offset  = 0.0;
    .exact   = false;
    .prefix  = none;
    # NOT "dH" without the degree sign: that already parses as the decihenry.
    .aliases = ["german_hardness", "°dH"];
  },
  {
    .id      = <uint:32> 100167;
    .name    = "english_hardness";
    .symbol  = "°e";
    .factor  = 0.1424151981625826;
    .dims    = { .length = -3; .amount = 1; };
    .affine  = false;
    .offset  = 0.0;
    .exact   = false;
    .prefix  = none;
    # The Clark degree IS the English degree — one unit, two spellings.
    .aliases = ["english_hardness", "clark_degree", "°Clark", "°e"];
  },
  {
    .id      = <uint:32> 100168;
    .name    = "french_hardness";
    .symbol  = "°fH";
    .factor  = 0.09991407389644906;
    .dims    = { .length = -3; .amount = 1; };
    .affine  = false;
    .offset  = 0.0;
    .exact   = false;
    .prefix  = none;
    .aliases = ["french_hardness", "°fH"];
  },
  {
    .id      = <uint:32> 100169;
    .name    = "russian_hardness";
    .symbol  = "°rH";
    .factor  = 0.024951344877488894;
    .dims    = { .length = -3; .amount = 1; };
    .affine  = false;
    .offset  = 0.0;
    .exact   = false;
    .prefix  = none;
    .aliases = ["russian_hardness", "°rH"];
  },
  {
    .id      = <uint:32> 100170;
    .name    = "american_hardness";
    .symbol  = "°aH";
    .factor  = 0.009991407389644906;
    .dims    = { .length = -3; .amount = 1; };
    .affine  = false;
    .offset  = 0.0;
    .exact   = false;
    .prefix  = none;
    # Water chemistry calls this scale "ppm" (mg CaCO₃ per litre). Bovnar's `ppm`
    # is the dimensionless 10⁻⁶ and stays that way — this is the hardness one.
    .aliases = ["american_hardness", "°aH"];
  },
  {
    .id      = <uint:32> 100171;
    .name    = "val";
    .symbol  = "val";
    # The equivalent AS USED IN WATER ANALYSIS: the ions counted are divalent, so
    # one equivalent is half a mole and m~val/L = 0.5 mmol/L, which is what the
    # hardness tables state. An equivalent of a MONOVALENT species is one mole —
    # bovnar cannot know the species, so for that case write the amount directly
    # (m~mol/L). This is why there is no generic "eq"/"equivalent" alias here.
    .factor  = 0.5;
    .dims    = { .amount = 1; };
    .affine  = false;
    .offset  = 0.0;
    .prefix  = default;
    # "meq/L" is the English spelling of "mval/L" — same unit, same caveat.
    .aliases = ["vals", "val", "eq"];
  },
  {
    # 1 gpg = 1 grain CaCO₃ per US gallon = 64.79891 mg / 3.785411784 L
    #       = 17.1181 mg/L / M(CaCO₃) = 0.171034 mmol/L. The US water-softener
    # scale, and the reason it is a unit rather than the compound gr/gal: as a
    # compound that is a MASS concentration, which does not convert to the other
    # hardness scales. Both spellings stay valid and mean different things.
    .id      = <uint:32> 100172;
    .name    = "grains_per_gallon";
    .symbol  = "gpg";
    .factor  = 0.17103352162411276;
    .dims    = { .length = -3; .amount = 1; };
    .affine  = false;
    .offset  = 0.0;
    .exact   = false;
    .prefix  = none;
    .aliases = ["grains_per_gallon", "gpg"];
  },

  # ── Water quality: instrument scales ────────────────────────────────────
  # Turbidity and practical salinity are defined by a MEASUREMENT METHOD, not by
  # a physical quantity a factor could relate them to. They are dimensionless
  # here and each carries its own quantity kind in bovnar_si_units.c, so they
  # convert only to themselves — see the comment on bvni_kind_table.
  {
    # ISO/EPA nephelometric turbidity, white-light source, 90° detector
    # (EPA 180.1). Numerically equal to FNU on a formazin standard and NOT on
