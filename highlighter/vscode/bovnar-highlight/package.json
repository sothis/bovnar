{
  "name": "bovnar-highlight",
  "displayName": "Bovnar Syntax",
  "description": "Syntax highlighting for Bovnar files (spec 1.1: version directive, datetime literals, \\u/\\x escapes, reference indexing)",
  "version": "1.1.0",
  "publisher": "bovnar",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/sothis/bovnar.git", "directory": "highlighter/vscode/bovnar-highlight" },
  "engines": { "vscode": "^1.70.0" },
  "contributes": {
    "languages": [
      {
        "id": "bovnar",
        "aliases": ["Bovnar"],
        "extensions": [".bvnr"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bovnar",
        "scopeName": "source.bovnar",
        "path": "./syntaxes/Bovnar.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Bovnar Cyberpunk",
        "uiTheme": "vs-dark",
        "path": "./themes/bovnar-cyberpunk-color-theme.json"
      }
    ]
  },
  "configurationDefaults": {
    "[bovnar]": {
      "editor.bracketPairColorization.enabled": false
    },
    "editor.tokenColorCustomizations": {
      "textMateRules": [
        { "scope": "comment.line.number-sign.bovnar",          "settings": { "foreground": "#6e7a86" } },
        { "scope": "punctuation.separator.key-sigil.bovnar",   "settings": { "foreground": "#c084fc" } },
        { "scope": "entity.name.key.bovnar",                   "settings": { "foreground": "#67d1f4" } },
        { "scope": "punctuation.terminator.semicolon.bovnar",  "settings": { "foreground": "#828d9a" } },
        { "scope": "keyword.operator.assignment.bovnar",       "settings": { "foreground": "#f47067" } },
        { "scope": "storage.type.family.bovnar",               "settings": { "foreground": "#e8e8e8", "fontStyle": "bold" } },
        { "scope": "support.constant.no-unit.bovnar",          "settings": { "foreground": "#87d88c" } },
        { "scope": "constant.numeric.q~param.bovnar",         "settings": { "foreground": "#da844c" } },
        { "scope": "constant.numeric.width-param.bovnar",     "settings": { "foreground": "#ff5faf" } },
        { "scope": "constant.numeric.base-param.bovnar",      "settings": { "foreground": "#afffd7" } },
        { "scope": ["punctuation.separator.colon.bovnar",
                    "punctuation.separator.comma.bovnar"],     "settings": { "foreground": "#8a94a1" } },
        { "scope": "support.type.unit.bovnar",                 "settings": { "foreground": "#5eead4" } },
        { "scope": ["punctuation.definition.type.begin.bovnar",
                    "punctuation.definition.type.end.bovnar"], "settings": { "foreground": "#a09040" } },
        { "scope": "constant.language.special-float.bovnar",   "settings": { "foreground": "#c084fc" } },
        { "scope": "constant.numeric.float.bovnar",            "settings": { "foreground": "#f0c64e" } },
        { "scope": "constant.numeric.integer.bovnar",          "settings": { "foreground": "#f0c64e" } },
        { "scope": "string.quoted.double.bovnar",              "settings": { "foreground": "#87d88c" } },
        { "scope": "constant.character.escape.bovnar",         "settings": { "foreground": "#5ab06e", "fontStyle": "bold" } },
        { "scope": "invalid.illegal.escape.bovnar",            "settings": { "foreground": "#f47067", "fontStyle": "underline" } },
        { "scope": "punctuation.separator.inline-unit.bovnar", "settings": { "foreground": "#8a94a1" } },
        { "scope": "support.type.unit.inline.bovnar",          "settings": { "foreground": "#5eead4" } },
        { "scope": "variable.other.symbol.bovnar",             "settings": { "foreground": "#67d1f4" } },
        { "scope": "keyword.operator.reference.bovnar",        "settings": { "foreground": "#f47067", "fontStyle": "bold" } },
        { "scope": "variable.other.reference-path.bovnar",     "settings": { "foreground": "#d4737f" } },
        { "scope": "punctuation.separator.array-row.bovnar",   "settings": { "foreground": "#8a94a1" } },

        { "scope": "punctuation.section.array.depth1.bovnar",  "settings": { "foreground": "#da844c" } },
        { "scope": "punctuation.section.array.depth2.bovnar",  "settings": { "foreground": "#c084fc" } },
        { "scope": "punctuation.section.array.depth3.bovnar",  "settings": { "foreground": "#ff5f96" } },
        { "scope": "punctuation.section.array.depth4.bovnar",  "settings": { "foreground": "#ffa500" } },
        { "scope": "punctuation.section.array.depth5.bovnar",  "settings": { "foreground": "#87d88c" } },

        { "scope": "punctuation.section.struct.depth1.bovnar", "settings": { "foreground": "#da844c" } },
        { "scope": "punctuation.section.struct.depth2.bovnar", "settings": { "foreground": "#c084fc" } },
        { "scope": "punctuation.section.struct.depth3.bovnar", "settings": { "foreground": "#ff5f96" } },
        { "scope": "punctuation.section.struct.depth4.bovnar", "settings": { "foreground": "#ffa500" } },
        { "scope": "punctuation.section.struct.depth5.bovnar", "settings": { "foreground": "#87d88c" } },
        { "scope": "punctuation.section.struct.depth6.bovnar", "settings": { "foreground": "#5eead4" } },
        { "scope": "punctuation.section.struct.depth7.bovnar", "settings": { "foreground": "#f0c64e" } },
        { "scope": "punctuation.section.struct.depth8.bovnar", "settings": { "foreground": "#67d1f4" } }
      ]
    }
  }
}
