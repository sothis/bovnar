  { .code = "clo";                     .why = "clo (0.155 K.m^2/W) — not a decade off any native thermal resistance"; },
  { .code = "statampere";              .why = "CGS electrostatic ampere — built on the speed of light, not a decade off any native unit"; },
  { .code = "abvolt";                  .why = "abvolt (1e-8 V) — there is no decade prefix at 1e-8"; },
  { .code = "e";                       .why = "the elementary charge — a constant, not a native unit"; },
