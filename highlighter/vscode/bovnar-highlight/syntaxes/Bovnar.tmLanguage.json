{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bovnar",
  "scopeName": "source.bovnar",
  "fileTypes": ["bvnr"],

  "patterns": [
    { "include": "#comment"          },
    { "include": "#assignment"       },
    { "include": "#type_annotation"  },
    { "include": "#value"            }
  ],

  "repository": {

    "comment": {
      "match": "#[^\n\r]*",
      "name": "comment.line.number-sign.bovnar"
    },

    "assignment": {
      "comment": "Top-level .key = value ; — uses struct1/array1 as entry points for depth coloring.",
      "begin": "(?:^|(?<=[{;]))\\s*(\\.)((?:[A-Za-z_][A-Za-z0-9_+\\-]*))",
      "beginCaptures": {
        "1": { "name": "punctuation.separator.key-sigil.bovnar" },
        "2": { "name": "entity.name.key.bovnar"                 }
      },
      "end": ";",
      "endCaptures": {
        "0": { "name": "punctuation.terminator.semicolon.bovnar" }
      },
      "patterns": [
        { "include": "#assignment_values" },
        { "include": "#struct1"           }
      ]
    },

    "assignment_values": {
      "comment": "Shared value patterns used inside every assignment variant. Includes array1 so arrays always enter the depth chain at level 1.",
      "patterns": [
        { "include": "#comment"         },
        { "match": "=", "name": "keyword.operator.assignment.bovnar" },
        { "include": "#type_annotation" },
        { "include": "#special_number"  },
        { "include": "#number"          },
        { "include": "#string"          },
        { "include": "#inline_unit"     },
        { "include": "#keyword"         },
        { "include": "#symbol"          },
        { "include": "#reference"       },
        { "include": "#array1"          },
        { "match": "/", "name": "punctuation.separator.array-row.bovnar" }
      ]
    },

    "assignment_in_struct1": {
      "begin": "(?:^|(?<=[{;]))\\s*(\\.)((?:[A-Za-z_][A-Za-z0-9_+\\-]*))",
      "beginCaptures": {
        "1": { "name": "punctuation.separator.key-sigil.bovnar" },
        "2": { "name": "entity.name.key.bovnar"                 }
      },
      "end": ";",
      "endCaptures": { "0": { "name": "punctuation.terminator.semicolon.bovnar" } },
      "patterns": [
        { "include": "#assignment_values" },
        { "include": "#struct2"           }
      ]
    },

    "assignment_in_struct2": {
      "begin": "(?:^|(?<=[{;]))\\s*(\\.)((?:[A-Za-z_][A-Za-z0-9_+\\-]*))",
      "beginCaptures": {
        "1": { "name": "punctuation.separator.key-sigil.bovnar" },
        "2": { "name": "entity.name.key.bovnar"                 }
      },
      "end": ";",
      "endCaptures": { "0": { "name": "punctuation.terminator.semicolon.bovnar" } },
      "patterns": [
        { "include": "#assignment_values" },
        { "include": "#struct3"           }
      ]
    },

    "assignment_in_struct3": {
      "begin": "(?:^|(?<=[{;]))\\s*(\\.)((?:[A-Za-z_][A-Za-z0-9_+\\-]*))",
      "beginCaptures": {
        "1": { "name": "punctuation.separator.key-sigil.bovnar" },
        "2": { "name": "entity.name.key.bovnar"                 }
      },
      "end": ";",
      "endCaptures": { "0": { "name": "punctuation.terminator.semicolon.bovnar" } },
      "patterns": [
        { "include": "#assignment_values" },
        { "include": "#struct4"           }
      ]
    },

    "assignment_in_struct4": {
      "begin": "(?:^|(?<=[{;]))\\s*(\\.)((?:[A-Za-z_][A-Za-z0-9_+\\-]*))",
      "beginCaptures": {
        "1": { "name": "punctuation.separator.key-sigil.bovnar" },
        "2": { "name": "entity.name.key.bovnar"                 }
      },
      "end": ";",
      "endCaptures": { "0": { "name": "punctuation.terminator.semicolon.bovnar" } },
      "patterns": [
        { "include": "#assignment_values" },
        { "include": "#struct5"           }
      ]
    },

    "assignment_in_struct5": {
      "begin": "(?:^|(?<=[{;]))\\s*(\\.)((?:[A-Za-z_][A-Za-z0-9_+\\-]*))",
      "beginCaptures": {
        "1": { "name": "punctuation.separator.key-sigil.bovnar" },
        "2": { "name": "entity.name.key.bovnar"                 }
      },
      "end": ";",
      "endCaptures": { "0": { "name": "punctuation.terminator.semicolon.bovnar" } },
      "patterns": [
        { "include": "#assignment_values" },
        { "include": "#struct6"           }
      ]
    },

    "assignment_in_struct6": {
      "begin": "(?:^|(?<=[{;]))\\s*(\\.)((?:[A-Za-z_][A-Za-z0-9_+\\-]*))",
      "beginCaptures": {
        "1": { "name": "punctuation.separator.key-sigil.bovnar" },
        "2": { "name": "entity.name.key.bovnar"                 }
      },
      "end": ";",
      "endCaptures": { "0": { "name": "punctuation.terminator.semicolon.bovnar" } },
      "patterns": [
        { "include": "#assignment_values" },
        { "include": "#struct7"           }
      ]
    },

    "assignment_in_struct7": {
      "begin": "(?:^|(?<=[{;]))\\s*(\\.)((?:[A-Za-z_][A-Za-z0-9_+\\-]*))",
      "beginCaptures": {
        "1": { "name": "punctuation.separator.key-sigil.bovnar" },
        "2": { "name": "entity.name.key.bovnar"                 }
      },
      "end": ";",
      "endCaptures": { "0": { "name": "punctuation.terminator.semicolon.bovnar" } },
      "patterns": [
        { "include": "#assignment_values" },
        { "include": "#struct8"           }
      ]
    },

    "assignment_in_struct8": {
      "comment": "Depth 8 cycles back to struct1.",
      "begin": "(?:^|(?<=[{;]))\\s*(\\.)((?:[A-Za-z_][A-Za-z0-9_+\\-]*))",
      "beginCaptures": {
        "1": { "name": "punctuation.separator.key-sigil.bovnar" },
        "2": { "name": "entity.name.key.bovnar"                 }
      },
      "end": ";",
      "endCaptures": { "0": { "name": "punctuation.terminator.semicolon.bovnar" } },
      "patterns": [
        { "include": "#assignment_values" },
        { "include": "#struct1"           }
      ]
    },

    "type_annotation": {
      "comment": "Matches <type-spec> blocks including the new float_fix / float_dec families (v1.3) and the q~param for fixed-point Q~format. float_fix and float_dec must precede float in the alternation so the longer names win.",
      "begin": "<",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.type.begin.bovnar" }
      },
      "end": ">",
      "endCaptures": {
        "0": { "name": "punctuation.definition.type.end.bovnar" }
      },
      "patterns": [
        { "include": "#comment" },

        { "comment": "Type-family keywords. Longer names (float_fix, float_dec) must appear before float.",
          "match": "\\b(float_fix|float_dec|float|uint|sint|utf8|bool)\\b",
          "name": "storage.type.family.bovnar" },

        { "comment": "Explicitly-dimensionless keyword.",
          "match": "\\bno_unit\\b",
          "name": "support.constant.no-unit.bovnar" },

        { "comment": "Q~format fractional-bits: q0, q8, q16, q32 … (float_fix only).",
          "match": "\\bq\\d+\\b",
          "name": "constant.numeric.q~param.bovnar" },

        { "comment": "Base parameter: _2 _8 _10 _16 _36 _62 _64 _85 …",
          "match": "_\\d+",
          "name": "constant.numeric.base-param.bovnar" },

        { "comment": "Width parameter: bare decimal integer (16, 32, 64, 128 …).",
          "match": "\\b\\d+\\b",
          "name": "constant.numeric.width-param.bovnar" },

        { "include": "#unit_expression" },

        { "match": ":", "name": "punctuation.separator.colon.bovnar"  },
        { "match": ",", "name": "punctuation.separator.comma.bovnar"  }
      ]
    },

    "value": {
      "comment": "Top-level value forms; uses array1/struct1 as entry points for the depth chain.",
      "patterns": [
        { "include": "#comment"        },
        { "include": "#special_number" },
        { "include": "#number"         },
        { "include": "#string"         },
        { "include": "#inline_unit"    },
        { "include": "#keyword"        },
        { "include": "#symbol"         },
        { "include": "#reference"      },
        { "include": "#array1"         },
        { "include": "#struct1"        }
      ]
    },

    "special_number": {
      "comment": "$nan  $inf  $-inf — a single leading $ sigil, no trailing $. The keyword ends like a number; a trailing identifier byte (e.g. $infinity) is an error and is not matched.",
      "match": "\\$(?:nan|-inf|inf)(?![A-Za-z0-9_])",
      "name": "constant.language.special-float.bovnar"
    },

    "keyword": {
      "comment": "Reserved value-position keywords. true/false/on/off carry the bool type family (on==true, off==false); null is the null value. The validator reclassifies these out of the symbol space, so they must be matched before #symbol.",
      "patterns": [
        { "match": "\\b(?:true|false|on|off)\\b", "name": "constant.language.boolean.bovnar" },
        { "match": "\\bnull\\b", "name": "constant.language.null.bovnar" }
      ]
    },

    "number": {
      "patterns": [
        { "comment": "Leading-dot float:  .5   -.5   .7e+3",
          "match": "-?\\.\\d+(?:[eE][+\\-]?\\d+)?",
          "name": "constant.numeric.float.bovnar" },

        { "comment": "Integer-led float (trailing dot allowed):  3.14  1.  -8.  5.7e112",
          "match": "-?\\d+\\.\\d*(?:[eE][+\\-]?\\d+)?",
          "name": "constant.numeric.float.bovnar" },

        { "comment": "Bare integer / scientific-notation integer:  511  -7  01010110  1e10",
          "match": "-?\\d+(?:[eE][+\\-]?\\d+)?",
          "name": "constant.numeric.integer.bovnar" }
      ]
    },

    "string": {
      "comment": "Double-quoted string. Only seven escape sequences are legal: \\t \\n \\v \\f \\r \\\" \\\\.",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.bovnar" }
      },
      "end": "\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.bovnar" }
      },
      "name": "string.quoted.double.bovnar",
      "patterns": [
        { "match": "\\\\[tnvfr\"\\\\]",
          "name": "constant.character.escape.bovnar" },
        { "match": "\\\\.",
          "name": "invalid.illegal.escape.bovnar" }
      ]
    },

    "inline_unit": {
      "comment": "Inline unit suffix: mandatory whitespace separates the scalar from the unit. The lookbehind fires after a digit, a closing string quote, or the tail of a special-number keyword ($nan/$inf/$-inf) — variable-length alternation, supported by Oniguruma.",
      "match": "(?<=[\\d\"]|\\$nan|\\$inf|\\$-inf)(\\s+)([A-Za-z_%‰‱µ°Å][A-Za-z0-9_+~\\.\\-/:\\^\\*%‰‱µΩ°Å·¹²³⁴⁵⁶⁷⁸⁹ⁿ⁺⁻]*)",
      "captures": {
        "1": { "name": "punctuation.separator.inline-unit.bovnar" },
        "2": { "name": "support.type.unit.inline.bovnar"          }
      }
    },

    "symbol": {
      "comment": "Bare-word value (symbol / enum-like).",
      "match": "\\b[A-Za-z_][A-Za-z0-9_+\\-]*",
      "name": "variable.other.symbol.bovnar"
    },

    "reference": {
      "comment": "Reference literal: '&' sigil followed by one or more '.segment' path components.",
      "begin": "&",
      "beginCaptures": {
        "0": { "name": "keyword.operator.reference.bovnar" }
      },
      "end": "(?=[\\s;,\\[\\]{}#])",
      "patterns": [
        { "match": "\\.([A-Za-z_][A-Za-z0-9_+\\-]*)",
          "captures": {
            "0": { "name": "variable.other.reference-path.bovnar" }
          }
        }
      ]
    },

    "array_body": {
      "comment": "Scalar content shared by all array depth levels (no nested arrays or structs).",
      "patterns": [
        { "include": "#comment"         },
        { "include": "#type_annotation" },
        { "include": "#special_number"  },
        { "include": "#number"          },
        { "include": "#string"          },
        { "include": "#keyword"         },
        { "include": "#symbol"          },
        { "include": "#reference"       },
        { "match": ",", "name": "punctuation.separator.comma.bovnar"     },
        { "match": "/", "name": "punctuation.separator.array-row.bovnar" }
      ]
    },

    "array1": {
      "comment": "Array depth 1 — entry point, not nested inside another array rule.",
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "punctuation.section.array.depth1.bovnar" } },
      "end": "\\]",
      "endCaptures":   { "0": { "name": "punctuation.section.array.depth1.bovnar" } },
      "patterns": [
        { "include": "#array_body" },
        { "include": "#array2"     },
        { "include": "#struct1"    }
      ]
    },

    "array2": {
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "punctuation.section.array.depth2.bovnar" } },
      "end": "\\]",
      "endCaptures":   { "0": { "name": "punctuation.section.array.depth2.bovnar" } },
      "patterns": [
        { "include": "#array_body" },
        { "include": "#array3"     },
        { "include": "#struct1"    }
      ]
    },

    "array3": {
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "punctuation.section.array.depth3.bovnar" } },
      "end": "\\]",
      "endCaptures":   { "0": { "name": "punctuation.section.array.depth3.bovnar" } },
      "patterns": [
        { "include": "#array_body" },
        { "include": "#array4"     },
        { "include": "#struct1"    }
      ]
    },

    "array4": {
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "punctuation.section.array.depth4.bovnar" } },
      "end": "\\]",
      "endCaptures":   { "0": { "name": "punctuation.section.array.depth4.bovnar" } },
      "patterns": [
        { "include": "#array_body" },
        { "include": "#array5"     },
        { "include": "#struct1"    }
      ]
    },

    "array5": {
      "comment": "Depth 5 cycles back to array1.",
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "punctuation.section.array.depth5.bovnar" } },
      "end": "\\]",
      "endCaptures":   { "0": { "name": "punctuation.section.array.depth5.bovnar" } },
      "patterns": [
        { "include": "#array_body" },
        { "include": "#array1"     },
        { "include": "#struct1"    }
      ]
    },

    "struct1": {
      "comment": "Struct depth 1 — entry point.",
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.struct.depth1.bovnar" } },
      "end": "\\}",
      "endCaptures":   { "0": { "name": "punctuation.section.struct.depth1.bovnar" } },
      "patterns": [
        { "include": "#comment"              },
        { "include": "#assignment_in_struct1"}
      ]
    },

    "struct2": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.struct.depth2.bovnar" } },
      "end": "\\}",
      "endCaptures":   { "0": { "name": "punctuation.section.struct.depth2.bovnar" } },
      "patterns": [
        { "include": "#comment"              },
        { "include": "#assignment_in_struct2"}
      ]
    },

    "struct3": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.struct.depth3.bovnar" } },
      "end": "\\}",
      "endCaptures":   { "0": { "name": "punctuation.section.struct.depth3.bovnar" } },
      "patterns": [
        { "include": "#comment"              },
        { "include": "#assignment_in_struct3"}
      ]
    },

    "struct4": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.struct.depth4.bovnar" } },
      "end": "\\}",
      "endCaptures":   { "0": { "name": "punctuation.section.struct.depth4.bovnar" } },
      "patterns": [
        { "include": "#comment"              },
        { "include": "#assignment_in_struct4"}
      ]
    },

    "struct5": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.struct.depth5.bovnar" } },
      "end": "\\}",
      "endCaptures":   { "0": { "name": "punctuation.section.struct.depth5.bovnar" } },
      "patterns": [
        { "include": "#comment"              },
        { "include": "#assignment_in_struct5"}
      ]
    },

    "struct6": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.struct.depth6.bovnar" } },
      "end": "\\}",
      "endCaptures":   { "0": { "name": "punctuation.section.struct.depth6.bovnar" } },
      "patterns": [
        { "include": "#comment"              },
        { "include": "#assignment_in_struct6"}
      ]
    },

    "struct7": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.struct.depth7.bovnar" } },
      "end": "\\}",
      "endCaptures":   { "0": { "name": "punctuation.section.struct.depth7.bovnar" } },
      "patterns": [
        { "include": "#comment"              },
        { "include": "#assignment_in_struct7"}
      ]
    },

    "struct8": {
      "comment": "Depth 8 cycles back to struct1.",
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.struct.depth8.bovnar" } },
      "end": "\\}",
      "endCaptures":   { "0": { "name": "punctuation.section.struct.depth8.bovnar" } },
      "patterns": [
        { "include": "#comment"              },
        { "include": "#assignment_in_struct8"}
      ]
    },

    "unit_expression": {
      "comment": "Unit string inside a type annotation.",
      "match": "[A-Za-z%‰‱µΩ°Å][A-Za-z0-9_]*(?:~[A-Za-z%‰‱µΩ°Å][A-Za-z0-9_]*)?(?:[¹²³⁴⁵⁶⁷⁸⁹ⁿ⁺⁻]|\\^[+\\-]?\\d+)?(?:[·/*][A-Za-z%‰‱µΩ°Å][A-Za-z0-9_]*(?:~[A-Za-z%‰‱µΩ°Å][A-Za-z0-9_]*)?(?:[¹²³⁴⁵⁶⁷⁸⁹ⁿ⁺⁻]|\\^[+\\-]?\\d+)?)*",
      "name": "support.type.unit.bovnar"
    }

  }
}
