{
  "$schema": "vscode://schemas/color-theme",
  "name": "Bovnar Cyberpunk",
  "type": "dark",
  "colors": {
    "editor.background": "#1a1b2e",
    "editor.foreground": "#f8f8f2",
    "editor.selectionBackground": "#44475a80",
    "editor.lineHighlightBackground": "#2d2f4f40",
    "editorCursor.foreground": "#ff79c6",
    "editorLineNumber.foreground": "#4a4e69",
    "editorLineNumber.activeForeground": "#f8f8f2",
    "editorWhitespace.foreground": "#3d3f4e",
    "editorIndentGuide.background1": "#3d3f4e",
    "editorIndentGuide.activeBackground1": "#6272a4",
    "editorBracketHighlight.foreground1": "#ff79c6",
    "editorBracketHighlight.foreground2": "#ffb86c",
    "editorBracketHighlight.foreground3": "#8be9fd",
    "editorBracketHighlight.foreground4": "#bd93f9",
    "editorBracketHighlight.foreground5": "#f1fa8c",
    "editorBracketHighlight.foreground6": "#00cec9",
    "editorBracketHighlight.unexpectedBracket.foreground": "#ff8c00",
    "editorBracketPairGuide.background1": "#ff79c620",
    "editorBracketPairGuide.background2": "#ffb86c20",
    "editorBracketPairGuide.background3": "#8be9fd20",
    "editorBracketPairGuide.background4": "#bd93f920",
    "editorBracketPairGuide.background5": "#f1fa8c20",
    "editorBracketPairGuide.background6": "#00cec920",
    "editorBracketPairGuide.activeBackground1": "#ff79c650",
    "editorBracketPairGuide.activeBackground2": "#ffb86c50",
    "editorBracketPairGuide.activeBackground3": "#8be9fd50",
    "editorBracketPairGuide.activeBackground4": "#bd93f950",
    "editorBracketPairGuide.activeBackground5": "#f1fa8c50",
    "editorBracketPairGuide.activeBackground6": "#00cec950"
  },
  "tokenColors": [

    // ── General-purpose rules (all languages) ────────────────────────────────
    // These use broad parent scopes; Bovnar-specific scopes below are more
    // precise and therefore take precedence under TextMate scope-scoring rules.

    {
      "name": "General – Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6272a4", "fontStyle": "italic" }
    },
    {
      "name": "General – Keywords and Control Flow",
      "scope": [
        "keyword", "keyword.control", "keyword.control.flow",
        "keyword.other", "keyword.declaration"
      ],
      "settings": { "foreground": "#ff79c6" }
    },
    {
      "name": "General – Storage (type / modifier)",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#ff79c6" }
    },
    {
      "name": "General – Strings",
      "scope": [
        "string", "string.quoted", "string.quoted.single",
        "string.quoted.double", "string.quoted.triple",
        "string.template", "string.regexp",
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": { "foreground": "#f1fa8c" }
    },
    {
      "name": "General – Numbers",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#bd93f9" }
    },
    {
      "name": "General – Constants and Language Keywords",
      "scope": ["constant", "constant.language", "constant.other"],
      "settings": { "foreground": "#bd93f9" }
    },
    {
      "name": "General – Function / Method Names",
      "scope": [
        "entity.name.function", "entity.name.method",
        "support.function", "support.function.builtin",
        "meta.function-call entity.name.function"
      ],
      "settings": { "foreground": "#50fa7b" }
    },
    {
      "name": "General – Class / Type Names",
      "scope": [
        "entity.name.type", "entity.name.class",
        "entity.name.namespace", "entity.name.struct",
        "entity.name.enum", "entity.name.union",
        "support.class", "support.type"
      ],
      "settings": { "foreground": "#8be9fd" }
    },
    {
      "name": "General – Variables and Parameters",
      "scope": [
        "variable", "variable.other", "variable.other.readwrite",
        "variable.parameter", "variable.other.object",
        "variable.other.property"
      ],
      "settings": { "foreground": "#f8f8f2" }
    },
    {
      "name": "General – Operators",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#ff79c6" }
    },
    {
      "name": "General – Preprocessor / Import / Include",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "keyword.control.import",
        "keyword.import",
        "keyword.other.import",
        "entity.name.function.preprocessor",
        "meta.preprocessor.macro"
      ],
      "settings": { "foreground": "#ffb86c" }
    },
    {
      "name": "General – Escape Sequences",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#ff79c6" }
    },
    {
      "name": "General – Markup / HTML Tags",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#ff79c6" }
    },
    {
      "name": "General – HTML / XML Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#50fa7b" }
    },
    {
      "name": "General – Decorators / Annotations",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator entity.name.function",
        "punctuation.definition.annotation"
      ],
      "settings": { "foreground": "#ffb86c", "fontStyle": "italic" }
    },
    {
      "name": "General – Invalid / Error",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ff5555", "fontStyle": "underline" }
    },
    {
      "name": "General – Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#ffb86c", "fontStyle": "strikethrough" }
    },
    {
      "name": "General – Punctuation",
      "scope": [
        "punctuation.separator", "punctuation.terminator",
        "punctuation.accessor", "punctuation.definition.parameters"
      ],
      "settings": { "foreground": "#f8f8f2" }
    },

    // ── Bovnar-specific rules (override general rules above) ─────────────────

    {
      "name": "Bovnar Comment",
      "scope": "comment.line.number-sign.bovnar",
      "settings": { "foreground": "#4a4e69" }
    },
    {
      "name": "Bovnar Key Sigil",
      "scope": "punctuation.separator.key-sigil.bovnar",
      "settings": { "foreground": "#c695dc" }
    },
    {
      "name": "Bovnar Key Name",
      "scope": "entity.name.key.bovnar",
      "settings": { "foreground": "#5b9bd5" }
    },
    {
      "name": "Bovnar Semicolon",
      "scope": "punctuation.terminator.semicolon.bovnar",
      "settings": { "foreground": "#3e4462" }
    },
    {
      "name": "Bovnar Assignment Operator",
      "scope": "keyword.operator.assignment.bovnar",
      "settings": { "foreground": "#ff6a8c" }
    },
    {
      "name": "Bovnar Type Keywords",
      "scope": "storage.type.family.bovnar",
      "settings": { "foreground": "#ffb3d9", "fontStyle": "bold" }
    },
    {
      "name": "Bovnar no_unit Keyword",
      "scope": "support.constant.no-unit.bovnar",
      "settings": { "foreground": "#5eead4" }
    },
    {
      "name": "Bovnar Type Parameters",
      "scope": [
        "constant.numeric.q~param.bovnar",
        "constant.numeric.base-param.bovnar",
        "constant.numeric.width-param.bovnar"
      ],
      "settings": { "foreground": "#ffa500" }
    },
    {
      "name": "Bovnar Type Separators",
      "scope": [
        "punctuation.separator.colon.bovnar",
        "punctuation.separator.comma.bovnar"
      ],
      "settings": { "foreground": "#3e4462" }
    },
    {
      "name": "Bovnar Unit Expression (type annotation)",
      "scope": "support.type.unit.bovnar",
      "settings": { "foreground": "#5eead4" }
    },
    {
      "name": "Bovnar Bracket Fallback (overridden by bracket-pair colorizer)",
      "scope": [
        "punctuation.definition.type.begin.bovnar",
        "punctuation.definition.type.end.bovnar",
        "punctuation.section.array.begin.bovnar",
        "punctuation.section.array.end.bovnar",
        "punctuation.section.struct.begin.bovnar",
        "punctuation.section.struct.end.bovnar"
      ],
      "settings": { "foreground": "#00b4d8" }
    },
    {
      "name": "Bovnar Special Float",
      "scope": "constant.language.special-float.bovnar",
      "settings": { "foreground": "#c084fc" }
    },
    {
      "name": "Bovnar Float",
      "scope": "constant.numeric.float.bovnar",
      "settings": { "foreground": "#ffe700" }
    },
    {
      "name": "Bovnar Integer",
      "scope": "constant.numeric.integer.bovnar",
      "settings": { "foreground": "#ffe700" }
    },
    {
      "name": "Bovnar String",
      "scope": "string.quoted.double.bovnar",
      "settings": { "foreground": "#7dd3fc" }
    },
    {
      "name": "Bovnar Valid Escape",
      "scope": "constant.character.escape.bovnar",
      "settings": { "foreground": "#93c5fd", "fontStyle": "bold" }
    },
    {
      "name": "Bovnar Invalid Escape",
      "scope": "invalid.illegal.escape.bovnar",
      "settings": { "foreground": "#fb923c", "fontStyle": "underline" }
    },
    {
      "name": "Bovnar Inline Unit Separator Whitespace",
      "scope": "punctuation.separator.inline-unit.bovnar",
      "settings": { "foreground": "#3e4462" }
    },
    {
      "name": "Bovnar Inline Unit",
      "scope": "support.type.unit.inline.bovnar",
      "settings": { "foreground": "#5eead4" }
    },
    {
      "name": "Bovnar Symbol",
      "scope": "variable.other.symbol.bovnar",
      "settings": { "foreground": "#5b9bd5" }
    },
    {
      "name": "Bovnar Reference Operator",
      "scope": "keyword.operator.reference.bovnar",
      "settings": { "foreground": "#ff2a7d", "fontStyle": "bold" }
    },
    {
      "name": "Bovnar Reference Path",
      "scope": "variable.other.reference-path.bovnar",
      "settings": { "foreground": "#ffa500" }
    },
    {
      "name": "Bovnar Array/Row Separators",
      "scope": "punctuation.separator.array-row.bovnar",
      "settings": { "foreground": "#3e4462" }
    }
  ]
}
