  { .code = "fldr";                .bovnar = "fl_dr";    .metric = false; },
  { .code = "fluid_dram";          .bovnar = "fl_dr";    .metric = false; },
  { .code = "tbsp";                .bovnar = "tbsp";     .metric = false; },
  { .code = "tablespoon";          .bovnar = "tbsp";     .metric = false; },
  { .code = "tsp";                 .bovnar = "tsp";      .metric = false; },
  { .code = "teaspoon";            .bovnar = "tsp";      .metric = false; },
  { .code = "pk";                  .bovnar = "pk";       .metric = false; },
  { .code = "peck";                .bovnar = "pk";       .metric = false; },
  { .code = "bu";                  .bovnar = "bsh";      .metric = false; },
  { .code = "bushel";              .bovnar = "bsh";      .metric = false; },
  { .code = "bbl";                 .bovnar = "bbl";      .metric = false; },
  { .code = "barrel";              .bovnar = "bbl";      .metric = false; },
  { .code = "UK_liquid_gallon";    .bovnar = "gal_uk";   .metric = false; },
  { .code = "UK_liquid_quart";     .bovnar = "qt_uk";    .metric = false; },
  { .code = "UK_liquid_pint";      .bovnar = "pt_uk";    .metric = false; },
  { .code = "UK_liquid_gill";      .bovnar = "gi_uk";    .metric = false; },
  { .code = "UK_fluid_ounce";      .bovnar = "fl_oz_uk"; .metric = false; },
  { .code = "UK_liquid_ounce";     .bovnar = "fl_oz_uk"; .metric = false; },

  # ── Area ─────────────────────────────────────────────────────────────────
  # "are" is 100 m², a hundredth of the hectare, which is the same target UCUM
  # reaches for its "ar". "acre" is NOT here: UDUNITS defines it as 160 rod²
  # on the survey rod, so it is the US SURVEY acre and 4 ppm off native ac.
  { .code = "are";                 .bovnar = "c~ha"; .metric = false; },

  # ── Force, pressure, energy, power ───────────────────────────────────────
  # The unqualified "calorie" is NOT here. UDUNITS defines it as 4.1868 J, the
  # IT calorie, while bovnar's cal is the thermochemical 4.184 J -- 0.067 %
  # apart, dimensionally identical, and invisible to every later check. Only
  # the spelled-out thermochemical one maps; see .unsupported. UDUNITS' "Btu"
  # goes the other way: it is 1.05505585262e3 J, the IT BTU, which is exactly
  # what native Btu is, so it maps where UCUM's unqualified "[Btu]" cannot.
  { .code = "psi";                    .bovnar = "psi";  .metric = false; },
  { .code = "atm";                    .bovnar = "atm";  .metric = false; },
  { .code = "atmosphere";             .bovnar = "atm";  .metric = false; },
  { .code = "standard_atmosphere";    .bovnar = "atm";  .metric = false; },
  { .code = "at";                     .bovnar = "at";   .metric = false; },
  { .code = "technical_atmosphere";   .bovnar = "at";   .metric = false; },
  { .code = "torr";                   .bovnar = "Torr"; .metric = false; },
  { .code = "mmHg";                   .bovnar = "mmHg"; .metric = false; },
  { .code = "mm_Hg";                  .bovnar = "mmHg"; .metric = false; },
  { .code = "inHg";                   .bovnar = "inHg"; .metric = false; },
  { .code = "in_Hg";                  .bovnar = "inHg"; .metric = false; },
  { .code = "inch_Hg";                .bovnar = "inHg"; .metric = false; },
  { .code = "lbf";                    .bovnar = "lbf";  .metric = false; },
  { .code = "pound_force";            .bovnar = "lbf";  .metric = false; },
  { .code = "force_pound";            .bovnar = "lbf";  .metric = false; },
  { .code = "kgf";                    .bovnar = "kgf";  .metric = false; },
  { .code = "kilogram_force";         .bovnar = "kgf";  .metric = false; },
  { .code = "force_kilogram";         .bovnar = "kgf";  .metric = false; },
  { .code = "dyne";                   .bovnar = "dyn";  .metric = false; },
  { .code = "gravity";                .bovnar = "gn";   .metric = false; },
  { .code = "standard_free_fall";     .bovnar = "gn";   .metric = false; },
  { .code = "thermochemical_calorie"; .bovnar = "cal";  .metric = false; },
  { .code = "Btu";                    .bovnar = "Btu";  .metric = false; },
  { .code = "kip";                    .bovnar = "kip";  .metric = false; },
  { .code = "metric_horsepower";      .bovnar = "PS";   .metric = false; },
  { .code = "IT_Btu";                 .bovnar = "Btu";  .metric = false; },
  { .code = "therm";                  .bovnar = "thm";  .metric = false; },
  { .code = "US_therm";               .bovnar = "thm";  .metric = false; },
  { .code = "erg";                    .bovnar = "erg";  .metric = false; },
  { .code = "electron_volt";          .bovnar = "eV";   .metric = true;  },
  { .code = "horsepower";             .bovnar = "hp";   .metric = false; },
  { .code = "shaft_horsepower";       .bovnar = "hp";   .metric = false; },
  { .code = "voltampere";             .bovnar = "VA";   .metric = false; },
  { .code = "VA";                     .bovnar = "VA";   .metric = false; },

  # ── Speed, rotation, mass concentration ──────────────────────────────────
  { .code = "knot";                .bovnar = "kn";      .metric = false; },
  { .code = "kt";                  .bovnar = "kn";      .metric = false; },
  { .code = "international_knot";  .bovnar = "kn";      .metric = false; },
  { .code = "revolution";          .bovnar = "rev";     .metric = false; },
  { .code = "rotation";            .bovnar = "rev";     .metric = false; },
  { .code = "turn";                .bovnar = "rev";     .metric = false; },
  { .code = "cycle";               .bovnar = "rev";     .metric = false; },
  { .code = "circle";              .bovnar = "rev";     .metric = false; },
  { .code = "denier";              .bovnar = "den";     .metric = false; },
  { .code = "tex";                 .bovnar = "tex";     .metric = false; },

  # ── CGS electromagnetic, photometric, radiological ───────────────────────
  # "b" is the BARN here, not the bit -- the same collision UCUM has, and the
  # reason doc/11 §6.2 exists. Native "b" is unaffected: a profile code is
  # only ever read against its own atom table.
  { .code = "poise";      .bovnar = "P";     .metric = false; },
  { .code = "stokes";     .bovnar = "St";    .metric = false; },
  { .code = "gauss";      .bovnar = "G";     .metric = false; },
  # "gal" is the GALILEO, 1 cm/s². The gallon is spelled out -- UDUNITS does
  # not abbreviate it -- so the two cannot be confused here, but a table built
  # by guessing at abbreviations would map a volume onto an acceleration.
  { .code = "gal";        .bovnar = "Gal";   .metric = false; },
  { .code = "maxwell";    .bovnar = "Mx";    .metric = false; },
  { .code = "oersted";    .bovnar = "Oe";    .metric = false; },
  { .code = "abampere";   .bovnar = "da~A";  .metric = false; },
  { .code = "stilb";      .bovnar = "sb";    .metric = false; },
  { .code = "phot";       .bovnar = "ph";    .metric = false; },
  { .code = "nit";        .bovnar = "cd/m^2"; .metric = false; },
  { .code = "nt";         .bovnar = "cd/m^2"; .metric = false; },
  { .code = "b";          .bovnar = "barn";  .metric = false; },
  { .code = "curie";      .bovnar = "Ci";    .metric = false; },
  { .code = "roentgen";   .bovnar = "R";     .metric = false; },
  { .code = "R";          .bovnar = "R";     .metric = false; },
  { .code = "rem";        .bovnar = "rem";   .metric = false; },

  # ── Mass of an atom ──────────────────────────────────────────────────────
  # "unified_atomic_mass_unit" is UDUNITS' fourth spelling and is NOT here: at
  # 24 bytes it pushes this profile's worst-case emitted string past
  # BVNR_UNIT_STRING_MAX, which gen_profiles.py refuses to generate. The three
  # shorter spellings reach the same unit.
  { .code = "u";                  .bovnar = "Da"; .metric = false; },
  { .code = "amu";                .bovnar = "Da"; .metric = false; },
  { .code = "atomic_mass_unit";   .bovnar = "Da"; .metric = false; },

  # ── Ratios and logarithms ────────────────────────────────────────────────
  { .code = "percent";   .bovnar = "%";   .metric = false; },
  { .code = "%";         .bovnar = "%";   .metric = false; },
  { .code = "ppm";       .bovnar = "ppm"; .metric = false; },
  { .code = "ppb";       .bovnar = "ppb"; .metric = false; },
  { .code = "dB";        .bovnar = "dB";  .metric = false; },
  { .code = "decibel";   .bovnar = "dB";  .metric = false; },
  { .code = "Np";        .bovnar = "Np";  .metric = true;  },
  { .code = "neper";     .bovnar = "Np";  .metric = true;  },
  { .code = "pH";        .bovnar = "pH";  .metric = false; },

  # ── Information ──────────────────────────────────────────────────────────
  # UDUNITS' "byte" is defined as 8 (dimensionless), i.e. eight bits; bovnar
  # models bit and byte as two base units of information with no factor
  # between them, so the 8 is a modelling difference and not a scale to fold.
  { .code = "bit";       .bovnar = "b";   .metric = true;  },
  { .code = "byte";      .bovnar = "B";   .metric = true;  },
  { .code = "baud";      .bovnar = "Bd";  .metric = true;  },
  { .code = "Bd";        .bovnar = "Bd";  .metric = true;  },
];

# UDUNITS has no assay-defined units the way UCUM does; everything either maps
# onto the native registry or is refused, so this profile owns no opaque range.
.opaque = [];

.unsupported = [
  # ── Reference time ───────────────────────────────────────────────────────
  # The construct this profile is most often asked for, and the one it cannot
  # carry. A bovnar timestamp is <datetime:width,epoch>: the EPOCH lives in the
  # type spec's base slot, which a unit-slot expression cannot reach, and the
  # CARRIER is defined as a count of seconds, which "days since ..." is not.
  # Both would have to change for this to land, and neither is a unit question.
  #
  # The refusal is NOT driven by this row. A reference-time expression cannot be
  # split into atoms at all -- the lexer has already deleted its spaces, so
  # "days since 1970-01-01" arrives as one token -- so bovnar_profiles.c refuses
  # any udunits code CONTAINING "since", via the refuse_substr hook on the
  # registry row. The row is kept because this is where a maintainer looks for
  # the reason, and because it makes a bare "udunits:since" refuse identically.
  { .code = "since"; .why = "reference time — a bovnar timestamp is <datetime:width,epoch>; the epoch is a type parameter, not a unit, and the carrier counts seconds"; },

  # ── Dimensionless placeholders ───────────────────────────────────────────
  # CF writes a dimensionless variable's units as "1". There is no row for "1"
  # here: the shared expr parser resolves a bare power of ten to UNITY before
  # any table is consulted, so "udunits:1" yields a value with no unit, exactly
  # as "ucum:1" does. That is the right answer and listing it would be dead
  # data. "count" is a name rather than a numeral and does need a row.
  { .code = "count"; .why = "a bare count — omit the unit slot instead"; },

  # ── Coordinate pseudo-units ──────────────────────────────────────────────
  # CF's rotated-pole and geographic direction markers. These are not units at
  # all: they say which way an angle is measured, which is a coordinate-system
  # statement bovnar's unit model has no place for.
  { .code = "degrees_north"; .why = "a coordinate direction, not a unit — write ° and record the direction elsewhere"; },
  { .code = "degrees_east";  .why = "a coordinate direction, not a unit — write ° and record the direction elsewhere"; },
  { .code = "degrees_south"; .why = "a coordinate direction, not a unit"; },
  { .code = "degrees_west";  .why = "a coordinate direction, not a unit"; },
  { .code = "degree_north";  .why = "a coordinate direction, not a unit"; },
  { .code = "degree_east";   .why = "a coordinate direction, not a unit"; },

  # ── Logarithms with a reference level ────────────────────────────────────
  # UDUNITS spells these lg(re 1 mW) and similar; bovnar's dB carries no
  # reference, so translating would let a power level compare equal to a
  # voltage level.
  { .code = "dBm";  .why = "dB relative to a milliwatt — dB carries no reference level"; },
  { .code = "dBW";  .why = "dB relative to a watt — dB carries no reference level"; },
  { .code = "dBV";  .why = "dB relative to a volt — dB carries no reference level"; },

  # ── Sidereal and tropical time ───────────────────────────────────────────
  # bovnar's yr is the Julian year exactly; these are different lengths and
  # have no native form.
  #
  # "year", "yr" and "month" belong to this list and not to .mapped, which is
  # the correction this block exists to record. UDUNITS' unqualified year is
  # 3.15569259747e7 s -- the TROPICAL year -- not the Julian 3.15576e7 s the
  # native yr is. Mapping them onto yr was wrong by 674 s per year: the same
  # shape of error doc/11 §6.3 records for the BTU, and just as invisible.
  # "Julian_year" is UDUNITS' own spelling for what bovnar means and it maps.
  { .code = "year";          .why = "the unqualified UDUNITS year is the tropical year (3.15569259747e7 s); bovnar's yr is the Julian year — write Julian_year"; },
  { .code = "yr";            .why = "the unqualified UDUNITS yr is the tropical year; bovnar's yr is the Julian year — write Julian_year"; },
  { .code = "month";         .why = "a twelfth of the tropical year; bovnar's mo is a twelfth of the Julian year"; },
  { .code = "tropical_year"; .why = "no native form — bovnar's yr is the Julian year"; },
  { .code = "sidereal_year"; .why = "no native form — bovnar's yr is the Julian year"; },
  { .code = "Gregorian_year"; .why = "no native form — bovnar's yr is the Julian year"; },
  { .code = "common_year";   .why = "365 days exactly — no native form"; },
  { .code = "leap_year";     .why = "366 days exactly — no native form"; },
  { .code = "sidereal_day";  .why = "no native form — bovnar's d is the solar day"; },
  { .code = "lunar_month";   .why = "synodal month — no native form"; },
  { .code = "sidereal_month"; .why = "no native form — bovnar's mo is the Julian month"; },
  { .code = "tropical_month"; .why = "no native form — bovnar's mo is the Julian month"; },

  # ── Survey-foot lengths ──────────────────────────────────────────────────
  # UDUNITS builds these on the US survey foot (1200/3937 m), so each is
  # 2 ppm longer than the native atom that shares its name -- and the acre,
  # being an area, is 4 ppm out. Mapping them would be dimensionally perfect
  # and silently wrong, which is the one failure this format exists to stop.
  # ucum.bvnr refuses the survey inch and mile for exactly this reason.
  { .code = "chain";   .why = "US survey chain (66 survey feet); native ch is the international chain"; },
  { .code = "rod";     .why = "US survey rod (16.5 survey feet); native rd is the international rod"; },
  { .code = "furlong"; .why = "US survey furlong (660 survey feet); native fur is the international furlong"; },
  { .code = "fathom";  .why = "US survey fathom (6 survey feet); native fath is the international fathom"; },
  { .code = "acre";    .why = "US survey acre (160 survey rod²); native ac is the international acre"; },

  # ── Calories that are not the thermochemical one ─────────────────────────
  # Native cal is 4.184 J. UDUNITS' unqualified "calorie" is the IT calorie,
  # 4.1868 J -- 0.067 % away and dimensionally identical, so it cannot map.
  #
  # UDUNITS' own "thermochemical_calorie" IS native cal exactly and now maps.
  # It could not when this block was written: at 22 bytes it put the profile's
  # worst case over BVNR_UNIT_STRING_MAX, which was 192. That constant is 1024
  # now, so the spelling fits and the unqualified forms below stay refused.
  { .code = "calorie";                .why = "the unqualified UDUNITS calorie is the IT calorie (4.1868 J); native cal is thermochemical — write the native cal"; },
  { .code = "cal";                    .why = "the unqualified UDUNITS cal is the IT calorie; native cal is thermochemical — write the native cal"; },
  { .code = "IT_calorie";             .why = "IT calorie (4.1868 J); native cal is thermochemical"; },

  # ── Scales with no decade to fold into ───────────────────────────────────
  { .code = "shake"; .why = "1e-8 s — there is no SI prefix for 10⁻⁸"; },
];
