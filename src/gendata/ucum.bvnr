#!bovnar 1.1
# ucum.bvnr — single source of truth for the UCUM unit profile.
#
# HOW THIS WORKS
#   Hand-edited. gen_profiles.py (at the repo root) regenerates the C profile
#   tables from this file on every build; never edit the generated *.gen.{h,inc}.
#   To add or change an atom, edit a record below and rebuild.
#
# WHAT IS IN HERE
#   Three atom lists, one per outcome the profile can reach
#   (doc/11_bovnar_unit_profiles.md section 3.1), plus UCUM's own prefix
#   spellings.
#
#     .prefixes    UCUM prefix spelling -> decimal decade. UCUM's spellings, not
#                  bovnar's: micro is "u", not "µ".
#
#     .mapped      A UCUM ATOM that translates onto the native registry. .bovnar
#                  is a native unit expression parsed by bvn_parse_unit at table
#                  build time, so it may be compound ("g·gn") or already carry a
#                  prefix ("k~mmHg"). A UCUM prefix on the atom is applied as a
#                  DECADE on top of whatever the target already is, which is what
#                  lets "m[Hg]" -> "k~mmHg" and "mm[Hg]" -> "mmHg" both fall out
#                  of one rule (see the fold in gen/parse).
#
#     .opaque      A UCUM arbitrary unit: assay-defined, commensurable with
#                  nothing, not even with another arbitrary unit. Each gets its
#                  own value_base_unit_t id in the shared OPAQUE BLOCK, and NO
#                  native alias -- these are reachable only through "ucum:" and
#                  serialise back the same way. The block is shared with every
#                  other profile and the ids are assigned by gen_profiles.py, so
#                  there is no .id field here to keep in step.
#
#     .unsupported A UCUM atom this profile knows but cannot represent. Listed so
#                  that it fails as error_unit_profile_unsupported ("you wrote it
#                  right and we cannot carry it") rather than error_unit_illegal
#                  ("that is not a UCUM atom"). An atom in NONE of the three
#                  lists is error_unit_illegal.
#
# ATOMS, NOT CODES
#   Every record is an ATOM. "kg" is not a row -- "g" is, and "k" is a prefix.
#   "mm[Hg]" is not a row -- "m[Hg]" is. This is what keeps the table small and
#   what makes prefix handling uniform.
#
# WHAT IS DELIBERATELY ABSENT
#   UCUM's case-insensitive variant. Currencies (UCUM has none). Anything whose
#   UCUM value this file cannot state exactly: when in doubt an atom goes in
#   .unsupported, because refusing costs a producer an error message and guessing
#   costs them a wrong number.

.schema_version = <uint:16> 1;

# ── UCUM prefixes ───────────────────────────────────────────────────────────
# .decade is the power of ten. The profile applies it as a decade on top of the
# atom's native target rather than as a bovnar prefix id, so a target that
# already carries a prefix composes correctly.
.prefixes = [
  { .code = "Y";  .decade =  24; },
  { .code = "Z";  .decade =  21; },
  { .code = "E";  .decade =  18; },
  { .code = "P";  .decade =  15; },
  { .code = "T";  .decade =  12; },
  { .code = "G";  .decade =   9; },
  { .code = "M";  .decade =   6; },
  { .code = "k";  .decade =   3; },
  { .code = "h";  .decade =   2; },
  { .code = "da"; .decade =   1; },
  { .code = "d";  .decade =  -1; },
  { .code = "c";  .decade =  -2; },
  { .code = "m";  .decade =  -3; },
  { .code = "u";  .decade =  -6; },
  { .code = "n";  .decade =  -9; },
  { .code = "p";  .decade = -12; },
  { .code = "f";  .decade = -15; },
  { .code = "a";  .decade = -18; },
  { .code = "z";  .decade = -21; },
  { .code = "y";  .decade = -24; },
];

# ── Atoms that translate ────────────────────────────────────────────────────
.mapped = [
  # SI base units
  { .code = "m";    .bovnar = "m";   .metric = true; },
  { .code = "s";    .bovnar = "s";   .metric = true; },
  { .code = "g";    .bovnar = "g";   .metric = true; },
  # The ampere. Absent until the cross-vocabulary suite asked every vocabulary
  # for all seven SI base units and this was the one that did not answer.
  { .code = "A";    .bovnar = "A";   .metric = true; },
  { .code = "K";    .bovnar = "K";   .metric = true; },
  { .code = "mol";  .bovnar = "mol"; .metric = true; },
  { .code = "cd";   .bovnar = "cd";  .metric = true; },
  { .code = "rad";  .bovnar = "rad"; .metric = true; },
  { .code = "sr";   .bovnar = "sr";  .metric = true; },

  # Named SI-derived units
  { .code = "Hz";   .bovnar = "Hz";  .metric = true; },
  { .code = "N";    .bovnar = "N";   .metric = true; },
  { .code = "Pa";   .bovnar = "Pa";  .metric = true; },
  { .code = "J";    .bovnar = "J";   .metric = true; },
  { .code = "W";    .bovnar = "W";   .metric = true; },
  { .code = "V";    .bovnar = "V";   .metric = true; },
  { .code = "Ohm";  .bovnar = "Ω";   .metric = true; },
  { .code = "F";    .bovnar = "F";   .metric = true; },
  { .code = "C";    .bovnar = "C";   .metric = true; },
  { .code = "S";    .bovnar = "S";   .metric = true; },
  { .code = "mho";  .bovnar = "S";   .metric = true; },
  { .code = "Wb";   .bovnar = "Wb";  .metric = true; },
  { .code = "T";    .bovnar = "T";   .metric = true; },
  { .code = "H";    .bovnar = "H";   .metric = true; },
  { .code = "lm";   .bovnar = "lm";  .metric = true; },
  { .code = "lx";   .bovnar = "lx";  .metric = true; },
  { .code = "Bq";   .bovnar = "Bq";  .metric = true; },
  { .code = "Gy";   .bovnar = "Gy";  .metric = true; },
  { .code = "Sv";   .bovnar = "Sv";  .metric = true; },
  { .code = "kat";  .bovnar = "kat"; .metric = true; },

  # Metric non-SI
  { .code = "L";    .bovnar = "L";     .metric = true; },
  { .code = "l";    .bovnar = "L";     .metric = true; },
  { .code = "t";    .bovnar = "t";     .metric = true; },
  { .code = "u";    .bovnar = "Da";    .metric = true; },
  { .code = "eV";   .bovnar = "eV";    .metric = true; },
  { .code = "ar";   .bovnar = "c~ha";  .metric = true; },
  # The stere is exactly a cubic metre. It is also the sharpest collision in the
  # two namespaces: bovnar's native "st" is the STONE, 6.35 kg. Both spellings
  # parse, and their dimensions differ -- which is why translation runs on UCUM's
  # resolved atom and never by handing the UCUM string to the native parser.
  { .code = "st";   .bovnar = "m^3";   .metric = true; },
  { .code = "bar";  .bovnar = "bar";   .metric = true; },
  { .code = "atm";  .bovnar = "atm";   .metric = false; },
  { .code = "Ao";   .bovnar = "Å";     .metric = false; },
  { .code = "b";    .bovnar = "barn";  .metric = false; },
  { .code = "AU";   .bovnar = "au";    .metric = false; },
  { .code = "pc";   .bovnar = "pc";    .metric = true; },

  # Time. Bovnar's yr is 31557600 s (365.25 d) and its mo is 2629800 s
  # (30.4375 d) -- the JULIAN year and month exactly, which is what UCUM's
  # unqualified "a" and "mo" are. The tropical and gregorian variants have no
  # native form and are in .unsupported.
  { .code = "min";  .bovnar = "min"; .metric = false; },
  { .code = "h";    .bovnar = "h";   .metric = false; },
  { .code = "d";    .bovnar = "d";   .metric = false; },
  { .code = "wk";   .bovnar = "wk";  .metric = false; },
  { .code = "mo";   .bovnar = "mo";  .metric = false; },
  { .code = "mo_j"; .bovnar = "mo";  .metric = false; },
  { .code = "a";    .bovnar = "yr";  .metric = false; },
  { .code = "a_j";  .bovnar = "yr";  .metric = false; },

  # Angle and logarithmic. "B" is the BEL, not the byte -- UCUM writes the byte
  # "By". 1 B = 10 dB exactly in the logarithmic domain, and bovnar's dB carries
  # its own quantity kind, so da~dB cannot drift into a plain count.
  { .code = "deg";   .bovnar = "°";      .metric = false; },
  { .code = "gon";   .bovnar = "grad";   .metric = false; },
  { .code = "'";     .bovnar = "arcmin"; .metric = false; },
  { .code = "''";    .bovnar = "arcsec"; .metric = false; },
  { .code = "circ";  .bovnar = "rev";    .metric = false; },
  { .code = "Np";    .bovnar = "Np";     .metric = true;  },
  { .code = "B";     .bovnar = "da~dB";  .metric = true;  },
  { .code = "[pH]";  .bovnar = "pH";     .metric = false; },

  # Temperature. The native affine discipline applies unchanged: valid at
  # exponent 1 only, and a compound containing one yields no conversion value.
  { .code = "Cel";     .bovnar = "°C";  .metric = true;  },
  { .code = "[degF]";  .bovnar = "°F";  .metric = false; },
  { .code = "[degRe]"; .bovnar = "°Re"; .metric = false; },
  { .code = "[degR]";  .bovnar = "°Ra"; .metric = false; },

  # Length, US and Imperial
  { .code = "[in_i]";   .bovnar = "in";   .metric = false; },
  { .code = "[ft_i]";   .bovnar = "ft";   .metric = false; },
  { .code = "[yd_i]";   .bovnar = "yd";   .metric = false; },
  { .code = "[mi_i]";   .bovnar = "mi";   .metric = false; },
  { .code = "[nmi_i]";  .bovnar = "nmi";  .metric = false; },
  { .code = "[ft_us]";  .bovnar = "ftUS"; .metric = false; },
  { .code = "[fth_i]";  .bovnar = "fath"; .metric = false; },
  { .code = "[ly]";     .bovnar = "ly";   .metric = true;  },
  { .code = "[mil_i]";  .bovnar = "thou"; .metric = false; },
  # The hand is four international inches and the mesh is one per inch. Neither
  # needs a native unit of its own: "hand" already is one, and a reciprocal
  # length is an ordinary native exponent.
  { .code = "[hd_i]";   .bovnar = "hand";  .metric = false; },
  { .code = "[mesh_i]"; .bovnar = "in^-1"; .metric = false; },
  # Ramden's chain and its link are the ONE surveyor's pair built on a length
  # this build already has exactly: 100 US survey feet, and 1 of them. Gunter's
  # chain, [lk_us], is not -- it is 66 survey feet and lands nowhere native.
  #
  # .reverse = false on the link: it is worth exactly one survey foot, so
  # without it the reverse table has two codes for native ftUS and a plain
  # survey foot could be written back as "a link of Ramden's chain".
  { .code = "[rch_us]"; .bovnar = "h~ftUS"; .metric = false; },
  { .code = "[rlk_us]"; .bovnar = "ftUS";   .metric = false; .reverse = false; },
  # NOT [ch_br], [ft_br], [yd_br] and the rest of the British series. They
  # sit 7.9e-7 from the international units of the same name -- a genuinely
  # different foot, and close enough that check_profile_factors.py matched
  # the British chain to the international one until its tolerance was
  # tightened to 7.5e-7 on the strength of exactly this pair.
  # [fur_us], [ch_us], [rd_us] and [acr_us] are NOT here. Every one is a US
  # SURVEY unit, built on the survey foot (1200/3937 m), while the native fur,
  # ch, rd and ac are international -- 2 ppm apart for the lengths and 4 ppm
  # for the area. They were mapped onto the international atoms, which is the
  # same class of error this file already refuses [in_us] and [mi_us] for, and
  # exactly the shape doc/11 §6.3 warns about for the BTU: dimensionally
  # perfect, far inside anything a later check would notice, and wrong.
  # UCUM has no international chain, rod or furlong to map instead.

  # Area and volume of the international lengths. UCUM gives each its own atom;
  # bovnar spells it as the length with an exponent, which is the same unit and
  # needs no registry row. These are the six codes doc/11 §9.6's coverage index
  # reported as exactly a native unit and nothing carried.
  #
  # The US SURVEY squares are deliberately absent for the same reason their
  # lengths are: [srd_us], [smi_us] and [sct] are built on the survey foot.
  { .code = "[sin_i]";  .bovnar = "in^2"; .metric = false; },
  { .code = "[sft_i]";  .bovnar = "ft^2"; .metric = false; },
  { .code = "[syd_i]";  .bovnar = "yd^2"; .metric = false; },
  { .code = "[cin_i]";  .bovnar = "in^3"; .metric = false; },
  { .code = "[cft_i]";  .bovnar = "ft^3"; .metric = false; },
  { .code = "[cyd_i]";  .bovnar = "yd^3"; .metric = false; },

  # Mass
  { .code = "[lb_av]";    .bovnar = "lb";    .metric = false; },
  { .code = "[oz_av]";    .bovnar = "oz";    .metric = false; },
  { .code = "[dr_av]";    .bovnar = "dr";    .metric = false; },
  { .code = "[gr]";       .bovnar = "gr";    .metric = false; },
  { .code = "[stone_av]"; .bovnar = "st";    .metric = false; },
  { .code = "[oz_tr]";    .bovnar = "oz_t";  .metric = false; },
  { .code = "[pwt_tr]";   .bovnar = "dwt";   .metric = false; },
  { .code = "[sc_ap]";    .bovnar = "sc";    .metric = false; },
  # The apothecary dram is three scruples, and the avoirdupois dram bovnar
  # spells "dr" is a different mass by a factor of 2.2. The apothecary POUND is
  # twelve apothecary ounces, and an apothecary ounce IS a troy ounce, so
  # [lb_ap] and [lb_tr] are one unit; [lb_ap] is not the spelling it is written
  # back as.
  { .code = "[dr_ap]";    .bovnar = "dr_ap"; .metric = false; },
  { .code = "[lb_tr]";    .bovnar = "lb_t";  .metric = false; },
  { .code = "[lb_ap]";    .bovnar = "lb_t";  .metric = false; .reverse = false; },
  { .code = "[car_m]";    .bovnar = "ct";    .metric = false; },
  # The apothecary ounce IS the troy ounce. The apothecary DRAM is not the
  # avoirdupois one, though -- 3.8879346 g against 1.7718 g -- so it is refused
  # below rather than mapped onto bovnar's dr, which is avoirdupois.
  #
  # .reverse = false: accepted on the way in, never emitted on the way out. The
  # two codes are worth the same and do not MEAN the same, so a troy ounce
  # written back as "[oz_ap]" would tell a UCUM reader "apothecary" about a
  # document that never said it. "[oz_tr]" is the spelling; without the flag the
  # shortest-wins rule takes this row, which is a byte shorter.
  { .code = "[oz_ap]";    .bovnar = "oz_t";  .metric = false; .reverse = false; },
  { .code = "[ston_av]";  .bovnar = "tn_sh"; .metric = false; },
  { .code = "[lton_av]";  .bovnar = "tn_l";  .metric = false; },
  # The SHORT hundredweight is a hundred avoirdupois pounds exactly, so the
  # hecto prefix carries it. The LONG one is 112 pounds and is refused below:
  # 112 is not a decade and there is no native hundredweight to land on.
  { .code = "[scwt_av]";  .bovnar = "h~lb";  .metric = false; },

  # ── The units bu_survey_* and friends unblocked ──────────────────────
  #
  # Every one of these was refused for want of a native unit, never because
  # UCUM's definition was unclear. The survey lengths are exact rationals on
  # the survey foot; [gal_wi], the historical Winchester gallon, IS the US
  # dry gallon; [cr_i] and [crd_us] are one cord under two spellings.
  { .code = "[in_us]";  .bovnar = "inUS";    .metric = false; },
  { .code = "[yd_us]";  .bovnar = "ydUS";    .metric = false; },
  { .code = "[mi_us]";  .bovnar = "miUS";    .metric = false; },
  { .code = "[fth_us]"; .bovnar = "fathUS";  .metric = false; },
  { .code = "[rd_us]";  .bovnar = "rdUS";    .metric = false; },
  { .code = "[ch_us]";  .bovnar = "chUS";    .metric = false; },
  { .code = "[lk_us]";  .bovnar = "lkUS";    .metric = false; },
  { .code = "[fur_us]"; .bovnar = "furUS";   .metric = false; },
  { .code = "[acr_us]"; .bovnar = "acUS";    .metric = false; },
  { .code = "[pnt]";    .bovnar = "pnt";     .metric = false; },
  { .code = "[pca]";    .bovnar = "pca";     .metric = false; },
  { .code = "[lne]";    .bovnar = "lne";     .metric = false; },
  { .code = "[dqt_us]"; .bovnar = "qt_dry";  .metric = false; },
  { .code = "[dpt_us]"; .bovnar = "pt_dry";  .metric = false; },
  { .code = "[gal_wi]"; .bovnar = "gal_dry"; .metric = false; },
  { .code = "[bf_i]";   .bovnar = "fbm";     .metric = false; },
  { .code = "[cr_i]";   .bovnar = "cord";    .metric = false; },
  { .code = "[crd_us]"; .bovnar = "cord";    .metric = false;  .reverse = false; },
  # The long hundredweight is 112 lb, which no prefix reaches -- unlike the
  # short one above, which is exactly a hecto-pound.
  { .code = "[lcwt_av]";  .bovnar = "cwt_l"; .metric = false; },

  # Volume
  { .code = "[gal_us]"; .bovnar = "gal";      .metric = false; },
  { .code = "[qt_us]";  .bovnar = "qt";       .metric = false; },
  { .code = "[pt_us]";  .bovnar = "pt";       .metric = false; },
  { .code = "[foz_us]"; .bovnar = "fl_oz";    .metric = false; },
  { .code = "[tbs_us]"; .bovnar = "tbsp";     .metric = false; },
  { .code = "[tsp_us]"; .bovnar = "tsp";      .metric = false; },
  { .code = "[cup_us]"; .bovnar = "cup";      .metric = false; },
  { .code = "[gil_us]"; .bovnar = "gi";       .metric = false; },
  { .code = "[fdr_us]"; .bovnar = "fl_dr";    .metric = false; },
  { .code = "[min_us]"; .bovnar = "minim";    .metric = false; },
  { .code = "[pk_us]";  .bovnar = "pk";       .metric = false; },
  { .code = "[bu_us]";  .bovnar = "bsh";      .metric = false; },
  { .code = "[bbl_us]"; .bovnar = "bbl";      .metric = false; },
  { .code = "[gal_br]"; .bovnar = "gal_uk";   .metric = false; },
  { .code = "[qt_br]";  .bovnar = "qt_uk";    .metric = false; },
  { .code = "[pt_br]";  .bovnar = "pt_uk";    .metric = false; },
  { .code = "[foz_br]"; .bovnar = "fl_oz_uk"; .metric = false; },
  { .code = "[gil_br]"; .bovnar = "gi_uk";    .metric = false; },

  # Pressure, energy, force, power. "m[Hg]" is a METRE of mercury column, so its
  # native target carries the kilo that makes "mm[Hg]" come out as plain mmHg.
  { .code = "m[Hg]";    .bovnar = "k~mmHg"; .metric = true;  },
  # The inch of mercury, and the two clinical resistances built on the mercury
  # column. All three inherit UCUM's rounding of that column -- it states the
  # metre of mercury to seven digits, so anything derived from it sits 2.9 ppm
  # from the exact conventional value bovnar uses. check_profile_factors.py
  # waives exactly that ratio for m[Hg] and now for these three, by name and
  # with the reason printed on every run; it is publisher rounding, not a
  # different unit. Native inHg is the exact one.
  { .code = "[in_i'Hg]"; .bovnar = "inHg";        .metric = false; },
  # The WATER column, the same shape as the mercury one above: "m[H2O]" is a
  # METRE of water and metric, so "cm[H2O]" falls out as the centimetre a
  # ventilator is set in. It was refused while there was no native water-column
  # unit to land on -- mapping it onto the technical atmosphere would have been
  # numerically perfect and would have handed a centimetre of water back as a
  # millitechnical atmosphere. bu_meter_water is that unit.
  { .code = "m[H2O]";   .bovnar = "mH2O";   .metric = true;  },
  # UCUM builds the inch of water as m[H2O].[in_i]/m, and so does this.
  { .code = "[in_i'H2O]"; .bovnar = "in·mH2O/m";  .metric = false; .reverse = false; },
  { .code = "[PRU]";     .bovnar = "mmHg·s/m~L";  .metric = false; },
  { .code = "[wood'U]";  .bovnar = "mmHg·min/L";  .metric = false; },
  { .code = "[psi]";    .bovnar = "psi";    .metric = false; },
  { .code = "tex";      .bovnar = "tex";    .metric = true;  },
  { .code = "[den]";    .bovnar = "den";    .metric = false; },
  { .code = "att";      .bovnar = "at";     .metric = false; },
  # UCUM's unqualified "cal" is the THERMOCHEMICAL calorie, which is what
  # bovnar's cal is (4.184 J exactly), so both spellings map. The BTU does NOT
  # line up the same way: bovnar's Btu is the IT one (1055.05585262 J), so only
  # [Btu_IT] maps and every other BTU variant -- including the unqualified
  # [Btu] -- is refused below rather than silently mapped 0.07 % wrong.
  { .code = "cal_th";   .bovnar = "cal";    .metric = true;  },
  { .code = "cal";      .bovnar = "cal";    .metric = true;  },
  { .code = "cal_IT";   .bovnar = "cal_IT"; .metric = true;  },
  # The nutrition Calorie is 1000 thermochemical calories.
  { .code = "[Cal]";    .bovnar = "k~cal";  .metric = false; },
  { .code = "[Btu_IT]"; .bovnar = "Btu";    .metric = false; },
  # bu_btu_th is the thermochemical BTU, so [Btu_th] and UCUM's unqualified
  # [Btu] -- which UCUM defines AS [Btu_th] -- both land on it. [Btu] carries
  # .reverse = false so the unit is written back under the qualified spelling.
  { .code = "[Btu_th]"; .bovnar = "Btu_th"; .metric = false; },
  { .code = "[Btu]";    .bovnar = "Btu_th"; .metric = false; .reverse = false; },
  { .code = "erg";      .bovnar = "erg";    .metric = false; },
  { .code = "[HP]";     .bovnar = "hp";     .metric = false; },
  { .code = "[kn_i]";   .bovnar = "kn";     .metric = false; },
  { .code = "dyn";      .bovnar = "dyn";    .metric = false; },
  # Bovnar has no gram-force, but gram times standard gravity IS one, exactly:
  # dimensions [1,1,-2,0,0,0,0], factor 0.00980665. A mapping need not be
  # atom-to-atom.
  { .code = "gf";       .bovnar = "g·gn";   .metric = false; },
  { .code = "[lbf_av]"; .bovnar = "lbf";    .metric = false; },
  { .code = "[g]";      .bovnar = "gn";     .metric = false; },

  # CGS and radiation
  { .code = "P";     .bovnar = "P";     .metric = false; },
  { .code = "St";    .bovnar = "St";    .metric = false; },
  { .code = "Gal";   .bovnar = "Gal";   .metric = false; },
  { .code = "G";     .bovnar = "G";     .metric = false; },
  { .code = "Mx";    .bovnar = "Mx";    .metric = false; },
  { .code = "Oe";    .bovnar = "Oe";    .metric = false; },
  # The biot is ten amperes; the kayser is one reciprocal centimetre.
  { .code = "Bi";    .bovnar = "da~A";  .metric = false; },
  { .code = "Ky";    .bovnar = "c~m^-1"; .metric = true;  },
  # The gilbert, transliterated from UCUM's own definition of it (Oe.cm) rather
  # than from its value. Both give the same number; only this one gives a row a
  # reader can check against the publication.
  { .code = "Gb";    .bovnar = "Oe·c~m"; .metric = false; },
  { .code = "sb";    .bovnar = "sb";    .metric = false; },
  { .code = "ph";    .bovnar = "ph";    .metric = false; },
  { .code = "Ci";    .bovnar = "Ci";    .metric = true;  },
  # "RAD" and "REM", NOT "[RAD]"/"[REM]": the bracketed forms are UCUM's
  # CASE-INSENSITIVE codes, and this profile is the case-sensitive variant
  # only (doc/11 §10.3). The bracketed spellings were accepted here and are
  # not codes a conforming case-sensitive producer can emit.
  { .code = "RAD";   .bovnar = "c~Gy";  .metric = true;  },
  { .code = "REM";   .bovnar = "rem";   .metric = true;  },
  { .code = "R";     .bovnar = "R";     .metric = true;  },

  # Digital and ratio. UCUM's "b" is the BARN and its "By" is the byte; bovnar's
  # native "b" is the bit and its "B" is the byte. The namespaces disagree on
  # three letters and the profile keeps them apart
  # (doc/11_bovnar_unit_profiles.md 6.2).
  { .code = "bit";    .bovnar = "b";   .metric = true;  },
  { .code = "By";     .bovnar = "B";   .metric = true;  },
  { .code = "Bd";     .bovnar = "Bd";  .metric = true;  },
  { .code = "%";      .bovnar = "%";   .metric = false; },
  { .code = "[ppth]"; .bovnar = "‰";   .metric = false; },
  { .code = "[ppm]";  .bovnar = "ppm"; .metric = false; },
  { .code = "[ppb]";  .bovnar = "ppb"; .metric = false; },

  # Chemical. UCUM's "eq" is the GENERIC equivalent, one mole. Bovnar's native
  # "val" is the water-analysis equivalent of a DIVALENT species, factor 0.5 --
  # mapping eq onto it would be wrong by exactly two on every clinical
  # electrolyte value, so it maps to mol and val is left alone.
  #
  # .reverse = false, and this one is not cosmetic. "eq" is two bytes and "mol"
  # is three, so the shortest-wins rule made "eq" the code every mole was
  # WRITTEN as -- turning an amount of substance into an equivalent, a different
  # quantity that merely happens to be worth one mole, on every round trip
  # through the UCUM writer.
  { .code = "eq";  .bovnar = "mol";        .metric = true; .reverse = false; },
  { .code = "U";   .bovnar = "u~mol/min";  .metric = true; },
  # Gram percent is UCUM's own g/dl, written the native way. It is a mass
  # concentration and not a ratio, which is why it sits here and not beside %.
  { .code = "g%";  .bovnar = "g/d~L";      .metric = false; },

  # Optics. The dioptre is exactly a reciprocal metre.
  { .code = "[diop]"; .bovnar = "m^-1"; .metric = false; },
];

# ── UCUM arbitrary units ────────────────────────────────────────────────────
# Assay-defined; commensurable with nothing, including each other. These occupy
# the shared opaque block, which continues the value_base_unit_t enumeration
# after the last native unit. gen_profiles.py assigns the ids in registry order,
# so this list is APPEND-ONLY: inserting a row renumbers every opaque unit below
# it, in this profile and in every profile registered after it. Adding one must
# move the last-enumerator check in src/utils/bvn_internal_dims.h exactly as
# adding a native unit does.
#
# .name is the enumerator suffix (the C constant is bu_<name>) and must start
# "ucum_" so the enum stays namespaced. There is no .aliases field on purpose:
# an arbitrary unit has no native spelling, is reachable only through "ucum:",
# and serialises back as "ucum:<code>".
.opaque = [
  { .name = "ucum_iu";        .code = "[IU]";        .metric = true;  },
  { .name = "ucum_iu_i";      .code = "[iU]";        .metric = true;  },
  { .name = "ucum_arb_u";     .code = "[arb'U]";     .metric = false; },
  { .name = "ucum_usp_u";     .code = "[USP'U]";     .metric = false; },
  { .name = "ucum_gpl_u";     .code = "[GPL'U]";     .metric = false; },
  { .name = "ucum_mpl_u";     .code = "[MPL'U]";     .metric = false; },
  { .name = "ucum_apl_u";     .code = "[APL'U]";     .metric = false; },
  { .name = "ucum_beth_u";    .code = "[beth'U]";    .metric = false; },
  { .name = "ucum_anti_xa_u"; .code = "[anti'Xa'U]"; .metric = false; },
  { .name = "ucum_todd_u";    .code = "[todd'U]";    .metric = false; },
  { .name = "ucum_dye_u";     .code = "[dye'U]";     .metric = false; },
  { .name = "ucum_smgy_u";    .code = "[smgy'U]";    .metric = false; },
  { .name = "ucum_bdsk_u";    .code = "[bdsk'U]";    .metric = false; },
  { .name = "ucum_ka_u";      .code = "[ka'U]";      .metric = false; },
  { .name = "ucum_knk_u";     .code = "[knk'U]";     .metric = false; },
  { .name = "ucum_mclg_u";    .code = "[mclg'U]";    .metric = false; },
  { .name = "ucum_tb_u";      .code = "[tb'U]";      .metric = false; },
  { .name = "ucum_ccid_50";   .code = "[CCID_50]";   .metric = false; },
  { .name = "ucum_tcid_50";   .code = "[TCID_50]";   .metric = false; },
  { .name = "ucum_eid_50";    .code = "[EID_50]";    .metric = false; },
  { .name = "ucum_pfu";       .code = "[PFU]";       .metric = false; },
  { .name = "ucum_ffu";       .code = "[FFU]";       .metric = false; },
  { .name = "ucum_cfu";       .code = "[CFU]";       .metric = false; },
  { .name = "ucum_bau";       .code = "[BAU]";       .metric = false; },
  { .name = "ucum_au_allerg"; .code = "[AU]";        .metric = false; },
  { .name = "ucum_amb_a_1_u"; .code = "[Amb'a'1'U]"; .metric = false; },
  { .name = "ucum_pnu";       .code = "[PNU]";       .metric = false; },
  { .name = "ucum_lf";        .code = "[Lf]";        .metric = false; },
  { .name = "ucum_d_ag_u";    .code = "[D'ag'U]";    .metric = false; },
  { .name = "ucum_feu";       .code = "[FEU]";       .metric = false; },
  { .name = "ucum_elu";       .code = "[ELU]";       .metric = false; },
  { .name = "ucum_eu";        .code = "[EU]";        .metric = false; },

  # The homeopathic potency series, and the index of reactivity. UCUM flags all
  # nine isArbitrary, which is this list's entry condition, and they were simply
  # missed -- the table carried 32 of UCUM's 41 arbitrary units.
  #
  # Note the apostrophe. UCUM has TWO homeopathic families and they are not the
  # same kind of thing: "[hp'_X]" is a SPECIAL unit, a logarithm, and is refused
  # below; "[hp_X]" is the arbitrary one and belongs here. The four Korsakovian
  # codes have no special twin.
  { .name = "ucum_hp_x";      .code = "[hp_X]";      .metric = false; },
  { .name = "ucum_hp_c";      .code = "[hp_C]";      .metric = false; },
  { .name = "ucum_hp_m";      .code = "[hp_M]";      .metric = false; },
  { .name = "ucum_hp_q";      .code = "[hp_Q]";      .metric = false; },
  { .name = "ucum_kp_x";      .code = "[kp_X]";      .metric = false; },
  { .name = "ucum_kp_c";      .code = "[kp_C]";      .metric = false; },
  { .name = "ucum_kp_m";      .code = "[kp_M]";      .metric = false; },
  { .name = "ucum_kp_q";      .code = "[kp_Q]";      .metric = false; },
  { .name = "ucum_ir";        .code = "[IR]";        .metric = false; },
];

# ── Atoms UCUM defines that have no native representation ───────────────────
# These are error_unit_profile_unsupported, not error_unit_illegal: the producer
# wrote valid UCUM and the answer is "we cannot carry that", which calls for a
# different fix than "that is not a unit". .why is the reason, and is what the
# generator puts in the C table's comment column.
.unsupported = [
  # Special units defined by a function, whose reference the native dB cannot
  # carry. Translating them to da~dB would discard exactly what distinguishes
  # them and would let a sound-pressure level compare equal to a voltage level.
  { .code = "B[SPL]";   .why = "bel SPL — dB carries no reference level"; },
  { .code = "B[V]";     .why = "bel volt — dB carries no reference level"; },
  { .code = "B[mV]";    .why = "bel millivolt — dB carries no reference level"; },
  { .code = "B[uV]";    .why = "bel microvolt — dB carries no reference level"; },
  { .code = "B[W]";     .why = "bel watt — dB carries no reference level"; },
  { .code = "B[kW]";    .why = "bel kilowatt — dB carries no reference level"; },
  { .code = "B[10.nV]"; .why = "bel 10 nanovolt — dB carries no reference level"; },
  { .code = "[p'diop]"; .why = "prism dioptre — arctangent scale, no native form"; },
  { .code = "%[slope]"; .why = "percent of slope — arctangent scale, no native form"; },
  { .code = "[hp'_X]";  .why = "homeopathic potency — logarithmic, no native form"; },
  { .code = "[hp'_C]";  .why = "homeopathic potency — logarithmic, no native form"; },
  { .code = "[hp'_M]";  .why = "homeopathic potency — logarithmic, no native form"; },
  { .code = "[hp'_Q]";  .why = "homeopathic potency — logarithmic, no native form"; },
  { .code = "[m/s2/Hz^(1/2)]"; .why = "amplitude spectral density — fractional exponent"; },

  # Year and month variants bovnar does not carry. Its yr and mo are the Julian
  # ones and those DO map; these differ from them by enough to matter.
  { .code = "a_t";  .why = "tropical year — native yr is the Julian year"; },
  { .code = "a_g";  .why = "mean gregorian year — native yr is the Julian year"; },
  { .code = "mo_s"; .why = "synodal month — native mo is the Julian month"; },
  { .code = "mo_g"; .why = "mean gregorian month — native mo is the Julian month"; },

  # Physical constants used as units.
  { .code = "[c]";  .why = "speed of light as a unit — no native form"; },
  { .code = "[h]";  .why = "Planck constant as a unit — no native form"; },
  { .code = "[k]";  .why = "Boltzmann constant as a unit — no native form"; },
  { .code = "[eps_0]"; .why = "vacuum permittivity as a unit — no native form"; },
  { .code = "[mu_0]";  .why = "vacuum permeability as a unit — no native form"; },
  { .code = "[e]";     .why = "elementary charge as a unit — no native form"; },
  { .code = "[m_e]";   .why = "electron mass as a unit — no native form"; },
  { .code = "[m_p]";   .why = "proton mass as a unit — no native form"; },
  { .code = "[G]";     .why = "gravitational constant as a unit — no native form"; },

  # Osmolality. Deliberately refused rather than guessed: the relation between
  # an osmole and a mole depends on the dissociation of the species, which a
  # unit table cannot know.
  { .code = "osm";  .why = "osmole — species-dependent relation to the mole"; },

  # Columns of liquid other than mercury, and other pressure references bovnar
  # does not carry.

  # Energy conventions bovnar does not carry. Its cal is thermochemical (which
  # is what UCUM's unqualified cal is, so that one maps) and its Btu is the IT
  # one -- so every other calorie and EVERY other BTU, the unqualified [Btu]
  # included, is refused. Mapping [Btu] onto Btu would be wrong by 0.07 %:
  # small, dimensionally correct, and invisible to every later check.
  { .code = "[Btu_39]"; .why = "39 degF BTU — no native form"; },
  { .code = "[Btu_59]"; .why = "59 degF BTU — no native form"; },
  { .code = "[Btu_60]"; .why = "60 degF BTU — no native form"; },
  { .code = "[Btu_m]";  .why = "mean BTU — no native form"; },
  { .code = "cal_m";    .why = "mean calorie — no native form"; },
  { .code = "cal_[15]"; .why = "15 degC calorie — no native form"; },
  { .code = "cal_[20]"; .why = "20 degC calorie — no native form"; },

  # Apothecary weights other than the ounce and the scruple. The apothecary
  # dram is 3.8879346 g and bovnar's dr is the AVOIRDUPOIS dram at 1.7718 g --
  # a factor of 2.2 apart, which is exactly the kind of near-miss that makes an
  # eager mapping worse than a refusal.

  # Photometric and geometric atoms with no native form.
  { .code = "Lmb";   .why = "lambert — 1e4/pi cd/m^2, irrational against the native units"; },
  { .code = "sph";   .why = "spere — 4*pi steradian, not a decade"; },

  # US survey lengths other than the foot.
  # These four used to map onto the INTERNATIONAL fur, ch, rd and ac, which are
  # 2 ppm (4 ppm for the acre) away from the survey units these codes name.
  # UCUM defines no international chain, rod or furlong, so there is nothing to
  # map them to; refusing is the only honest answer until the native registry
  # grows the survey series.

  # Chemical and clinical atoms with no native form.
  { .code = "[S]";      .why = "Svedberg unit — no native form"; },
  { .code = "[HPF]";    .why = "high power field — a microscope field, not a unit"; },
  { .code = "[LPF]";    .why = "low power field — a microscope field, not a unit"; },
  { .code = "[drp]";    .why = "drop — volume varies with the dropper"; },
  { .code = "[MET]";    .why = "metabolic equivalent — 3.5 mL/min/kg, not a decade"; },

  # ── Everything below closes the table against ucum-essence.xml ────────────
  #
  # Until these rows existed an atom in NONE of the three lists came back as
  # error_unit_illegal, which says "that is not a UCUM atom" about 83 codes UCUM
  # does define. That is a false statement to a conforming producer, and it is
  # the one failure mode this list exists to prevent. Refusing a code costs an
  # error message; misnaming the refusal costs the producer the belief that they
  # wrote it wrong.
  #
  # None of these needed a conversion factor to be written down, which is why
  # they carry no risk: a .unsupported row asserts only that UCUM has the code
  # and this build cannot carry it.

  # UCUM's two numeric bases and the number pi. They are how UCUM writes a
  # scientific-notation exponent inside a unit ("10*-12"), not units at all,
  # and a bovnar unit slot has no scale factor for them to become.
  { .code = "10*";    .why = "the number ten — a numeric base for UCUM exponents, not a unit"; },
  { .code = "10^";    .why = "the number ten — a numeric base for UCUM exponents, not a unit"; },
  { .code = "[pi]";   .why = "the number pi — a constant, not a unit"; },
  # Native carries ppm and ppb and stops there.
  { .code = "[pptr]"; .why = "parts per trillion — native ratios stop at ppb"; },

  # Dimensionless instrument scales. UCUM defines each as the number one, which
  # makes every one of them worth exactly what a native ratio is worth and
  # commensurable with all of them. Mapping on that basis is how a turbidity
  # reading ends up comparing equal to a percentage, so all three are refused.
  # UCUM does not flag them isArbitrary, so .opaque -- which says "UCUM calls
  # this arbitrary" -- would misreport the publisher.
  { .code = "[NTU]";     .why = "nephelometric turbidity unit — an instrument scale UCUM defines as the number one"; },
  { .code = "[FNU]";     .why = "formazin nephelometric unit — an instrument scale UCUM defines as the number one"; },
  { .code = "[hnsf'U]";  .why = "Hounsfield unit — a CT attenuation scale UCUM defines as the number one"; },
  { .code = "[car_Au]";  .why = "carat of gold alloys — a 24ths fraction, not a decade"; },
  # A special unit: the logarithmic bit, UCUM's ld(x) function. Same reason the
  # bels above are refused -- native dB carries no reference and no base.
  { .code = "bit_s";     .why = "logarithmic bit — a base-2 logarithm, no native form"; },

  # The BRITISH imperial series, in full. doc/11 §6.3 and the note beside the
  # length block already say why none of it maps: the British foot is 2.539998
  # cm against the international 2.54, which puts the whole family 7.9e-7 from
  # the native units of the same name -- inside the noise floor of a decimal
  # comparison and a genuinely different unit. They were kept out by name; now
  # they are kept out by row, so the refusal says so.
  { .code = "[in_br]";  .why = "British inch (2.539998 cm) — native in is the international inch"; },
  { .code = "[ft_br]";  .why = "British foot — native ft is the international foot"; },
  { .code = "[yd_br]";  .why = "British yard — native yd is the international yard"; },
  { .code = "[mi_br]";  .why = "British mile — native mi is the international mile"; },
  { .code = "[nmi_br]"; .why = "British nautical mile (6080 British feet) — native nmi is 1852 m"; },
  { .code = "[kn_br]";  .why = "British knot — built on the British nautical mile"; },
  { .code = "[rd_br]";  .why = "British rod — native rd is the international rod"; },
  { .code = "[ch_br]";  .why = "British Gunter's chain — native ch is the international chain"; },
  { .code = "[lk_br]";  .why = "British link — built on the British chain"; },
  { .code = "[fth_br]"; .why = "British fathom — native fath is the international fathom"; },
  { .code = "[pc_br]";  .why = "British pace (2.5 British feet) — no native form"; },
  { .code = "[acr_br]"; .why = "British acre — native ac is the international acre"; },
  { .code = "[pk_br]";  .why = "British peck — native pk is the US dry peck"; },
  { .code = "[bu_br]";  .why = "British bushel — native bsh is the US dry bushel"; },
  { .code = "[fdr_br]"; .why = "British fluid dram — native fl_dr is the US one"; },
  { .code = "[min_br]"; .why = "British minim — native minim is the US one"; },

  # US SURVEY units beyond the foot and Ramden's pair, for the reason the block
  # above gives: bovnar carries the survey foot and nothing else built on it.
  { .code = "[srd_us]";  .why = "US survey square rod — bovnar carries only the survey foot"; },
  { .code = "[smi_us]";  .why = "US survey square mile — bovnar carries only the survey foot"; },
  { .code = "[sct]";     .why = "section — a survey square mile, no native form"; },
  { .code = "[twp]";     .why = "township — 36 sections, no native form"; },
  { .code = "[mil_us]";  .why = "US survey mil — native thou is the international mil"; },

  # US dry measure below the peck, and the historical gallon it came from.

  # The METRIC kitchen and jewellers' measures. Each is a round number of
  # millilitres or grams rather than a decade off one, so the unit slot -- which
  # scales by powers of ten and nothing else -- cannot reach them.
  { .code = "[foz_m]";   .why = "metric fluid ounce (30 mL) — not a decade off any native volume"; },
  { .code = "[cup_m]";   .why = "metric cup (240 mL) — not a decade off any native volume"; },
  { .code = "[tsp_m]";   .why = "metric teaspoon (5 mL) — not a decade off any native volume"; },
  { .code = "[tbs_m]";   .why = "metric tablespoon (15 mL) — not a decade off any native volume"; },
  { .code = "[oz_m]";    .why = "metric ounce (28 g) — not a decade off any native mass"; },

  # Imperial and troy masses with no native counterpart.

  # Volumes defined as a whole-number multiple of a native unit. Same reason as
  # the metric kitchen: 144 and 128 are not powers of ten.
  { .code = "[cml_i]";   .why = "circular mil — pi/4 of a square mil, irrational against the native units"; },
  { .code = "[smoot]";   .why = "Smoot (67 inches) — 67 is not a decade"; },
  { .code = "[Ch]";      .why = "Charriere (a third of a millimetre) — thirds are not decades"; },

  # Typographic and pre-metric French lengths. Both families are built on
  # twelfths and sixths of each other, so none of them is a decade off a native
  # length, and bovnar has no point, pica, ligne or pouce to land on.
  { .code = "[pnt_pr]";  .why = "printer's point (0.013837 in) — no native typographic length"; },
  { .code = "[pca_pr]";  .why = "printer's pica — no native typographic length"; },
  { .code = "[pied]";    .why = "pied (32.48 cm) — no native form"; },
  { .code = "[pouce]";   .why = "pouce (1/12 pied) — no native form"; },
  { .code = "[ligne]";   .why = "ligne (1/12 pouce) — no native form"; },
  { .code = "[didot]";   .why = "didot (1/6 ligne) — no native form"; },
  { .code = "[cicero]";  .why = "cicero (12 didot) — no native form"; },

  # The water column. m[H2O] above is refused for want of a native form and
  # this inherits it; the technical atmosphere is exactly ten metres of water,
  # so a mapping onto d~at would be numerically perfect and would hand a
  # clinician's centimetre of water back as a millitechnical atmosphere.
];
