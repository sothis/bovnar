  { .code = "arcsec";     .bovnar = "arcsec"; .metric = false; },
  { .code = "arcsecond";  .bovnar = "arcsec"; .metric = false; },
  { .code = "grade";      .bovnar = "grad";   .metric = false; },

  # ── Imperial and US customary: length ────────────────────────────────────
  # The international foot and its multiples only. UDUNITS defines "chain",
  # "rod", "furlong" and "fathom" on the US SURVEY foot (1200/3937 m), not on
  # the international one, so they are 2 ppm off the native atoms of the same
  # name and are refused below rather than mapped -- the same rule ucum.bvnr
  # applies to the survey inch and the survey mile.
  { .code = "in";                  .bovnar = "in";   .metric = false; },
  { .code = "inch";                .bovnar = "in";   .metric = false; },
  { .code = "international_inch";  .bovnar = "in";   .metric = false; },
  { .code = "ft";                  .bovnar = "ft";   .metric = false; },
  { .code = "foot";                .bovnar = "ft";   .metric = false; },
  { .code = "feet";                .bovnar = "ft";   .metric = false; },
  { .code = "international_foot";  .bovnar = "ft";   .metric = false; },
  { .code = "yd";                  .bovnar = "yd";   .metric = false; },
  { .code = "yard";                .bovnar = "yd";   .metric = false; },
  { .code = "international_yard";  .bovnar = "yd";   .metric = false; },
  { .code = "mi";                  .bovnar = "mi";   .metric = false; },
  { .code = "mile";                .bovnar = "mi";   .metric = false; },
  { .code = "international_mile";  .bovnar = "mi";   .metric = false; },
  { .code = "nmi";                 .bovnar = "nmi";  .metric = false; },
  { .code = "nmile";               .bovnar = "nmi";  .metric = false; },
  { .code = "nautical_mile";       .bovnar = "nmi";  .metric = false; },
  { .code = "US_survey_foot";      .bovnar = "ftUS"; .metric = false; },
  { .code = "mil";                 .bovnar = "thou"; .metric = false; },

  # ── Imperial and US customary: mass ──────────────────────────────────────
  # "oz" is NOT here: in UDUNITS it is a symbol of the US FLUID ounce, a
  # volume. See the volume block. The avoirdupois ounce is spelled out.
  { .code = "lb";                  .bovnar = "lb";   .metric = false; },
  { .code = "pound";               .bovnar = "lb";   .metric = false; },
  { .code = "avoirdupois_pound";   .bovnar = "lb";   .metric = false; },
  { .code = "avoirdupois_ounce";   .bovnar = "oz";   .metric = false; },
  { .code = "dr";                  .bovnar = "dr";   .metric = false; },
  { .code = "dram";                .bovnar = "dr";   .metric = false; },
  { .code = "grain";               .bovnar = "gr";   .metric = false; },
  { .code = "troy_ounce";          .bovnar = "oz_t"; .metric = false; },
  { .code = "apothecary_ounce";    .bovnar = "oz_t"; .metric = false; },
  { .code = "apounce";             .bovnar = "oz_t"; .metric = false; },
  { .code = "pennyweight";         .bovnar = "dwt";  .metric = false; },
  { .code = "scruple";             .bovnar = "sc";   .metric = false; },
  { .code = "carat";               .bovnar = "ct";   .metric = false; },
  { .code = "slug";                .bovnar = "slug"; .metric = false; },
  { .code = "ton";                 .bovnar = "tn_sh"; .metric = false; },
  { .code = "short_ton";           .bovnar = "tn_sh"; .metric = false; },
  { .code = "long_ton";            .bovnar = "tn_l";  .metric = false; },
  { .code = "metric_ton";          .bovnar = "t";     .metric = false; },

  # ── Imperial and US customary: volume ────────────────────────────────────
  # UDUNITS' bare "oz", "floz", "cup", "gill", "pint" and "quart" are the US
  # LIQUID measures; the UK ones carry a UK_ prefix and are separate atoms
  # here, as they are natively.
  { .code = "gallon";              .bovnar = "gal";      .metric = false; },
  { .code = "US_liquid_gallon";    .bovnar = "gal";      .metric = false; },
  { .code = "quart";               .bovnar = "qt";       .metric = false; },
