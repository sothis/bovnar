#!bovnar 1.1
# udunits.bvnr — single source of truth for the UDUNITS-2 unit profile.
#
# HOW THIS WORKS
#   Hand-edited. gen_profiles.py regenerates the C profile tables on every build;
#   never edit the generated *.gen.{h,inc}.
#
# WHAT THIS VOCABULARY IS
#   UDUNITS-2, Unidata's unit library and its XML unit database. Its string
#   grammar is the de-facto units syntax of netCDF and the CF conventions, which
#   is why the profile exists: an earth-science producer whose unit arrives as
#   "m s-1" or "kg m-2 s-1" should not have to translate it first.
#
#   An EXPR profile, sharing the parser with UCUM. UDUNITS' operators differ --
#   '*' also multiplies and '^' introduces an exponent -- and those differences
#   are configured on the registry row in bovnar_profiles.c rather than forked
#   into a second parser. The DIVISION rule is the same: '/' inverts the term
#   that follows it, which is ordinary left-to-right arithmetic and is what both
#   vocabularies mean.
#
# SPACE DOES NOT MULTIPLY HERE, AND CANNOT
#   UDUNITS multiplies with a space, and CF's commonest spelling is "kg m-2 s-1".
#   Bovnar cannot accept it: the lexer deletes whitespace inside a type
#   annotation, so the slot "udunits:m s-1" arrives as "udunits:ms-1" -- which is
#   itself valid UDUNITS, meaning RECIPROCAL MILLISECONDS. Treating space as an
#   operator would not have made the space-separated form work; it would have
#   made the wrong reading of it look supported. Write "kg*m-2*s-1" or
#   "kg.m-2.s-1", both of which UDUNITS also accepts.
#
# ATOMS, NOT CODES
#   Every record is an ATOM. "km" is not a row -- "m" is, and "k" is a prefix.
#   UDUNITS accepts both symbols and spelled-out names for units AND prefixes, so
#   both appear here: "m" and "meter" are separate rows because UDUNITS treats
#   them as separate spellings of one unit, and "kilo" is a prefix beside "k".
#
# REFERENCE-TIME ("<unit> since <timestamp>") IS NOT HERE
#   UDUNITS' most distinctive construct is deliberately refused, with its own
#   reason string, and it is refused for a structural reason rather than a
#   scheduling one. See section 10.3 of doc/11_bovnar_unit_profiles.md. In short:
#   a bovnar timestamp is <datetime:width,epoch>, whose EPOCH lives in the type
#   spec's base slot -- not in the unit slot -- and whose carrier is defined as a
#   count of SECONDS. A unit-slot expression can therefore neither select the
#   datetime family nor rescale its carrier to days, so "days since 1970-01-01"
#   has nowhere to land. Refusing it costs a producer an error message that says
#   exactly this; accepting it would cost them a silently wrong instant.
#
# PROVENANCE — READ THIS BEFORE TRUSTING A ROW
#   The .bovnar target of every row is checked against this build's native
#   registry by gen_profiles.py, and the translation is pinned by
#   tests/bovnar_udunits_test.c. NEITHER checks the UDUNITS side. Same standing
#   risk as every other profile here; a confident subset, and when in doubt an
#   atom goes in .unsupported.

.schema_version = <uint:16> 1;

# ── UDUNITS prefixes ────────────────────────────────────────────────────────
# Symbols and spelled-out names both, because UDUNITS accepts both. .decade is
# the power of ten, applied on top of whatever the atom's native target already
# is -- the same fold UCUM uses.
.prefixes = [
  { .code = "yotta"; .decade =  24; },  { .code = "Y";  .decade =  24; },
  { .code = "zetta"; .decade =  21; },  { .code = "Z";  .decade =  21; },
  { .code = "exa";   .decade =  18; },  { .code = "E";  .decade =  18; },
  { .code = "peta";  .decade =  15; },  { .code = "P";  .decade =  15; },
  { .code = "tera";  .decade =  12; },  { .code = "T";  .decade =  12; },
  { .code = "giga";  .decade =   9; },  { .code = "G";  .decade =   9; },
  { .code = "mega";  .decade =   6; },  { .code = "M";  .decade =   6; },
  { .code = "kilo";  .decade =   3; },  { .code = "k";  .decade =   3; },
  { .code = "hecto"; .decade =   2; },  { .code = "h";  .decade =   2; },
  { .code = "deka";  .decade =   1; },  { .code = "da"; .decade =   1; },
  { .code = "deci";  .decade =  -1; },  { .code = "d";  .decade =  -1; },
  { .code = "centi"; .decade =  -2; },  { .code = "c";  .decade =  -2; },
  { .code = "milli"; .decade =  -3; },  { .code = "m";  .decade =  -3; },
  { .code = "micro"; .decade =  -6; },  { .code = "u";  .decade =  -6; },
  { .code = "µ";     .decade =  -6; },
  { .code = "nano";  .decade =  -9; },  { .code = "n";  .decade =  -9; },
  { .code = "pico";  .decade = -12; },  { .code = "p";  .decade = -12; },
  { .code = "femto"; .decade = -15; },  { .code = "f";  .decade = -15; },
  { .code = "atto";  .decade = -18; },  { .code = "a";  .decade = -18; },
  { .code = "zepto"; .decade = -21; },  { .code = "z";  .decade = -21; },
  { .code = "yocto"; .decade = -24; },  { .code = "y";  .decade = -24; },
];

.mapped = [
  # ── SI base ──────────────────────────────────────────────────────────────
  { .code = "m";        .bovnar = "m";   .metric = true;  },
  { .code = "meter";    .bovnar = "m";   .metric = true;  },
  { .code = "metre";    .bovnar = "m";   .metric = true;  },
  { .code = "s";        .bovnar = "s";   .metric = true;  },
  { .code = "sec";      .bovnar = "s";   .metric = true;  },
  { .code = "second";   .bovnar = "s";   .metric = true;  },
  { .code = "g";        .bovnar = "g";   .metric = true;  },
  { .code = "gram";     .bovnar = "g";   .metric = true;  },
  { .code = "gramme";   .bovnar = "g";   .metric = true;  },
  { .code = "A";        .bovnar = "A";   .metric = true;  },
  { .code = "ampere";   .bovnar = "A";   .metric = true;  },
  { .code = "amp";      .bovnar = "A";   .metric = true;  },
  { .code = "K";        .bovnar = "K";   .metric = true;  },
  { .code = "kelvin";   .bovnar = "K";   .metric = true;  },
  { .code = "mol";      .bovnar = "mol"; .metric = true;  },
  { .code = "mole";     .bovnar = "mol"; .metric = true;  },
  { .code = "cd";       .bovnar = "cd";  .metric = true;  },
  { .code = "candela";  .bovnar = "cd";  .metric = true;  },

  # ── Named SI-derived ─────────────────────────────────────────────────────
  { .code = "Hz";       .bovnar = "Hz";  .metric = true;  },
  { .code = "hertz";    .bovnar = "Hz";  .metric = true;  },
  { .code = "N";        .bovnar = "N";   .metric = true;  },
  { .code = "newton";   .bovnar = "N";   .metric = true;  },
  { .code = "Pa";       .bovnar = "Pa";  .metric = true;  },
  { .code = "pascal";   .bovnar = "Pa";  .metric = true;  },
  { .code = "J";        .bovnar = "J";   .metric = true;  },
  { .code = "joule";    .bovnar = "J";   .metric = true;  },
  { .code = "W";        .bovnar = "W";   .metric = true;  },
  { .code = "watt";     .bovnar = "W";   .metric = true;  },
  { .code = "V";        .bovnar = "V";   .metric = true;  },
  { .code = "volt";     .bovnar = "V";   .metric = true;  },
  { .code = "ohm";      .bovnar = "Ω";   .metric = true;  },
  { .code = "F";        .bovnar = "F";   .metric = true;  },
  { .code = "farad";    .bovnar = "F";   .metric = true;  },
  { .code = "C";        .bovnar = "C";   .metric = true;  },
  { .code = "coulomb";  .bovnar = "C";   .metric = true;  },
  { .code = "S";        .bovnar = "S";   .metric = true;  },
  { .code = "siemens";  .bovnar = "S";   .metric = true;  },
  { .code = "Wb";       .bovnar = "Wb";  .metric = true;  },
  { .code = "weber";    .bovnar = "Wb";  .metric = true;  },
  { .code = "T";        .bovnar = "T";   .metric = true;  },
  { .code = "tesla";    .bovnar = "T";   .metric = true;  },
  { .code = "H";        .bovnar = "H";   .metric = true;  },
  { .code = "henry";    .bovnar = "H";   .metric = true;  },
  { .code = "lm";       .bovnar = "lm";  .metric = true;  },
  { .code = "lumen";    .bovnar = "lm";  .metric = true;  },
  { .code = "lx";       .bovnar = "lx";  .metric = true;  },
  { .code = "lux";      .bovnar = "lx";  .metric = true;  },
  { .code = "Bq";       .bovnar = "Bq";  .metric = true;  },
  { .code = "becquerel"; .bovnar = "Bq"; .metric = true;  },
  { .code = "Gy";       .bovnar = "Gy";  .metric = true;  },
  { .code = "gray";     .bovnar = "Gy";  .metric = true;  },
  { .code = "Sv";       .bovnar = "Sv";  .metric = true;  },
  { .code = "sievert";  .bovnar = "Sv";  .metric = true;  },
  { .code = "kat";      .bovnar = "kat"; .metric = true;  },
  { .code = "katal";    .bovnar = "kat"; .metric = true;  },
  { .code = "rad";      .bovnar = "rad"; .metric = true;  },
