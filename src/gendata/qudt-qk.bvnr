#!bovnar 1.1
# qudt-qk.bvnr — single source of truth for the QUDT quantity-kind profile.
#
# ═══════════════════════════════════════════════════════════════════════════
# READ THIS FIRST: A QUANTITY KIND IS NOT A UNIT
# ═══════════════════════════════════════════════════════════════════════════
#
# Every other profile in src/gendata/ spells a UNIT. This one spells a KIND OF
# QUANTITY -- QUDT's Length, Mass, Velocity, Pressure -- which says what is being
# measured and says NOTHING about the scale it is measured on. "Length" does not
# mean metres. It does not mean anything with a number attached to it at all.
#
# So this profile has to decide what "qudt-qk:Length" means in a slot whose whole
# job is to fix the scale, and there are only three honest answers:
#
#   (a) Refuse it. Correct, and useless: it makes the namespace an error message.
#
#   (b) Carry the dimension WITHOUT a scale. Not representable: a value_unit_t is
#       a product of prefixed base units, and there is no way to spell "a length,
#       scale unspecified" in one. Adding a fourth state to the unit model would
#       break the invariant every other part of the library is built on
#       (doc/11 section 1.3), which is the one thing that must not change.
#
#   (c) TRANSLATE TO THE COHERENT SI UNIT OF THE KIND. Length -> m, Mass -> k~g,
#       Velocity -> m/s. This is what the profile does.
#
# WHY (c) IS DEFENSIBLE, AND WHERE IT CAN STILL BITE
#   It is not this file guessing. QUDT itself relates a QuantityKind to exactly
#   one coherent SI unit, and ISO 80000 defines a kind of quantity together with
#   the coherent unit of the system it belongs to. Writing
#   "<float:64,qudt-qk:Length> 3.0" therefore means three metres, because the
#   coherent SI unit of length IS the metre, not because this table picked one.
#
#   The bite: a producer who knows only the KIND and whose numbers are NOT in
#   coherent SI units will write a wrong value that parses cleanly. If your
#   lengths are in feet, "qudt-qk:Length" is the wrong thing to write and
#   "qudt:FT" is the right one. This namespace is for a producer whose data is
#   already coherent-SI and whose metadata carries a kind rather than a unit --
#   which is the common shape of a QUDT-sourced or DTDL-sourced feed, and is the
#   only reason the namespace exists.
#
#   A kind whose coherent unit bovnar cannot spell is REFUSED, not approximated.
#
# HOW THIS WORKS
#   Hand-edited; gen_profiles.py regenerates the C tables. A FLAT profile: a kind
#   name is one whole token. Local names only, no full IRIs -- see qudt.bvnr.
#
# PROVENANCE
#   Same standing gap as every other profile here: nothing in this repository
#   checks the QUDT side. See the note in qudt.bvnr.
#
# SOURCE, VERSION AND LICENSING
#   Vocabulary  QUDT 3.1.0 quantity kinds
#               (owl:versionIRI http://qudt.org/3.1.0/vocab/quantitykind)
#   Retrieved   2026-07-30 from https://qudt.org/3.1.0/vocab/quantitykind, with
#               the coherent unit of each kind taken from QUDT's own
#               applicableUnit list in https://qudt.org/3.1.0/vocab/unit
#   Publisher   QUDT.org
#   Licence     Creative Commons Attribution 4.0 International (CC BY 4.0),
#               https://creativecommons.org/licenses/by/4.0/ -- attribution is
#               made to QUDT.org, which does not endorse this project
#   Taken       quantity-kind local names. No QUDT label, description or
#               annotation is reproduced anywhere in this repository
#   Modified    yes -- a subset, each kind mapped to its coherent SI unit in
#               bovnar's native registry
#
#   The attribution CC BY 4.0 requires lives in THIRD_PARTY_NOTICES.md, in full.

.schema_version = <uint:16> 1;

# .bovnar is the COHERENT SI UNIT of the kind, never a convenient one.
.mapped = [
  # ── ISO 80000 base quantities ────────────────────────────────────────────
  { .code = "Length";                  .bovnar = "m";        },
  { .code = "Mass";                    .bovnar = "k~g";      },
  { .code = "Time";                    .bovnar = "s";        },
  { .code = "ElectricCurrent";         .bovnar = "A";        },
  { .code = "ThermodynamicTemperature"; .bovnar = "K";       },
  { .code = "AmountOfSubstance";       .bovnar = "mol";      },
  { .code = "LuminousIntensity";       .bovnar = "cd";       },

  # ── Space and time ───────────────────────────────────────────────────────
  { .code = "Area";                    .bovnar = "m^2";      },
  { .code = "Volume";                  .bovnar = "m^3";      },
  { .code = "Angle";                   .bovnar = "rad";      },
  { .code = "PlaneAngle";              .bovnar = "rad";      },
  { .code = "SolidAngle";              .bovnar = "sr";       },
  { .code = "Velocity";                .bovnar = "m/s";      },
  { .code = "Speed";                   .bovnar = "m/s";      },
  { .code = "Acceleration";            .bovnar = "m/s^2";    },
  { .code = "AngularVelocity";         .bovnar = "rad/s";    },
  { .code = "Frequency";               .bovnar = "Hz";       },
  { .code = "VolumeFlowRate";          .bovnar = "m^3/s";    },
  { .code = "MassFlowRate";            .bovnar = "k~g/s";    },

  # ── Mechanics ────────────────────────────────────────────────────────────
  { .code = "Force";                   .bovnar = "N";        },
  { .code = "Weight";                  .bovnar = "N";        },
  { .code = "Pressure";                .bovnar = "Pa";       },
  { .code = "Stress";                  .bovnar = "Pa";       },
  { .code = "Energy";                  .bovnar = "J";        },
  { .code = "Work";                    .bovnar = "J";        },
  { .code = "Power";                   .bovnar = "W";        },
  { .code = "Torque";                  .bovnar = "N·m";      },
  { .code = "Density";                 .bovnar = "k~g/m^3";  },
  { .code = "MassDensity";             .bovnar = "k~g/m^3";  },
  { .code = "Momentum";                .bovnar = "k~g·m/s";  },
  { .code = "DynamicViscosity";        .bovnar = "Pa·s";     },
  { .code = "KinematicViscosity";      .bovnar = "m^2/s";    },

  # ── Electricity and magnetism ────────────────────────────────────────────
  { .code = "ElectricCharge";          .bovnar = "C";        },
  { .code = "Voltage";                 .bovnar = "V";        },
  { .code = "ElectricPotential";       .bovnar = "V";        },
  { .code = "Resistance";              .bovnar = "Ω";        },
  { .code = "ElectricalResistance";     .bovnar = "Ω";        },   # not ElectricResistance
  { .code = "Capacitance";             .bovnar = "F";        },
  { .code = "Inductance";              .bovnar = "H";        },
  { .code = "Conductance";             .bovnar = "S";        },
  { .code = "MagneticFlux";            .bovnar = "Wb";       },
  { .code = "MagneticFluxDensity";     .bovnar = "T";        },

  # ── Light, radiation, chemistry ──────────────────────────────────────────
  { .code = "LuminousFlux";            .bovnar = "lm";       },
  { .code = "Illuminance";             .bovnar = "lx";       },
  { .code = "Activity";                .bovnar = "Bq";       },
  { .code = "AbsorbedDose";            .bovnar = "Gy";       },
  { .code = "DoseEquivalent";          .bovnar = "Sv";       },
  { .code = "CatalyticActivity";       .bovnar = "kat";      },
  { .code = "AmountOfSubstanceConcentration"; .bovnar = "mol/m^3"; },

  # ── Thermodynamics ───────────────────────────────────────────────────────
  { .code = "HeatCapacity";            .bovnar = "J/K";      },
  # Explicit negative exponents, not "J/k~g·K^-1". The native '/' LATCHES for the
  # rest of the expression (unit-system doc section 5.4), so that spelling would
  # invert the K^-1 back to K^+1 and give J·kg⁻¹·K, which is not a specific heat
  # capacity at all -- and would still have parsed cleanly.
  { .code = "SpecificHeatCapacity";    .bovnar = "J·k~g^-1·K^-1"; },
  { .code = "ThermalConductivity";     .bovnar = "W·m^-1·K^-1";   },

  # ── Closing the table against QUDT quantity kinds ─────────────────────
  #
  # Every row below was produced by carrying QUDT's OWN cross-reference over to
  # native, not by matching numbers: QUDT publishes a `qudt:ucumCode` (and a
  # `qudt:udunitsCode`) for most of what it defines, and this repository has
  # already proved its UCUM table against ucum-essence.xml. So a row here is a
  # row there, read twice -- which is both why the spelling is one a reader can
  # check and why §14's cross-vocabulary suite cannot find these two tables
  # disagreeing. A value match could not have done it: it cannot tell a sievert
  # from a gray.
  #
  # Where no cross-reference resolved, a value match was allowed only for a code
  # with a NON-ZERO dimension vector. Every dimensionless native unit shares one
  # dimension vector, so "worth 1 and dimensionless" matches the bit, the
  # radian and every ratio alike; those codes are refused below instead.
  #
  # .reverse = false throughout: these rows are here to be READ, and none of
  # them should change what bovnar writes.
  { .code = "AbsoluteActivity";              .bovnar = "Bq·s/m^3";            .reverse = false; },
  { .code = "AbsoluteHumidity";              .bovnar = "g/d~m^3";             .reverse = false; },
  { .code = "AbsoluteTypographicMeasurement"; .bovnar = "m";                   .reverse = false; },
  { .code = "AbsorbedDoseRate";              .bovnar = "Gy/s";                .reverse = false; },
  { .code = "AccelerationOfGravity";         .bovnar = "m/s^2";               .reverse = false; },
  { .code = "AcceptorDensity";               .bovnar = "m^-3";                .reverse = false; },
  { .code = "AcceptorIonizationEnergy";      .bovnar = "J";                   .reverse = false; },
  { .code = "AcousticImpedance";             .bovnar = "Pa·s/m";              .reverse = false; },
  { .code = "Action";                        .bovnar = "J·s";                 .reverse = false; },
  { .code = "ActionTime";                    .bovnar = "H/Ω";                 .reverse = false; },
  { .code = "ActiveEnergy";                  .bovnar = "J";                   .reverse = false; },
  { .code = "ActivePower";                   .bovnar = "W";                   .reverse = false; },
  { .code = "ActivityConcentration";         .bovnar = "Bq/m^3";              .reverse = false; },
  { .code = "ActivityRelatedByMass";         .bovnar = "Bq/k~g";              .reverse = false; },
  { .code = "ActivityThresholds";            .bovnar = "Gy";                  .reverse = false; },
  { .code = "Adaptation";                    .bovnar = "H/Ω";                 .reverse = false; },
  { .code = "Admittance";                    .bovnar = "S";                   .reverse = false; },
  { .code = "AlphaDisintegrationEnergy";     .bovnar = "J";                   .reverse = false; },
  { .code = "Altitude";                      .bovnar = "m";                   .reverse = false; },
  { .code = "AmbientPressure";               .bovnar = "k~g/m·s^2";           .reverse = false; },
  { .code = "AmountOfSubstanceIonConcentration"; .bovnar = "mol/m^3";             .reverse = false; },
  { .code = "AmountOfSubstancePerMass";      .bovnar = "mol/k~g";             .reverse = false; },
  { .code = "AmountOfSubstancePerMassPressure"; .bovnar = "mol/k~g·Pa";          .reverse = false; },
  { .code = "AmountOfSubstancePerVolume";    .bovnar = "mol/m^3";             .reverse = false; },
  { .code = "AngleOfAttack";                 .bovnar = "rad";                 .reverse = false; },
  { .code = "AngleOfOpticalRotation";        .bovnar = "rad";                 .reverse = false; },
  { .code = "AngularAcceleration";           .bovnar = "rad/s^2";             .reverse = false; },
  { .code = "AngularCrossSection";           .bovnar = "m^2/sr";              .reverse = false; },
  { .code = "AngularDistance";               .bovnar = "rad";                 .reverse = false; },
  { .code = "AngularFrequency";              .bovnar = "rad/s";               .reverse = false; },
  { .code = "AngularImpulse";                .bovnar = "J·s";                 .reverse = false; },
  { .code = "AngularMomentum";               .bovnar = "J·s";                 .reverse = false; },
  { .code = "AngularMomentumPerAngle";       .bovnar = "N·m·s/rad";           .reverse = false; },
  { .code = "AngularReciprocalLatticeVector"; .bovnar = "m^-1";                .reverse = false; },
  { .code = "AngularWavenumber";             .bovnar = "rad/m";               .reverse = false; },
  { .code = "ApogeeRadius";                  .bovnar = "m";                   .reverse = false; },
  { .code = "ApparentPower";                 .bovnar = "V·A";                 .reverse = false; },
  { .code = "AreaAngle";                     .bovnar = "m^2·sr";              .reverse = false; },
  { .code = "AreaChargeDensity";             .bovnar = "C/m^2";               .reverse = false; },
  { .code = "AreaMass";                      .bovnar = "k~g/m^2";             .reverse = false; },
  { .code = "AreaPerLength";                 .bovnar = "m^2/m";               .reverse = false; },
  { .code = "AreaPerPower";                  .bovnar = "m^2/W";               .reverse = false; },
  { .code = "AreaPerTime";                   .bovnar = "m^2·Hz";              .reverse = false; },
  { .code = "AreaRatio";                     .bovnar = "m^2/m^2";             .reverse = false; },
  { .code = "AreaTemperature";               .bovnar = "m^2·K";               .reverse = false; },
  { .code = "AreaThermalExpansion";          .bovnar = "m^2/K";               .reverse = false; },
  { .code = "AreaTime";                      .bovnar = "m^2·s";               .reverse = false; },
  { .code = "AreaTimeTemperature";           .bovnar = "m^2·s·K";             .reverse = false; },
  { .code = "AreicChargeDensityOrElectricFluxDensityOrElectricPolarization"; .bovnar = "s·A/m^2";             .reverse = false; },
  { .code = "AreicEnergyFlow";               .bovnar = "m·Pa/s";              .reverse = false; },
  { .code = "AreicHeatFlowRate";             .bovnar = "m·Pa/s";              .reverse = false; },
  { .code = "AreicMass";                     .bovnar = "k~g/m^2";             .reverse = false; },
  { .code = "AreicTorque";                   .bovnar = "k~g/s^2";             .reverse = false; },
  { .code = "AtmosphericHydroxylationRate";  .bovnar = "m^3/mol·s";           .reverse = false; },
  { .code = "AtmosphericPressure";           .bovnar = "k~g/m·s^2";           .reverse = false; },
  { .code = "AtomicAttenuationCoefficient";  .bovnar = "m^2";                 .reverse = false; },
  { .code = "AtomicCharge";                  .bovnar = "A·s";                 .reverse = false; },
  { .code = "AtomicEnergy";                  .bovnar = "J";                   .reverse = false; },
  { .code = "AtomicMass";                    .bovnar = "k~g";                 .reverse = false; },
  { .code = "AtomicStoppingPower";           .bovnar = "m^4·k~g/s^2";         .reverse = false; },
  { .code = "AttenuationCoefficient";        .bovnar = "m^-1";                .reverse = false; },
  { .code = "AuxillaryMagneticField";        .bovnar = "A/m";                 .reverse = false; },
  { .code = "AverageEnergyLossPerElementaryChargeProduced"; .bovnar = "J";                   .reverse = false; },
  { .code = "AverageHeadEndPressure";        .bovnar = "k~g/m·s^2";           .reverse = false; },
  { .code = "AverageSpecificImpulse";        .bovnar = "s";                   .reverse = false; },
  { .code = "AverageVacuumThrust";           .bovnar = "k~g·m/s^2";           .reverse = false; },
  { .code = "Azimuth";                       .bovnar = "rad";                 .reverse = false; },
  { .code = "BandwidthDistanceProduct";      .bovnar = "m/s";                 .reverse = false; },
  { .code = "BandwidthLengthProduct";        .bovnar = "m/s";                 .reverse = false; },
  { .code = "BatteryCapacity";               .bovnar = "C";                   .reverse = false; },
  { .code = "BendingMomentOfForce";          .bovnar = "N·m";                 .reverse = false; },
  { .code = "BetaDisintegrationEnergy";      .bovnar = "J";                   .reverse = false; },
  { .code = "BevelGearPitchAngle";           .bovnar = "rad";                 .reverse = false; },
  { .code = "BiodegredationHalfLife";        .bovnar = "s";                   .reverse = false; },
  { .code = "BiogeochemicalRate";            .bovnar = "mol/k~g·s";           .reverse = false; },
  # AN INFORMATION RATE IS NOT A FREQUENCY, and six rows in this file used to
  # say it was. The dimension vector cannot tell them apart -- both are T⁻¹ --
  # so the derivation that filled this table took the coherent unit of that
  # dimension, which is the hertz, and a QUDT `BitRate` came out of the parser
  # as a frequency. The library's own kind table (bvni_kind_table in
  # bovnar_si_units.c) calls b/s and Hz incompatible for exactly this reason, so
  # the translated unit was one bovnar itself would refuse to convert into the
  # thing it meant. ByteRate and ByteTransmissionRate below carry the fix;
  # BitRate, BitTransmissionRate and DataRate are dealt with where they appear.
  { .code = "BloodGlucoseLevel";             .bovnar = "m~mol/L";             .reverse = false; },
  { .code = "BloodGlucoseLevel_Mass";        .bovnar = "m~g/c~m^3";           .reverse = false; },
  { .code = "BodyMassIndex";                 .bovnar = "k~g/m^2";             .reverse = false; },
  { .code = "BoilingPoint";                  .bovnar = "K";                   .reverse = false; },
  { .code = "BraggAngle";                    .bovnar = "rad";                 .reverse = false; },
  { .code = "Breadth";                       .bovnar = "m";                   .reverse = false; },
  { .code = "BulkModulus";                   .bovnar = "Pa";                  .reverse = false; },
  { .code = "BurgersVector";                 .bovnar = "m";                   .reverse = false; },
  { .code = "BurnRate";                      .bovnar = "m/s";                 .reverse = false; },
  { .code = "BurnTime";                      .bovnar = "H/Ω";                 .reverse = false; },
  { .code = "BurstFactor";                   .bovnar = "Pa·m^2/k~g";          .reverse = false; },
  { .code = "ByteRate";                      .bovnar = "B/s";                 .reverse = false; },
  { .code = "ByteTransmissionRate";          .bovnar = "B/s";                 .reverse = false; },
  { .code = "CENTER-OF-GRAVITY_X";           .bovnar = "m";                   .reverse = false; },
  { .code = "CENTER-OF-GRAVITY_Y";           .bovnar = "m";                   .reverse = false; },
  { .code = "CENTER-OF-GRAVITY_Z";           .bovnar = "m";                   .reverse = false; },
  { .code = "CENTER-OF-MASS";                .bovnar = "m";                   .reverse = false; },
  { .code = "CO2Equivalent";                 .bovnar = "k~g";                 .reverse = false; },
  { .code = "CONTRACT-END-ITEM-SPECIFICATION-MASS"; .bovnar = "k~g";                 .reverse = false; },
  { .code = "CONTROL-MASS";                  .bovnar = "k~g";                 .reverse = false; },
  { .code = "CarrierLifetime";               .bovnar = "H/Ω";                 .reverse = false; },
  { .code = "CartesianArea";                 .bovnar = "m^2";                 .reverse = false; },
  { .code = "CartesianCoordinates";          .bovnar = "m";                   .reverse = false; },
  { .code = "CartesianVolume";               .bovnar = "k~L";                 },
  { .code = "CatalyticActivityConcentration"; .bovnar = "kat/m^3";             .reverse = false; },
  { .code = "CenterOfGravity_X";             .bovnar = "m";                   .reverse = false; },
  { .code = "CenterOfGravity_Y";             .bovnar = "m";                   .reverse = false; },
  { .code = "CenterOfGravity_Z";             .bovnar = "m";                   .reverse = false; },
  { .code = "CharacteristicAcousticImpedance"; .bovnar = "Pa·s/m";              .reverse = false; },
  { .code = "CharacteristicVelocity";        .bovnar = "m/s";                 .reverse = false; },
  { .code = "ChemicalAffinity";              .bovnar = "J/mol";               .reverse = false; },
  { .code = "ChemicalConsumptionPerMass";    .bovnar = "m^3/k~g";             .reverse = false; },
  { .code = "ChemicalPotential";             .bovnar = "J/mol";               .reverse = false; },
  { .code = "Circulation";                   .bovnar = "m^2·Hz";              .reverse = false; },
  { .code = "ClosestApproachRadius";         .bovnar = "m";                   .reverse = false; },
  { .code = "CoefficientOfHeatTransfer";     .bovnar = "k~g/s^3·K";           .reverse = false; },
  { .code = "Coercivity";                    .bovnar = "A/m";                 .reverse = false; },
  { .code = "CoherenceLength";               .bovnar = "m";                   .reverse = false; },
  { .code = "ColdReceptorThreshold";         .bovnar = "K";                   .reverse = false; },
  { .code = "CombinedNonEvaporativeHeatTransferCoefficient"; .bovnar = "W/m^2·K";             .reverse = false; },
  { .code = "CombustionChamberTemperature";  .bovnar = "K";                   .reverse = false; },
  { .code = "ComplexFrequency_Real";         .bovnar = "Hz";                  .reverse = false; },
  { .code = "ComplexPower";                  .bovnar = "V·A";                 .reverse = false; },
  { .code = "CompoundPlaneAngle";            .bovnar = "rad";                 .reverse = false; },
  { .code = "Compressibility";               .bovnar = "m^2/N";               .reverse = false; },
  { .code = "Concentration";                 .bovnar = "mol/m^3";             .reverse = false; },
  { .code = "ConductionSpeed";               .bovnar = "m/s";                 .reverse = false; },
  { .code = "ConductiveHeatTransferRate";    .bovnar = "W";                   .reverse = false; },
  { .code = "Conductivity";                  .bovnar = "S/m";                 .reverse = false; },
  { .code = "ConductivityVariance_NEON";     .bovnar = "s^6·A^4/m^6·k~g^2";   .reverse = false; },
  { .code = "ConvectiveHeatTransfer";        .bovnar = "W";                   .reverse = false; },
  { .code = "CorrelatedColorTemperature";    .bovnar = "K";                   .reverse = false; },
  { .code = "CostPerEnergy";                 .bovnar = "s^2/m^2·k~g";         .reverse = false; },
  { .code = "CostPerPower";                  .bovnar = "s^3/m^2·k~g";         .reverse = false; },
  { .code = "CountRate";                     .bovnar = "s^-1";                .reverse = false; },
  { .code = "CrossSection";                  .bovnar = "m^2";                 .reverse = false; },
  { .code = "CrossSectionalArea";            .bovnar = "m^2";                 .reverse = false; },
  { .code = "CubicExpansionCoefficient";     .bovnar = "K^-1";                .reverse = false; },
  { .code = "CurieTemperature";              .bovnar = "K";                   .reverse = false; },
  { .code = "CurrentLinkage";                .bovnar = "A";                   .reverse = false; },
  { .code = "CurrentOfTheAmountOfSubstance"; .bovnar = "kat";                 .reverse = false; },
  { .code = "Curvature";                     .bovnar = "m^-1";                .reverse = false; },
  { .code = "CurvatureFromRadius";           .bovnar = "m^-1";                .reverse = false; },
  { .code = "CyclotronAngularFrequency";     .bovnar = "rad/s";               .reverse = false; },
  { .code = "DELTA-V";                       .bovnar = "m/s";                 .reverse = false; },
  { .code = "DRY-MASS";                      .bovnar = "k~g";                 .reverse = false; },
  # A data rate is a bit rate: every one of QUDT's eight applicable units
  # here is a bit or byte per second. It was Hz — see the note beside BitRate.
  { .code = "DataRate";                      .bovnar = "b/s";                 .reverse = false; },
  { .code = "DebyeAngularFrequency";         .bovnar = "rad/s";               .reverse = false; },
  { .code = "DebyeAngularWavenumber";        .bovnar = "rad/m";               .reverse = false; },
  { .code = "DebyeTemperature";              .bovnar = "K";                   .reverse = false; },
  { .code = "DecayConstant";                 .bovnar = "s^-1";                .reverse = false; },
  { .code = "DensityInCombustionChamber";    .bovnar = "g/d~m^3";             .reverse = false; },
  { .code = "DensityOfStates";               .bovnar = "s/rad·m^3";           .reverse = false; },
  { .code = "DensityOfTheExhaustGases";      .bovnar = "g/d~m^3";             .reverse = false; },
  { .code = "Depth";                         .bovnar = "m";                   .reverse = false; },
  { .code = "DewPointTemperature";           .bovnar = "K";                   .reverse = false; },
