.opaque = [];

.unsupported = [
  # Dimensionless kinds. Bovnar spells "no unit" by omitting the unit, and
  # mapping these onto the unity would let a ratio compare equal to a count.
  { .code = "Dimensionless";      .why = "no unit at all — omit the unit slot"; },
  { .code = "DimensionlessRatio"; .why = "no unit at all — omit the unit slot, or write % if it is a percentage"; },
  { .code = "Count";              .why = "a bare count — omit the unit slot"; },

  # Kinds whose coherent unit bovnar cannot spell, refused rather than
  # approximated. Refusing costs an error message; approximating costs a number.
  { .code = "CelsiusTemperature"; .why = "an affine scale, not a coherent unit — write °C, or K for the thermodynamic kind"; },
  { .code = "LogarithmicRatio";   .why = "no coherent unit — dB and Np carry no reference level"; },
  { .code = "Currency";           .why = "not a physical kind — write an ISO 4217 unit with the $ sigil"; },
  { .code = "InformationEntropy"; .why = "QUDT's coherent unit here is the bit, which bovnar treats as a unit of information rather than of entropy"; },
  # The three below are the same refusal one step along: an information RATE
  # whose logarithmic base is not settled, or is settled on a base bovnar has no
  # unit for. Each was mapped to Hz or s⁻¹ before, which is a coherent unit of
  # the right dimension and the wrong quantity — see the note beside BitRate.
  # QUDT names the BIT and then gives the kind one applicable unit, the OCTET
  # per second — a BYTE rate. bovnar carries bit and byte as separate kinds
  # with no factor between them, so the vocabulary itself does not say which of
  # two incommensurable units this kind means. It used to say Hz, which is
  # neither. Write qudt:BIT-PER-SEC or qudt:BYTE-PER-SEC and there is no doubt.
  { .code = "BitRate"; .why = "QUDT names the bit and lists only the octet per second as the applicable unit, so the kind does not settle whether it is b/s or B/s — two units bovnar holds incommensurable"; },
  { .code = "BitTransmissionRate"; .why = "the same ambiguity as BitRate: QUDT names the bit and states the octet per second"; },
  # QUDT pools the hertz and the revolution per second into one kind. bovnar
  # does not: a revolution is an ANGLE of 2π radians and a hertz is a count per
  # second, and the two differ by exactly that 2π (see the note on C94/M46 in
  # unece.bvnr). So these two kinds name a frequency and an angular rate at
  # once, and no single coherent unit answers for both. Write qudt-qk:Frequency
  # for the count and qudt-qk:AngularVelocity for the angle.
  { .code = "RotationalFrequency"; .why = "QUDT's applicable units mix the hertz with the revolution per second, which bovnar holds to be a frequency and an angular rate — different quantities, 2π apart"; },
  { .code = "RotationalVelocity"; .why = "the same pooling as RotationalFrequency: a hertz and a revolution per second are not one quantity here"; },
  { .code = "InformationFlowRate"; .why = "QUDT gives this kind three applicable units in three logarithmic bases — hartley, nat and shannon per second — and only the shannon is bovnar's bit, so the kind names no single coherent unit"; },
  { .code = "LogarithmicMedianInformationFlow_SourceToBase10"; .why = "a hartley per second; bovnar has no unit for the base-10 information content"; },
  { .code = "LogarithmicMedianInformationFlow_SourceToBaseE"; .why = "a nat per second; bovnar has no unit for the base-e information content"; },

  # ── Closing the table against QUDT quantity kinds ─────────────────────
  #
  # The other half. Each of these is a local name QUDT defines that this build
  # cannot carry, so it now fails as error_unit_profile_unsupported with a
  # reason instead of as error_unit_illegal -- which claimed QUDT does not
  # define it. The reason states which of the four things went wrong: QUDT
  # publishes no multiplier, the unit is affine, its multiplier is not a decade
  # off any native unit of that dimension, or it is dimensionless and nothing
  # here can say which ratio it is.
  { .code = "Absorptance";                 .why = "a dimensionless QUDT unit — every native ratio has the same dimension vector, so nothing here can tell which one it is; QUDT states no ucumCode or udunitsCode to settle it"; },
