# integers.bvnr — demonstrates every integer feature in BVNR
#
# Type families:  uint (unsigned), sint (signed)
# Type params:    :width   — bit width (any positive integer; 0 = default 64)
#                 :_base   — numeric base (2–62, 64, 85)
#                 :unit    — physical unit (SI / IEC / compound)
# Default synth:  plain positive integer  → <uint:64,_10,no_unit>
#                 plain negative integer  → <sint:64,_10,no_unit>


# ── 1. Untyped integers (default type synthesis) ──────────────────────────────

.plain_uint = 42;               # synthesised as <uint:64,_10,no_unit>
.plain_sint = -100;             # synthesised as <sint:64,_10,no_unit>
.leading_zeros = 007;           # leading zeros are legal; value is 7
.trailing_dot = 123.;           # trailing dot without fraction → still integer-ish float class
                                # but bare 123 is cleaner for integer intent


# ── 2. Explicit unsigned integers — all standard widths ──────────────────────

.uint8  = <uint:8>  255;        # max value for 8-bit unsigned
.uint16 = <uint:16> 65535;      # max value for 16-bit unsigned
.uint32 = <uint:32> 4294967295; # max value for 32-bit unsigned
.uint64 = <uint:64> 18446744073709551615;   # max value for 64-bit unsigned

.uint8_min  = <uint:8>  0;      # min value is always 0 for unsigned
.uint16_min = <uint:16> 0;
.uint32_min = <uint:32> 0;
.uint64_min = <uint:64> 0;


# ── 3. Explicit signed integers — all standard widths ────────────────────────

.sint8_max  = <sint:8>   127;
.sint16_max = <sint:16>  32767;
.sint32_max = <sint:32>  2147483647;
.sint64_max = <sint:64>  9223372036854775807;

.sint8_min  = <sint:8>  -128;
.sint16_min = <sint:16> -32768;
.sint32_min = <sint:32> -2147483648;
.sint64_min = <sint:64> -9223372036854775808;


# ── 4. Width = 0 (explicit default width → effective width 64) ───────────────

.uint_default_width = <uint:0>  42;     # width 0 → 64-bit unsigned
.sint_default_width = <sint:0> -42;     # width 0 → 64-bit signed


# ── 5. Non-standard widths (any positive integer is accepted) ─────────────────

.uint12 = <uint:12>  4095;      # 12-bit unsigned, e.g. for ADC samples
.uint24 = <uint:24>  16777215;  # 24-bit unsigned, e.g. for 24-bit audio
.uint128 = <uint:128> 340282366920938463463374607431768211455;


# ── 6. Numeric bases (uint) ───────────────────────────────────────────────────
# Non-decimal literals must be quoted strings.
# A bare non-decimal token (e.g. ff) is parsed as a symbol, not a number.

.hex_nibble  = <uint:4,_16>   "F";            # hex: 15
.hex_byte    = <uint:8,_16>   "FF";           # hex: 255
.hex_word    = <uint:16,_16>  "DEAD";         # hex: 57005
.hex_dword   = <uint:32,_16>  "CAFEBABE";     # hex: 3405691582
.hex_qword   = <uint:64,_16>  "DEADBEEF""CAFEBABE"; # string concat; 64-bit hex

.oct_perm    = <uint:12,_8>   644;            # octal: Unix file permission rw-r--r--
.oct_mode    = <uint:16,_8>   755;            # octal: Unix file permission rwxr-xr-x
                                              # bare octal digits are valid (no 8 or 9)

.bin_byte    = <uint:8,_2>    01010110;       # binary: 86 decimal (bare binary literal)
.bin_mask    = <uint:16,_2>   1111111111111111; # binary: 65535
.bin_str     = <uint:8,_2>    "11010110";     # same as bare but quoted

.base36      = <uint:64,_36>  "ZZZZZZZZZZZZ";  # base-36 alphanumeric
.base62      = <uint:64,_62>  "ZzZzZZZZ";      # base-62: 0-9 A-Z a-z
.base64      = <uint:64,_64>  "Z";             # base-64
.base85      = <uint:64,_85>  "#";             # base-85 (Ascii85 alphabet)


# ── 7. Numeric bases (sint, signed) ──────────────────────────────────────────

.sint_hex    = <sint:32,_16>  "-7FFFFFFF";    # negative hex value (quoted, minus prefix)
.sint_bin    = <sint:8,_2>    "-10000000";    # binary -128 (magnitude 10000000₂ with minus prefix)


# ── 8. Parameter order independence ──────────────────────────────────────────
# Width, base, and unit may appear in any order inside <…>.
# All four lines below are semantically identical.

.perm_a = <uint:32,_8,no_unit>  755;
.perm_b = <uint:_8,no_unit,32>  755;
.perm_c = <uint:no_unit,_8,32>  755;
.perm_d = <uint:no_unit,32,_8>  755;


# ── 9. Integers with SI / IEC units ──────────────────────────────────────────

.timeout_s    = <uint:32,s>       3600;       # 3600 seconds (1 hour)
.timeout_ms   = <uint:32,m~s>     3600000;    # 3 600 000 milliseconds
.distance_m   = <uint:64,m>       384400000;  # Earth–Moon distance in meters
.file_size    = <uint:64,Ki~B>    1024;       # 1024 kibibytes = 1 MiB
.ram_size     = <uint:64,Mi~B>    4096;       # 4096 MiB = 4 GiB
.bitrate      = <uint:32,k~b>     9600;       # 9600 kilobits (UART speed)
.frequency_hz = <uint:32,Hz>      48000;      # 48 kHz sample rate
.temperature  = <sint:16,°C>      -40;        # minus 40 degrees Celsius
.pressure_pa  = <uint:32,Pa>      101325;     # standard atmosphere in pascals


# ── 10. Inline unit suffix (scalar only, forbidden inside arrays) ─────────────

.baud = 115200 b;               # inline unit: bits — no type annotation needed
.heap = 65536 B;                # inline unit: bytes
.uptime = 86400 s;              # inline unit: seconds
.voltage = 3300 m~V;            # inline unit: millivolts (3.3 V)


# ── 11. Null integer values ───────────────────────────────────────────────────

.null_plain  = ;                # null with no type
.null_uint32 = <uint:32> ;      # null with explicit uint:32 type
.null_sint64 = <sint:64> ;      # null with explicit sint:64 type


# ── 12. Arbitrary bit-width integers ─────────────────────────────────────────
# Any positive integer width is accepted. The C API functions
# bvnr_write_bvni / bvnr_write_bvni_unit generate and verify the string
# before writing.  Non-decimal bases produce quoted strings.

.uint256_max = <uint:256>
    "115792089237316195423570985008687907853269984665640564039457584007913129639935";

.uint512_max = <uint:512>
    "13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084095";

.uint1024_ex = <uint:1024>
    "";

.uint32768_small = <uint:32768> 42;

.sint256_min = <sint:256>
    "-57896044618658097711785492504343953926634992332820282019728792003956564819968";

.uint128_hex = <uint:128,_16>
    "ffffffffffffffffffffffffffffffff";          # 2^128 − 1 in hex

.uint256_bin = <uint:256,_2>
    "1111111111111111111111111111111111111111111111111111111111111111"
    "1111111111111111111111111111111111111111111111111111111111111111"
    "1111111111111111111111111111111111111111111111111111111111111111"
    "1111111111111111111111111111111111111111111111111111111111111111"; # 2^256 − 1 in binary

