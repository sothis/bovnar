  { .code = "nt";         .bovnar = "cd/m^2"; .metric = false; },
  { .code = "b";          .bovnar = "barn";  .metric = false; },
  { .code = "curie";      .bovnar = "Ci";    .metric = false; },
  { .code = "roentgen";   .bovnar = "R";     .metric = false; },
  { .code = "R";          .bovnar = "R";     .metric = false; },
  { .code = "rem";        .bovnar = "rem";   .metric = false; },

  # ── Mass of an atom ──────────────────────────────────────────────────────
  # "unified_atomic_mass_unit" is UDUNITS' fourth spelling and now maps too, in
  # the completion block below. It could not when this block was written: at 24
  # bytes it pushed this profile's worst-case emitted string past
  # BVNR_UNIT_STRING_MAX, which gen_profiles.py refuses to generate. Closing the
  # table admitted a longer code still -- "astronomical_unit_BIPM_2006", 27
  # bytes -- and the constant went from 1024 to 1088 to take it.
  { .code = "u";                  .bovnar = "Da"; .metric = false; },
  { .code = "amu";                .bovnar = "Da"; .metric = false; },
  { .code = "atomic_mass_unit";   .bovnar = "Da"; .metric = false; },

  # ── Ratios and logarithms ────────────────────────────────────────────────
  { .code = "percent";   .bovnar = "%";   .metric = false; },
  { .code = "%";         .bovnar = "%";   .metric = false; },
  { .code = "ppm";       .bovnar = "ppm"; .metric = false; },
  { .code = "ppb";       .bovnar = "ppb"; .metric = false; },
  { .code = "dB";        .bovnar = "dB";  .metric = false; },
  { .code = "decibel";   .bovnar = "dB";  .metric = false; },
  { .code = "Np";        .bovnar = "Np";  .metric = true;  },
  { .code = "neper";     .bovnar = "Np";  .metric = true;  },
  { .code = "pH";        .bovnar = "pH";  .metric = false; },

  # ── Information ──────────────────────────────────────────────────────────
  # UDUNITS' "byte" is defined as 8 (dimensionless), i.e. eight bits; bovnar
  # models bit and byte as two base units of information with no factor
  # between them, so the 8 is a modelling difference and not a scale to fold.
  { .code = "bit";       .bovnar = "b";   .metric = true;  },
  { .code = "byte";      .bovnar = "B";   .metric = true;  },
  { .code = "baud";      .bovnar = "Bd";  .metric = true;  },
  { .code = "Bd";        .bovnar = "Bd";  .metric = true;  },

  # ── Closing the table against the UDUNITS-2 database ─────────────────────
  #
  # Every spelling below is one UDUNITS defines and this table did not name, so
  # it came back as error_unit_illegal -- "that is not a UDUNITS unit" -- about
  # units UDUNITS does define. Most are ALIASES of a unit already mapped here:
  # UDUNITS treats "kelvin", "degrees_kelvin", "degK" and "deg_K" as spellings
  # of one unit, and a table that takes the first and rejects the last is
  # refusing CF's commonest spelling of a unit it already carries.
  #
  # .reverse = false throughout. These rows exist so a producer's string is
  # READ; none of them should change what bovnar WRITES, and leaving the
  # reverse table untouched keeps §5.3's round-trip sweep where it is.
  #
  # .metric is inherited from the sibling that was already mapped, and is false
  # for a unit that had no sibling: refusing a prefixed spelling costs an error
  # message, accepting one nothing checked costs a wrong number.
  { .code = "Ω";                       .bovnar = "Ω";             .metric = true;  .reverse = false; },  # alias of ohm
  { .code = "Ω";                       .bovnar = "Ω";             .metric = true;  .reverse = false; },  # alias of ohm
  { .code = "°C";                      .bovnar = "°C";            .metric = false; .reverse = false; },  # alias of degree_Celsius
