#!bovnar 1.1
# units.bvnr — demonstrates every unit feature in BVNR
#
# Units are an optional per-value annotation attached to uint, sint, and float
# fields (utf8 lexically accepts them but ignores them semantically).
#
# A unit occupies the third positional parameter class inside <…>:
#   <family : width , _base , unit>
# All three classes are identified by content, not position — they may appear
# in any order and at most one of each class is allowed per annotation.
#
# The unit string is parsed by bvn_parse_unit() after the lexer captures
# the full annotation body.  Validation errors are: error_unit_illegal (32),
# error_unit_too_long (22), error_unit_mismatch (38).


# ══════════════════════════════════════════════════════════════════════════════
# 1.  no_unit — explicit dimensionless keyword
# ══════════════════════════════════════════════════════════════════════════════
# Explicit "no_unit" keyword produces:
#   BVN_UNIT_NONE               →  num_components=0
# An absent unit parameter produces:
#   BVN_UNIT_NO_PREFIX(bu_none) →  num_components=1, base=bu_none
# Both compare as compatible via bvn_units_compatible and both serialize to
# "no_unit" via bvn_unit_to_string, but they are structurally distinct states.

.explicit_no_unit = <uint:32,no_unit>    42;      # explicitly dimensionless
.implicit_no_unit = <uint:32>            42;       # absent unit → same internal state
.no_unit_sint     = <sint:16,no_unit>   -7;        # applies to sint too
.no_unit_float    = <float:64,no_unit>   3.14;     # applies to float too
.no_unit_inline   = 3.14 no_unit;                  # inline suffix form of no_unit


# ══════════════════════════════════════════════════════════════════════════════
# 2.  SI base units (bare, no prefix, no exponent)
# ══════════════════════════════════════════════════════════════════════════════
# All 7 SI base units.  The kilogram is represented as k~g so that the kilo
# prefix can be separated from the gram base symbol.

.si_second   = <float:64,s>   1.0;         # second (time)
.si_meter    = <float:64,m>   1.0;         # meter  (length)
.si_gram     = <float:64,g>   1.0;         # gram   (mass base symbol; bare = 10⁻³ kg)
.si_ampere   = <float:64,A>   1.0;         # ampere (electric current)
.si_kelvin   = <float:64,K>   273.15;      # kelvin (thermodynamic temperature)
.si_mol      = <float:64,mol> 6.022e23;    # mole   (amount of substance)
.si_candela  = <float:64,cd>  1.0;         # candela (luminous intensity)


# ══════════════════════════════════════════════════════════════════════════════
# 3.  Named SI-derived units (21 named SI-derived units)
# ══════════════════════════════════════════════════════════════════════════════

.u_radian     = <float:64,rad> 1.5708;     # radian    — plane angle (m/m)
.u_steradian  = <float:64,sr>  3.1416;     # steradian — solid angle (m²/m²)
.u_hertz      = <float:64,Hz>  440.0;      # hertz     — s⁻¹
.u_newton     = <float:64,N>   9.81;       # newton    — kg·m·s⁻²
.u_pascal     = <float:64,Pa>  101325.0;   # pascal    — kg·m⁻¹·s⁻²
.u_joule      = <float:64,J>   1.0;        # joule     — kg·m²·s⁻²
.u_watt       = <float:64,W>   60.0;       # watt      — kg·m²·s⁻³
.u_volt       = <float:64,V>   3.3;        # volt      — kg·m²·A⁻¹·s⁻³
.u_ohm        = <float:64,Ω>   470.0;      # ohm       — Ω U+2126 (0xE2 0x84 0xA6)
.u_farad      = <float:64,F>   1e-6;       # farad     — kg⁻¹·m⁻²·A²·s⁴
.u_coulomb    = <float:64,C>   1.602e-19;  # coulomb   — A·s
.u_siemens    = <float:64,S>   0.02;       # siemens   — kg⁻¹·m⁻²·A²·s³
.u_weber      = <float:64,Wb>  1.0;        # weber     — kg·m²·A⁻¹·s⁻²
.u_tesla      = <float:64,T>   1.0;        # tesla     — kg·A⁻¹·s⁻²
.u_henry      = <float:64,H>   1e-3;       # henry     — kg·m²·A⁻²·s⁻²
.u_lumen      = <float:64,lm>  800.0;      # lumen     — cd·sr
.u_lux        = <float:64,lx>  1000.0;     # lux       — cd·sr·m⁻²
.u_becquerel  = <float:64,Bq>  37e9;       # becquerel — s⁻¹ (activity)
.u_gray       = <float:64,Gy>  0.001;      # gray      — m²·s⁻²  (absorbed dose)
.u_sievert    = <float:64,Sv>  0.001;      # sievert   — m²·s⁻²  (effective dose)
.u_katal      = <float:64,kat> 1.0;        # katal     — mol·s⁻¹


# ══════════════════════════════════════════════════════════════════════════════
# 4.  Non-SI units accepted for use with the SI
# ══════════════════════════════════════════════════════════════════════════════

.u_liter   = <float:64,L>   1.5;           # liter   (10⁻³ m³)
.u_minute  = <uint:32,min>  90;            # minute  (60 s)
.u_hour    = <uint:32,h>    8;             # hour    (3600 s)
.u_day     = <uint:16,d>    365;           # day     (86400 s)
.u_degree  = <float:64,°>   270.0;         # degree (plane angle) — U+00B0
.u_celsius = <float:32,°C>  20.0;          # degree Celsius — affine unit (K = °C + 273.15)
                                            # bvn_unit_to_factor returns 1.0;
                                            # the +273.15 offset must be handled by the caller


# ══════════════════════════════════════════════════════════════════════════════
# 5.  Digital base units
# ══════════════════════════════════════════════════════════════════════════════

.u_bit  = <uint:64,b>  8;                  # bit  (bu_bit)
.u_byte = <uint:64,B>  1500;               # byte (bu_byte)


# ══════════════════════════════════════════════════════════════════════════════
# 6.  All 24 SI prefixes on a common base unit (meter)
# ══════════════════════════════════════════════════════════════════════════════
# Prefix–base unit pairs are written as "prefix~base", or compactly without the
# tilde ("km"); section 31 covers the compact form. A bare "m" alone is the
# meter base unit, not a prefixed unit.

.pfx_quetta = <float:64,Q~m>  1.0;     # quettameter  10³⁰ m
.pfx_ronna  = <float:64,R~m>  1.0;     # ronnameter   10²⁷ m
.pfx_yotta  = <float:64,Y~m>  1.0;     # yottameter   10²⁴ m
.pfx_zetta  = <float:64,Z~m>  1.0;     # zettameter   10²¹ m
.pfx_exa    = <float:64,E~m>  1.0;     # exameter     10¹⁸ m
.pfx_peta   = <float:64,P~m>  1.0;     # petameter    10¹⁵ m
.pfx_tera   = <float:64,T~m>  1.0;     # terameter    10¹² m
.pfx_giga   = <float:64,G~m>  1.0;     # gigameter    10⁹  m
.pfx_mega   = <float:64,M~m>  1.0;     # megameter    10⁶  m
.pfx_kilo   = <float:64,k~m>  1.5;     # kilometer    10³  m  (k = kilo)
.pfx_hecto  = <float:64,h~m>  1.0;     # hectometer   10²  m
.pfx_deca   = <float:64,da~m> 1.0;     # decameter    10¹  m  (two-char prefix "da")
# (no prefix)                           # bare meter   10⁰  m  → si_none
.pfx_deci   = <float:64,d~m>  1.0;     # decimeter    10⁻¹ m
.pfx_centi  = <float:64,c~m>  1.0;     # centimeter   10⁻² m
.pfx_milli  = <float:64,m~m>  1.0;     # millimeter   10⁻³ m  (prefix m~, base m)
.pfx_micro  = <float:64,µ~m>  1.0;     # micrometer   10⁻⁶ m  — µ = U+00B5 (0xC2 0xB5)
.pfx_nano   = <float:64,n~m>  1.0;     # nanometer    10⁻⁹ m
.pfx_pico   = <float:64,p~m>  1.0;     # picometer    10⁻¹² m
.pfx_femto  = <float:64,f~m>  1.0;     # femtometer   10⁻¹⁵ m
.pfx_atto   = <float:64,a~m>  1.0;     # attometer    10⁻¹⁸ m
.pfx_zepto  = <float:64,z~m>  1.0;     # zeptometer   10⁻²¹ m
.pfx_yocto  = <float:64,y~m>  1.0;     # yoctometer   10⁻²⁴ m
.pfx_ronto  = <float:64,r~m>  1.0;     # rontometer   10⁻²⁷ m
.pfx_quecto = <float:64,q~m>  1.0;     # quectometer  10⁻³⁰ m


# ══════════════════════════════════════════════════════════════════════════════
# 7.  All 10 IEC binary prefixes on byte (B)
# ══════════════════════════════════════════════════════════════════════════════
# IEC prefixes follow the same "prefix~base" convention, tilde optional
# ("MiB" = "Mi~B"). They are recognised by the two-character "Xi" pattern.

.iec_kibi  = <uint:64,Ki~B>  1024;     # kibibyte  2¹⁰  B  = 1 024 B
.iec_mebi  = <uint:64,Mi~B>  1;        # mebibyte  2²⁰  B  = 1 048 576 B
.iec_gibi  = <uint:64,Gi~B>  8;        # gibibyte  2³⁰  B  = 1 073 741 824 B
.iec_tebi  = <uint:64,Ti~B>  2;        # tebibyte  2⁴⁰  B
.iec_pebi  = <uint:64,Pi~B>  1;        # pebibyte  2⁵⁰  B
.iec_exbi  = <uint:64,Ei~B>  1;        # exbibyte  2⁶⁰  B
.iec_zebi  = <uint:64,Zi~B>  1;        # zebibyte  2⁷⁰  B
.iec_yobi  = <uint:64,Yi~B>  1;        # yobibyte  2⁸⁰  B
.iec_robi  = <uint:64,Ri~B>  1;        # robibyte  2⁹⁰  B
.iec_quebi = <uint:64,Qi~B>  1;        # quebibyte 2¹⁰⁰ B

.iec_bits  = <uint:64,Gi~b>  10;       # gibibit — IEC prefix on bit unit


# ══════════════════════════════════════════════════════════════════════════════
# 8.  Prefix–base ambiguities resolved by the tilde
# ══════════════════════════════════════════════════════════════════════════════
# Several single-letter symbols are both a prefix and a base unit.
# "prefix~" (with tilde) → prefix; bare → base unit.

.ambig_m_meter  = <float:64,m>    1.0;   # m alone   → meter (bu_meter)
.ambig_m_milli  = <float:64,m~s>  1.0;   # m~        → milli (millisecond)

.ambig_d_day    = <float:64,d>    1.0;   # d alone   → day   (bu_day)
.ambig_d_deci   = <float:64,d~s>  1.0;   # d~        → deci  (decisecond)

.ambig_h_hour   = <float:64,h>    1.0;   # h alone   → hour  (bu_hour)
.ambig_h_hecto  = <float:64,h~m>  1.0;   # h~        → hecto (hectometer)

.ambig_T_tesla  = <float:64,T>    1.0;   # T alone   → tesla (bu_tesla)
.ambig_T_tera   = <float:64,T~m>  1.0;   # T~        → tera  (terameter)

.ambig_f_farad  = <float:64,F>    1.0;   # F alone   → farad (bu_farad)
.ambig_f_femto  = <float:64,f~m>  1.0;   # f~        → femto (femtometer)

.ambig_S_siem   = <float:64,S>    1.0;   # S alone   → siemens (bu_siemens)


# ══════════════════════════════════════════════════════════════════════════════
# 9.  Exponents — Unicode superscript form
# ══════════════════════════════════════════════════════════════════════════════
# Superscript glyphs ¹–⁹ plus both sign glyphs.
# Format: base-unit followed immediately by the superscript character(s).

.exp_one    = <float:64,m¹>   1.0;   # m¹  → exp_linear  (explicit ¹)
.exp_two    = <float:64,m²>   4.0;   # m²  → exp_square
.exp_three  = <float:64,m³>   8.0;   # m³  → exp_cubic
.exp_four   = <float:64,m⁴>   1.0;   # m⁴  → exp_quartic
.exp_five   = <float:64,m⁵>   1.0;   # m⁵  → exp_quintic
.exp_six    = <float:64,m⁶>   1.0;   # m⁶  → exp_sextic
.exp_seven  = <float:64,m⁷>   1.0;   # m⁷  → exp_septic
.exp_eight  = <float:64,m⁸>   1.0;   # m⁸  → exp_octic
.exp_nine   = <float:64,m⁹>   1.0;   # m⁹  → exp_nonic

.exp_pos_sign = <float:64,m⁺²>  4.0;  # ⁺ sign before ² — no-op; still exp_square
.exp_neg_two  = <float:64,m⁻²>  1.0;  # ⁻² → exp_neg_square


# ══════════════════════════════════════════════════════════════════════════════
# 10. Exponents — ASCII caret form (equivalent to Unicode superscripts)
# ══════════════════════════════════════════════════════════════════════════════
# Syntax: base-unit ^ [+|-] single-ASCII-digit (1–9)
# Only one digit is allowed after ^; m^10 is illegal. ^0 is not supported.

.caret_1    = <float:64,m^1>   1.0;   # m^1  ≡ m¹  → exp_linear
.caret_2    = <float:64,m^2>   4.0;   # m^2  ≡ m²  → exp_square
.caret_3    = <float:64,m^3>   8.0;   # m^3  ≡ m³  → exp_cubic
.caret_neg2 = <float:64,m^-2>  1.0;   # m^-2 ≡ m⁻² → exp_neg_square
.caret_pos2 = <float:64,m^+2>  4.0;   # m^+2 ≡ m⁺² → exp_square (+ is no-op)
.caret_9    = <float:64,s^9>   1.0;   # s^9 → exp_nonic

.exp_linear_form = <float:64,m^1>  1.0;  # explicit ¹ → exp_linear (stored as 1)


# ══════════════════════════════════════════════════════════════════════════════
# 11. Compound units — separator characters
# ══════════════════════════════════════════════════════════════════════════════
# Three separators: * (U+002A), · (U+00B7 MIDDLE DOT), / (U+002F division)
# · and * are semantically identical (both mean multiplication).

.sep_asterisk   = <float:64,k~g*m*s>   1.0;  # * separator: kg·m·s
.sep_middledot  = <float:64,k~g·m·s>   1.0;  # · separator: identical to above
.sep_mixed      = <float:64,k~g*m·s>   1.0;  # mixed: * and · interchangeable

.sep_divide     = <float:64,m/s>        9.81; # / separator: m per second (velocity)
.sep_divide2    = <float:64,k~g/m³>  7800.0;  # kg per cubic meter (density)

# Mixed product and division
.sep_mixed_div  = <float:64,k~g·m/s²>  9.81; # k~g·m in numerator, s² in denominator


# ══════════════════════════════════════════════════════════════════════════════
# 12. Denominator semantics — "no toggle back" rule
# ══════════════════════════════════════════════════════════════════════════════
# The first / sets "in-denominator = true"; this flag is NEVER reset.
# Every component after the first / is negated, regardless of further / chars.
# a/b/c → components [a, b⁻¹, c⁻¹]    (NOT (a/b)/c as separate operations)

.denom_abc    = <float:64,m/s/K>  1.0; # m · s⁻¹ · K⁻¹  (both s and K are negated)
.denom_4comp  = <float:64,k~g·m/s²/A> 1.0; # k~g and m numerator; s² and A denominator


# ══════════════════════════════════════════════════════════════════════════════
# 13. Negative exponents in numerator (alternative to / denominator)
# ══════════════════════════════════════════════════════════════════════════════
# k~g·m·s⁻² and k~g·m/s² produce identical value_unit_t representations.

.neg_exp_unicode = <float:64,k~g·m·s⁻²> 9.81;  # ⁻² explicit negative exponent
.neg_exp_caret   = <float:64,k~g·m·s^-2> 9.81; # caret form — identical
.pos_neg_equiv   = <float:64,k~g·m/s²>   9.81;  # / form — identical internal structure


# ══════════════════════════════════════════════════════════════════════════════
# 14. Inline unit suffix — scalar context only
# ══════════════════════════════════════════════════════════════════════════════
# Inline suffix follows the value literal, before ; or a comment.
# Forbidden inside array elements (error_unexpected_input_byte).
# Uses the same character set and parser as the annotation unit parameter.
# Terminated by whitespace, #, or ;

.inline_simple   = 9.81 m/s;       # float with inline compound unit
.inline_si_pfx   = 70.5 k~g;       # inline SI-prefix unit (kilogram)
.inline_iec_pfx  = 4 Gi~B;         # inline IEC-prefix unit (gibibytes)
.inline_no_unit  = 3.14 no_unit;   # inline explicit dimensionless
.inline_uint     = 1500 B;         # inline unit on a plain integer
.inline_sint     = -40 °C;         # inline unit on a signed integer
.inline_compound = 6.674e-11 k~g^-1·m³·s^-2; # inline compound (gravitational constant)


# ══════════════════════════════════════════════════════════════════════════════
# 15. Annotation unit + inline unit interaction
# ══════════════════════════════════════════════════════════════════════════════
# Both present and equal → valid (the common unit is used).
# Both present and different → error_unit_mismatch.
# Equality is checked by component comparison, so logically equivalent
# notations (m/s vs m·s⁻¹) are treated as matching.

.both_equal_a = <float:64,m/s>    9.81 m/s;    # annotation = inline → valid
.both_equal_b = <float:64,m/s>    9.81 m·s⁻¹;  # annotation m/s = inline m·s⁻¹ → valid
                                                 # (different notation, same internal form)
.annot_only   = <float:64,Pa>     101325.0;     # annotation unit, no inline
.inline_only  = 101325.0 Pa;                    # inline unit, no annotation


# ══════════════════════════════════════════════════════════════════════════════
# 16. Parameter order independence — unit interleaved with width and base
# ══════════════════════════════════════════════════════════════════════════════
# All four assignments below are semantically identical.

.order_a = <uint:32,_10,no_unit>  42;   # width, base, unit
.order_b = <uint:no_unit,_10,32>  42;   # unit, base, width
.order_c = <uint:_10,32,no_unit>  42;   # base, width, unit
.order_d = <uint:no_unit,32,_10>  42;   # unit, width, base

.order_real_a = <float:32,_10,m/s>  9.81;   # width=32, base=10, unit=m/s
.order_real_b = <float:m/s,32,_10>  9.81;   # unit first — still valid
.order_real_c = <float:_10,m/s,32>  9.81;   # base, unit, width


# ══════════════════════════════════════════════════════════════════════════════
# 17. Applicable type families
# ══════════════════════════════════════════════════════════════════════════════

.uint_unit    = <uint:64,s>           3600;      # uint — fully supported
.sint_unit    = <sint:32,°C>         -40;         # sint — fully supported
.float_unit   = <float:64,m/s>        9.81;       # float — fully supported
.fix_unit     = <float_fix:32,q8,m/s> 9.81;       # float_fix — supported
.dec_unit     = <float_dec:64,Pa>     101325;      # float_dec — supported
# utf8 is a parameterless family: <utf8:m> would be error_illegal_value_type.
.utf8_plain   = <utf8> "3.14";                    # carries no width/base/unit


# ══════════════════════════════════════════════════════════════════════════════
# 18. Common physical quantity patterns
# ══════════════════════════════════════════════════════════════════════════════

.velocity          = <float:64,m/s>         299792458.0;  # speed of light
.acceleration      = <float:64,m/s²>        9.80665;       # std. gravity
.force_newton      = <float:64,k~g·m/s²>    9.81;          # force (same as N)
.energy_joule      = <float:64,k~g·m²/s²>   4184.0;        # 1 kcal in J
.pressure_pa       = <float:64,k~g/m/s²>    101325.0;      # pressure (alt. Pa)
.power_watt        = <float:64,k~g·m²/s³>   60.0;          # power (alt. W)
.momentum          = <float:64,k~g·m/s>     10.0;          # linear momentum
.angular_velocity  = <float:64,°/s>         360.0;          # rotation rate
.electric_field    = <float:64,V/m>          1000.0;        # E~field strength
.magnetic_flux_den = <float:64,m~T>          50.0;          # 50 millitesla
.capacitance       = <float:64,µ~F>          100.0;         # 100 µF
.inductance        = <float:64,m~H>          10.0;          # 10 mH
.flow_rate         = <float:64,L/min>        15.0;          # liters per minute
.mass_density      = <float:64,k~g/m³>       7800.0;        # steel density
.surface_density   = <float:64,k~g/m²>       200.0;         # area load
.torque            = <float:64,N·m>           25.0;          # torque (N·m)
.luminance         = <float:64,cd/m²>        500.0;          # luminance (nit)
.dose_rate         = <float:64,Gy/s>          0.001;         # absorbed dose rate
.catalytic_act     = <float:64,µ~kat>         1.5;           # catalytic activity
.radioactivity     = <float:64,M~Bq>          1.0;           # MBq

# Gravitational constant: G ≈ 6.674×10⁻¹¹ m³·kg⁻¹·s⁻²
.gravitational_G   = <float:64,m³/k~g/s²>    6.674e-11;     # 3 components; / no-toggle

# Boltzmann constant: k_B = 1.380649×10⁻²³ J/K
.boltzmann         = <float:64,J/K>           1.380649e-23;

# Planck constant: h = 6.62607015×10⁻³⁴ J·s
.planck            = <float:64,J·s>           6.62607015e-34;


# ══════════════════════════════════════════════════════════════════════════════
# 19. Common digital quantity patterns
# ══════════════════════════════════════════════════════════════════════════════

.packet_size  = <uint:16,B>      1500;      # Ethernet MTU in bytes
.mtu_bits     = <uint:16,b>      12000;     # same MTU in bits
.cache_ki     = <uint:32,Ki~B>   512;       # 512 KiB CPU cache
.ram_mi       = <uint:64,Mi~B>   4096;      # 4 GiB RAM
.ssd_gi       = <uint:64,Gi~B>   500;       # 500 GiB SSD
.hdd_ti       = <uint:64,Ti~B>   2;         # 2 TiB HDD
.tape_pi      = <uint:64,Pi~B>   1;         # 1 PiB tape
.link_mb      = <uint:32,M~b>    1000;      # 1000 Mbit link (SI, not IEC)
.nic_gb       = <float:64,G~b/s> 10.0;      # 10 Gbit/s NIC throughput


# ══════════════════════════════════════════════════════════════════════════════
# 20. Units in typed arrays (array-wide annotation)
# ══════════════════════════════════════════════════════════════════════════════
# The annotation before [ applies to every element.
# Inline unit suffix is FORBIDDEN inside [ … ] — only annotation form is valid.

.timestamps  = <uint:32,s>     [0, 86400, 172800, 259200];    # 4 timestamps in seconds
.voltages    = <float:32,m~V>  [3300.0, 5000.0, 1800.0];     # millivolts
.adc_samples = <sint:16,m~V>   [-32768, 0, 32767];            # signed ADC with unit
.temps_c     = <float:32,°C>   [-40.0, 0.0, 25.0, 85.0];     # temperatures
.ram_sizes   = <uint:64,Gi~B>  [4, 8, 16, 32];               # memory options


# ══════════════════════════════════════════════════════════════════════════════
# 21. Units on struct fields
# ══════════════════════════════════════════════════════════════════════════════

.imu_reading = {
    .accel_x   = <float:32,m/s²>   0.12;
    .accel_y   = <float:32,m/s²>  -9.79;
    .accel_z   = <float:32,m/s²>   0.33;
    .gyro_x    = <float:32,°/s>    0.01;
    .gyro_y    = <float:32,°/s>   -0.02;
    .gyro_z    = <float:32,°/s>    0.00;
    .temp      = <float:32,°C>    25.3;
    .timestamp = <uint:32,µ~s>    1234567890;    # microseconds since epoch
};

.storage_block = {
    .total   = <uint:64,Gi~B>  512;
    .used    = <uint:64,Gi~B>  128;
    .free    = <uint:64,Gi~B>  384;
    .inode_size = <uint:16,B>  256;
};


# ══════════════════════════════════════════════════════════════════════════════
# 22. Up to 8 components (BVN_MAX_UNIT_COMPONENTS limit)
# ══════════════════════════════════════════════════════════════════════════════
# The maximum is 8 components.  Compound physical units rarely exceed 4–5.

.seven_comp = <float:64,k~g·m·s/A·K·mol·cd>   1.0;  # 7 components — within limit
.eight_comp = <float:64,m·s·k~g·A·K·mol·cd·b> 1.0;  # 8 components — at the limit




# ══════════════════════════════════════════════════════════════════════════════
# 23. Non-SI units — imperial, US customary, CGS, and legacy units
# ══════════════════════════════════════════════════════════════════════════════
# These units are recognised by the parser and converted to SI internally by
# bvn_unit_to_si_factor().  They may NOT carry SI or IEC prefixes unless the
# conversion is dimensionless (e.g. neper).  Affine units (°F) require special
# treatment: bvn_unit_to_si_factor returns a scale factor and a non-zero
# affine_offset; callers must apply both when converting to Kelvin.

# --- length ---
.len_inch          = <float:64,in>    25.4;        # inch        1 in  = 0.0254 m (exact)
.len_foot          = <float:64,ft>    1.0;         # foot        1 ft  = 0.3048 m (exact)
.len_yard          = <float:64,yd>    1.0;         # yard        1 yd  = 0.9144 m (exact)
.len_mile          = <float:64,mi>    1.0;         # mile        1 mi  = 1609.344 m (exact)
.len_nautical_mile = <float:64,nmi>   1.0;         # naut. mile  1 nmi = 1852 m (exact)
.len_angstrom      = <float:64,Å>     1.5;         # ångström    1 Å   = 1e-10 m  (U+212B)
.len_light_year    = <float:64,ly>    4.246;       # light-year  1 ly  = 9.4607×10¹⁵ m
.len_parsec        = <float:64,pc>    1.0;         # parsec      1 pc  = 3.0857×10¹⁶ m
.len_furlong       = <float:64,fur>   8.0;         # furlong     1 fur = 201.168 m
.len_fathom        = <float:64,fath>  6.0;         # fathom      1 fth = 1.8288 m

# --- mass ---
.mass_pound        = <float:64,lb>    2.205;       # pound       1 lb    = 0.45359237 kg (exact)
.mass_ounce        = <float:64,oz>    16.0;        # ounce       1 oz    = 0.02834952 kg
.mass_grain        = <float:64,gr>    7000.0;      # grain       1 gr    = 6.479891e-5 kg
.mass_stone        = <float:64,st>    1.0;         # stone       1 st    = 6.35029318 kg
.mass_short_ton    = <float:64,tn_sh> 1.0;         # short ton   1 tn_sh = 907.18474 kg
.mass_long_ton     = <float:64,tn_l>  1.0;         # long ton    1 tn_l  = 1016.046909 kg
.mass_troy_ounce   = <float:64,oz_t>  1.0;         # troy ounce  1 oz_t  = 0.031103477 kg
.mass_carat        = <float:64,ct>    5.0;         # carat       1 ct    = 2e-4 kg (exact)

# --- temperature (affine) ---
.temp_fahrenheit   = <float:64,°F>    72.0;        # °F (affine) K = (°F + 459.67) × 5/9
                                                    # U+00B0 U+0046  (0xC2 0xB0 0x46)

# --- pressure ---
.pres_atm          = <float:64,atm>   1.0;         # atmosphere  1 atm   = 101325 Pa (exact)
.pres_mmhg         = <float:64,mmHg>  760.0;       # mmHg        1 mmHg  = 133.322387 Pa
.pres_torr         = <float:64,Torr>  760.0;       # torr        1 Torr  = 101325/760 Pa
.pres_psi          = <float:64,psi>   14.696;      # psi         1 psi   = 6894.757 Pa

# --- energy ---
.energy_calorie    = <float:64,cal>   1000.0;      # calorie (thermo)  1 cal = 4.184 J (exact)
.energy_btu        = <float:64,Btu>   1.0;         # Btu               1 Btu = 1055.056 J
.energy_erg        = <float:64,erg>   1e7;         # erg               1 erg = 1e-7 J (exact)
.energy_therm      = <float:64,thm>   1.0;         # therm (US)        1 thm = 1.05480×10⁸ J

# --- power ---
.power_hp          = <float:64,hp>    1.0;         # horsepower  1 hp   = 745.69987 W

# --- force ---
.force_lbf         = <float:64,lbf>   1.0;         # pound-force 1 lbf  = 4.448222 N
.force_dyne        = <float:64,dyn>   1e5;         # dyne        1 dyn  = 1e-5 N (exact)
.force_kip         = <float:64,kip>   1.0;         # kip         1 kip  = 4448.222 N

# --- speed ---
.speed_knot        = <float:64,kn>    1.0;         # knot        1 kn   = 1852/3600 m/s

# --- volume (US customary) ---
.vol_gallon        = <float:64,gal>   1.0;         # US gallon   1 gal  = 3.785412e-3 m³
.vol_gallon_uk     = <float:64,gal_uk> 1.0;        # imp. gallon 1 gal  = 4.54609e-3 m³ (exact)
.vol_quart         = <float:64,qt>    4.0;         # US quart    1 qt   = 9.463529e-4 m³
.vol_pint          = <float:64,pt>    8.0;         # US pint     1 pt   = 4.731765e-4 m³
.vol_cup           = <float:64,cup>   16.0;        # US cup      1 cup  = 2.365882e-4 m³
.vol_fluid_ounce   = <float:64,fl_oz> 128.0;       # US fl oz    1 fl oz = 2.957353e-5 m³
.vol_tablespoon    = <float:64,tbsp>  256.0;       # US tbsp     1 tbsp = 1.478676e-5 m³
.vol_teaspoon      = <float:64,tsp>   768.0;       # US tsp      1 tsp  = 4.928922e-6 m³
.vol_barrel        = <float:64,bbl>   1.0;         # oil barrel  1 bbl  = 0.158987 m³

# --- area ---
.area_acre         = <float:64,ac>    1.0;         # acre        1 ac   = 4046.8564224 m² (exact)
.area_barn         = <float:64,barn>  1.0;         # barn        1 barn = 1e-28 m² (exact)

# --- plane angle ---
.ang_arcminute     = <float:64,arcmin>  60.0;      # arcminute   1 arcmin = π/10800 rad
.ang_arcsecond     = <float:64,arcsec>  3600.0;    # arcsecond   1 arcsec = π/648000 rad
.ang_grad          = <float:64,grad>    400.0;     # gradian     1 grad   = π/200 rad

# --- CGS units ---
.cgs_poise         = <float:64,P>     10.0;        # poise      1 P  = 0.1 Pa·s   (dynamic viscosity)
.cgs_stokes        = <float:64,St>    1e4;         # stokes     1 St = 1e-4 m²/s  (kinematic viscosity)
.cgs_gauss         = <float:64,G>     1e4;         # gauss      1 G  = 1e-4 T      (magnetic flux density)
.cgs_maxwell       = <float:64,Mx>    1e8;         # maxwell    1 Mx = 1e-8 Wb     (magnetic flux)
.cgs_oersted       = <float:64,Oe>    1.0;         # oersted    1 Oe = 1000/(4π) A/m
.cgs_stilb         = <float:64,sb>    1.0;         # stilb      1 sb = 1e4 cd/m²  (luminance)
.cgs_phot          = <float:64,ph>    1.0;         # phot       1 ph = 1e4 lx      (illuminance)
.cgs_galileo       = <float:64,Gal>   1.0;         # galileo    1 Gal = 0.01 m/s²  (acceleration)

# --- radiation (legacy) ---
.rad_curie         = <float:64,Ci>    1.0;         # curie      1 Ci = 3.7×10¹⁰ Bq (activity)
.rad_roentgen      = <float:64,R>     1.0;         # roentgen   1 R  = 2.58e-4 C/kg (exposure)
.rad_rem           = <float:64,rem>   100.0;       # rem        1 rem = 0.01 Sv (dose equivalent)

# --- logarithmic ---
.log_neper         = <float:64,Np>    1.0;         # neper (dimensionless logarithmic ratio)
.log_decibel       = <float:64,dB>    -3.0;        # decibel — 1 Np = 20/ln(10) dB ≈ 8.686 dB
.log_dB_gain       = <float:64,dB>    20.0;        # gain expressed in dB
.log_dB_loss       = <float:32,dB>    -6.0;        # insertion loss in dB

# --- compound expressions using non-SI units ---
.eng_lbf_per_in2   = <float:64,lbf/in²>  14.696;  # pressure in psi expressed as lbf/in²
.eng_ft_per_s      = <float:64,ft/s>      88.0;    # velocity (60 mph → 88 ft/s)
.eng_btu_per_hour  = <float:64,Btu/h>     3412.0;  # power (1 kW ≈ 3412 Btu/h)
.eng_hp_hour       = <float:64,hp·h>      1.0;     # energy (1 hp·h ≈ 2.685 MJ)
.eng_gal_per_min   = <float:64,gal/min>   1.0;     # volumetric flow rate
.eng_lb_per_ft3    = <float:64,lb/ft³>    62.4;    # density (water ≈ 62.4 lb/ft³)

# --- rankine (absolute Fahrenheit-degree temperature scale) ---
.temp_rankine_abs  = <float:64,Ra>    491.67;      # 491.67 °Ra = 32 °F = 273.15 K = 0 °C
.temp_rankine_room = <float:64,Ra>    527.67;      # room temperature (68 °F) in Rankine
# K = °Ra × (5/9) — linear (no affine offset)

# --- slug (imperial mass unit) ---
.mass_slug         = <float:64,slug>  1.0;         # 1 slug = 14.5939 kg
.dynamics_accel    = <float:64,ft/s²> 32.174;      # 1 slug × 32.174 ft/s² = 1 lbf
.mass_slugs_multi  = <float:64,slug>  3.5;         # 3.5 slugs ≈ 51.08 kg

# --- thou / mil (precision engineering length) ---
.pcb_trace_thou    = <float:64,thou>  5.0;         # 5 thou = 5 mil = 0.127 mm
.pcb_clearance_mil = <float:64,thou>  3.0;         # 3 mil clearance (mil accepted synonym)
.mfg_tolerance     = <float:32,thou>  0.5;         # ±0.5 thou tolerance

# --- UK imperial volume units ---
.vol_pint_uk       = <float:64,pt_uk>     1.0;     # 1 UK pint = 568.26 mL (≠ US pint 473.2 mL)
.vol_pint_uk2      = <float:32,pint_uk>   0.5;     # half UK pint
.vol_fl_oz_uk      = <float:64,fl_oz_uk>  20.0;    # 20 UK fl oz = 1 UK pint
.vol_quart_uk      = <float:64,qt_uk>     1.0;     # 1 UK quart = 1136.52 mL
.vol_quart_uk2     = <float:64,quart_uk>  4.0;     # 4 UK quarts = 1 UK gallon
# Relationship: 1 gal_uk = 4 qt_uk = 8 pt_uk = 160 fl_oz_uk

# --- electrical power units (reactive and apparent power) ---
.power_reactive    = <float:64,var>   500.0;       # 500 var reactive power
.power_reactive_k  = <float:64,k~var> 1.5;         # 1.5 kvar — prefixes apply
.power_apparent    = <float:64,VA>    750.0;        # 750 VA apparent power
.power_apparent_k  = <float:64,k~VA>  2.0;          # 2 kVA transformer rating
.power_pf          = <float:64,no_unit> 0.85;       # power factor = W/VA (dimensionless)
# Note: W, var, and VA are dimensionally identical (m²·kg·s⁻³).
# bvn_units_compatible returns true across them.  Applications use
# .components[0].base to distinguish the physical interpretation.

# --- inline suffix form ---
.inline_inch       = 6.0 in;                        # six inches (inline unit)
.inline_mph        = 60.0 mi/h;                     # miles per hour
.inline_degf       = 98.6 °F;                       # body temperature in Fahrenheit
.inline_psi        = 32.0 psi;                      # tire pressure
.inline_hp         = 250.0 hp;                      # engine power
.inline_knots      = 15.0 kn;                       # ship speed in knots
.inline_rem        = 0.1 rem;                       # radiation dose
.inline_dB         = -3.0 dB;                       # 3 dB attenuation (inline)
.inline_rankine    = 491.67 Ra;                     # 0 °C expressed in Rankine
.inline_slug       = 1.0 slug;                      # one slug of mass
.inline_thou       = 10.0 thou;                     # 10 thou = 0.254 mm
.inline_pint_uk    = 1.0 pt_uk;                     # one UK pint
.inline_kvar       = 2.5 k~var;                     # 2.5 kvar reactive power


# ══════════════════════════════════════════════════════════════════════════════
# 24. Additional force, pressure, frequency, energy, mass, length, and volume
# ══════════════════════════════════════════════════════════════════════════════

# --- kilogram-force ---
# 1 kgf = 9.80665 N (exact; defined by standard gravity)
# Commonly used in machine ratings, spring constants, and load-cell specs.
# Dimensionally identical to N, lbf, dyn, kip — bvn_units_compatible returns true.

.force_kgf             = <float:64,kgf>     75.0;       # 75 kgf load-cell reading
.force_kgf_long        = <float:64,kilogram_force> 1.0; # long-form spelling accepted
.spring_constant       = <float:32,kgf/m~m> 12.5;       # spring rate in kgf/mm
.bearing_load          = <float:64,kgf>     4200.0;     # radial bearing load
# SI equivalent check: 75 kgf × 9.80665 = 735.499 N


# --- inch of mercury ---
# 1 inHg = 25.4 × 133.322387415 Pa ≈ 3386.389 Pa (conventional at 0 °C)
# Standard in US aviation altimetry and surface weather observations.
# Dimensionally identical to Pa, atm, bar, mmHg — bvn_units_compatible returns true.

.baro_altimeter        = <float:32,inHg>    29.92;      # standard sea-level QNH
.baro_low_pressure     = <float:32,inHg>    28.50;      # deep low-pressure system
.baro_long_form        = <float:32,inch_hg> 30.15;      # long-form spelling
# 29.92 inHg × 3386.389 = 101,320.8 Pa ≈ 1 atm — confirming round-trip


# --- revolutions per minute ---
# 1 rpm = 1/60 s⁻¹ (same SI dimension as Hz)
# Standard for engine speed, motor speed, centrifuge speed, turbine speed.
# bvn_units_compatible returns true when comparing rpm with Hz or Bq.

.engine_idle           = <uint:16,rpm>      800;        # idle speed
.engine_redline        = <uint:16,rpm>      7200;       # redline limit
.motor_rated           = <float:32,rpm>     1450.0;     # 4-pole induction motor at 50 Hz
.centrifuge_speed      = <uint:32,rpm>      12000;      # lab micro-centrifuge
.turbine_rpm           = <uint:32,rpm>      3600;       # 2-pole generator at 60 Hz
# 3600 rpm × (1/60) = 60 Hz — consistent with 60 Hz mains frequency


# --- foot-pound (energy / torque) ---
# 1 ft·lbf = 0.3048 m × 4.4482216152605 N = 1.3558179483 J (exact chain)
# Standard US engineering unit for both energy and torque.
# Dimensionally identical to J, cal, BTU, eV — bvn_units_compatible returns true.

.torque_wrench         = <float:32,ft_lb>   120.0;      # 120 ft·lb lug-nut torque
.engine_torque         = <float:64,ft_lb>   400.0;      # peak torque of a V8
.impact_energy         = <float:64,ft_lb>   37.0;       # Charpy impact energy
.ft_lb_long            = <float:64,foot_pound> 1.0;     # long-form spelling
.ft_lb_plural          = <float:64,foot_pounds> 550.0;  # plural spelling accepted
# 120 ft·lb × 1.3558179483 = 162.698 N·m


# --- dram (avoirdupois mass) ---
# 1 dr = 1/16 oz = 0.028349523125 / 16 = 1.7718451953125e-3 kg (exact)
# Used in pharmaceutical compounding and traditional US apothecary systems.

.compound_dose         = <float:32,dr>      2.0;        # 2 drams of a compound
.dram_long             = <float:32,dram>    1.0;        # long-form spelling
.drams_plural          = <float:32,drams>   8.0;        # 8 drams = 1 ounce
# 8 dr × 1.7718451953125e-3 = 0.01417476156 kg = 0.028349523125 kg / 2 — wait: 8 dr = 0.5 oz ✓


# --- pennyweight (troy mass) ---
# 1 dwt = 1/20 troy ounce = 0.0311034768 / 20 = 1.55517384e-3 kg (exact)
# The standard unit for precious-metals trading weights (gold, silver, platinum).

.gold_bar_weight       = <float:64,dwt>     400.0;      # a standard 400-dwt gold bar
.silver_coin           = <float:32,dwt>     17.5;       # silver coin weight
.dwt_long              = <float:32,pennyweight>  1.0;   # long-form spelling
.dwt_plural            = <float:32,pennyweights> 20.0;  # 20 dwt = 1 troy ounce
# 20 dwt × 1.55517384e-3 = 0.031103477 kg = bu_troy_ounce ✓


# --- chain and rod (surveying) ---
# 1 ch (Gunter's chain) = 66 ft = 20.1168 m (exact)
# 1 rd (rod, pole, perch) = 16.5 ft = 5.0292 m (exact)
# Fundamental units of the US Public Land Survey System (PLSS).
# 1 acre = 10 ch × 1 ch area; 1 ch = 4 rd.

.survey_distance       = <float:64,ch>      80.0;       # 80 chains = 1 mile
.survey_lot            = <float:64,ch>       5.0;       # 5-chain parcel width
.survey_rod            = <float:64,rd>      20.0;       # 20 rods = 1 chain × 5
.chain_long            = <float:64,chain>    1.0;       # long-form spelling
.rod_long              = <float:64,rod>      1.0;       # long-form spelling
.rod_plural            = <float:64,rods>     4.0;       # 4 rods = 1 chain
.chain_plural          = <float:64,chains>  80.0;       # 80 chains = 1 mile ✓
# 80 ch × 20.1168 m = 1609.344 m = 1 mile — exact


# --- gill (US and UK) ---
# 1 US gill (gi) = 4 US fluid ounces = 1.18294118250e-4 m³
# 1 UK gill (gi_uk) = 5 imperial fluid ounces = 1.420653125e-4 m³ (exact)
# Culinary and pub-measure unit; UK gill is the traditional pub serving measure.

.us_gill               = <float:32,gi>      1.0;        # one US gill = 4 fl oz
.uk_gill               = <float:32,gi_uk>   1.0;        # one UK gill = 5 imp. fl oz
.cocktail_recipe       = <float:32,gi>      2.0;        # two US gills of spirit
.pub_measure_uk        = <float:32,gi_uk>   1.0;        # traditional UK pub gill
.gill_long             = <float:32,gill>    1.0;        # long-form spelling (US)
.gill_uk_long          = <float:32,gill_uk> 1.0;        # long-form spelling (UK)
.gills_plural          = <float:32,gills>   4.0;        # 4 US gills = 1 US pint
.gills_uk_plural       = <float:32,gills_uk> 4.0;       # 4 UK gills = 1 UK pint

# Relationship checks:
# 1 pt = 2 cups = 4 gi → 4.73176473e-4 / 4 = 1.18294118250e-4 m³ (gi)
# 1 pt_uk = 4 gi_uk → 5.6826125e-4 / 4 = 1.420653125e-4 m³ (gi_uk) ✓


# ══════════════════════════════════════════════════════════════════════════════
# 25. Cross-unit compatibility demonstrations (new units)
# ══════════════════════════════════════════════════════════════════════════════
# Units with identical SI dimension vectors are compatible via bvn_units_compatible.
# Applications that must distinguish physically different interpretations inspect
# .components[0].base after the compatibility check passes.

# Force family: N, kgf, lbf, dyn, kip — all {1,1,-2,0,0,0,0}
.cmp_force_n           = <float:64,N>    9.80665;       # same force as 1 kgf
.cmp_force_kgf         = <float:64,kgf>  1.0;           # compatible with N, lbf
.cmp_force_lbf         = <float:64,lbf>  2.20462;       # 2.20462 lbf ≈ 1 kgf

# Pressure family: Pa, inHg, atm, mmHg, Torr, psi, bar — all {-1,1,-2,0,0,0,0}
.cmp_pres_pa           = <float:64,Pa>   101325.0;      # standard atmosphere
.cmp_pres_inHg         = <float:64,inHg> 29.9212;       # same: 29.9212 inHg ≈ 1 atm

# Frequency family: Hz, Bq, rpm — all {0,0,-1,0,0,0,0}
.cmp_freq_hz           = <float:64,Hz>   60.0;          # mains frequency
.cmp_freq_rpm          = <float:64,rpm>  3600.0;        # 3600 rpm = 60 Hz

# Energy family: J, cal, Btu, eV, erg, ft_lb, thm — all {2,1,-2,0,0,0,0}
.cmp_energy_j          = <float:64,J>    1.35582;       # 1 ft·lb in joules
.cmp_energy_ft_lb      = <float:64,ft_lb> 1.0;          # compatible with J, cal

# Volume family: m³, L, gal, pt, gi, gi_uk, bbl — all {3,0,0,0,0,0,0}
.cmp_vol_gi            = <float:32,gi>   1.0;           # US gill
.cmp_vol_gi_uk         = <float:32,gi_uk> 1.0;          # UK gill (≠ US gill numerically)

# Mass family: kg, g, lb, oz, dr, dwt, slug — all {0,1,0,0,0,0,0}
.cmp_mass_dwt          = <float:64,dwt>  20.0;          # 20 dwt = 1 troy oz
.cmp_mass_oz_t         = <float:64,oz_t>  1.0;          # compatible: same dims
.cmp_mass_dr           = <float:64,dr>   16.0;          # 16 dr = 1 oz (avoirdupois)
.cmp_mass_oz           = <float:64,oz>    1.0;          # compatible: same dims

# Length family: m, ft, in, ch, rd, thou — all {1,0,0,0,0,0,0}
.cmp_len_ch            = <float:64,ch>    1.0;          # 1 chain = 20.1168 m
.cmp_len_rd            = <float:64,rd>    4.0;          # 4 rods = 1 chain (20.1168 m)
.cmp_len_ft            = <float:64,ft>   66.0;          # 66 feet = 1 chain ✓


# ══════════════════════════════════════════════════════════════════════════════
# 26. New units — standard gravity, metric horsepower, revolution
# ══════════════════════════════════════════════════════════════════════════════

# --- standard gravity (gn) ---
# 1 gn = 9.80665 m/s² (exact, BIPM/CIPM 1901)
# Dimension: m·s⁻²  — same as Gal (galileo), compatible with accelerations.
# Used in: specific impulse (Isp), g-force, accelerometer calibration.
# Prefixes: m~gn (milli-g), etc.

.g_force_load          = <float:64,gn>    1.0;           # 1 g = standard gravity
.launch_acceleration   = <float:64,gn>    3.5;           # 3.5 g launch load
.spacecraft_gn         = <float:64,gn>    9.5;           # peak g during re-entry
.gn_long               = <float:64,standard_gravity> 1.0; # long-form spelling
.sensor_threshold_mg   = <float:32,m~gn>  50.0;          # 50 milli-g threshold

# --- metric horsepower (PS) ---
# 1 PS = 75 kgf·m/s = 75 × 9.80665 W = 735.49875 W (exact)
# Also written: CV (French/Spanish), pk (Norwegian/Danish).
# Dimension: m²·kg·s⁻³  — same as W, hp, VA, var.
# Commonly used for engine ratings in continental Europe.

.car_engine_ps         = <float:32,PS>    150.0;         # 150 PS engine (≈ 148 hp)
.motorcycle_ps         = <float:32,PS>     85.0;         # 85 PS motorcycle
.engine_cv             = <float:32,CV>    150.0;         # French/Spanish alias
.ps_long               = <float:32,metric_horsepower> 1.0; # long-form spelling

# --- revolution (rev) ---
# 1 rev = 2π rad = 360° (one full angular turn)
# Dimension: dimensionless — same as rad, deg, grad (sr is treated separately).
# Used for: shaft position, encoder counts, cam angle.
# Do not confuse with rpm (rev/min) which is a frequency unit.

.shaft_angle           = <float:64,rev>   1.0;           # one full rotation
.cam_advance           = <float:32,rev>   0.25;          # 90° cam advance
.rev_long              = <float:64,revolution>  1.0;     # long-form singular
.rev_plural            = <float:64,revolutions> 4.0;     # long-form plural
.rev_turn              = <float:32,turn>  1.0;           # "turn" alias
.rev_turns             = <float:32,turns> 0.5;           # 180°


# ══════════════════════════════════════════════════════════════════════════════
# 27. New units — time extensions (month, fortnight)
# ══════════════════════════════════════════════════════════════════════════════

# --- month (mo) ---
# 1 mo = 365.25 × 86400 / 12 = 2629800 s (Julian month, exact)
# Dimension: s.  Compatible with s, min, h, d, wk, yr.
# NOTE: the Julian month is a fixed-length approximation; calendar months vary.

.billing_period        = <uint:8,mo>      1;             # one billing month
.subscription_term     = <uint:16,mo>    12;             # 12-month subscription = 1 yr
.treatment_duration    = <float:32,mo>    6.0;           # six-month treatment
.mo_long               = <uint:8,month>   1;             # long-form spelling
.mo_plural             = <uint:16,months> 18;            # 18 months

# --- fortnight (fn) ---
# 1 fn = 14 d = 1209600 s (exact)
# Dimension: s.  1 fn = 2 wk.  Used in agriculture, legal, and British contexts.

.pay_period            = <uint:8,fn>      1;             # one fortnightly pay period
.quarantine_old        = <uint:8,fn>      2;             # historical 28-day quarantine
.fn_long               = <uint:8,fortnight>  1;          # long-form spelling
.fn_plural             = <uint:8,fortnights> 2;          # two fortnights = 4 weeks


# ══════════════════════════════════════════════════════════════════════════════
# 28. New units — atmosphere technical (at)
# ══════════════════════════════════════════════════════════════════════════════

# --- atmosphere technical (at) ---
# 1 at = 1 kgf/cm² = 9.80665 × 10⁴ Pa = 98066.5 Pa (exact)
# Dimension: kg·m⁻¹·s⁻²  — same as Pa, bar, atm, mmHg, psi.
# Used in older European engineering literature; slightly below standard atm.
# at ≠ atm:  1 at = 98066.5 Pa,  1 atm = 101325 Pa.

.boiler_pressure_at    = <float:32,at>    6.0;           # 6 at steam pressure
.gauge_pressure_at     = <float:32,at>   10.0;           # 10 at hydraulic
.at_long               = <float:32,atmosphere_technical> 1.0; # long-form spelling
.at_vs_atm             = <float:64,at>    1.0;           # 1 at ≈ 0.96784 atm


# ══════════════════════════════════════════════════════════════════════════════
# 29. New units — textile linear density (tex, denier)
# ══════════════════════════════════════════════════════════════════════════════

# --- tex (tex) ---
# 1 tex = 1 g/km = 1×10⁻⁶ kg/m (ISO 1144)
# Dimension: kg·m⁻¹.  Used for fiber and yarn linear mass density.
# SI-compatible; multiply by 9 to convert to denier.

# --- denier (den) ---
# 1 den = 1 g / 9000 m ≈ 1.111×10⁻⁷ kg/m
# Dimension: kg·m⁻¹.  Traditional textile unit; 9 den = 1 tex.
# Used for silk, nylon, polyester fiber; lower denier = finer thread.

.nylon_thread          = <float:32,den>   70.0;          # 70-denier nylon thread
.silk_fiber            = <float:32,den>    1.0;          # 1-denier = very fine
.polyester_yarn        = <float:32,tex>    8.0;          # 8 tex polyester
.carbon_fiber_tex      = <float:32,tex>  200.0;          # 200 tex carbon fiber tow
.den_long              = <float:32,denier>  70.0;        # long-form spelling
.den_plural            = <float:32,deniers> 20.0;        # 20 deniers
.tex_to_den_ratio      = <float:64,tex>    9.0;          # 9 tex = 9 × 9 den = 81 den? no:
                                                         # 9 tex = 9×1e-6 kg/m
                                                         # 9 den = 9/9e6 = 1e-6 kg/m
                                                         # → 9 tex = 81 den


# ══════════════════════════════════════════════════════════════════════════════
# 30. New units — US apothecary and dry volume (fl_dr, minim, peck, bushel)
# ══════════════════════════════════════════════════════════════════════════════

# --- fluid dram (fl_dr) ---
# 1 fl_dr = 1/8 US fl oz = 3.6966911953125×10⁻⁶ m³ ≈ 3.697 mL
# Dimension: m³.  8 fl_dr = 1 fl_oz;  60 minim = 1 fl_dr.
# Used in pharmacy and apothecary measures.

.medicine_dose         = <float:32,fl_dr>  1.0;          # 1 fluid dram dose
.syrup_volume          = <float:32,fl_dr>  4.0;          # 4 fl_dr = ½ fl_oz
.fl_dr_long            = <float:32,fluid_dram>  1.0;     # long-form spelling
.fl_dr_plural          = <float:32,fluid_drams> 8.0;     # 8 fl_dr = 1 fl_oz

# --- minim (minim) ---
# 1 minim = 1/60 fl_dr = 1/480 fl_oz ≈ 6.161×10⁻⁸ m³ ≈ 61.6 µL
# Dimension: m³.  Smallest traditional apothecary measure.
# 60 minim = 1 fl_dr;  480 minim = 1 fl_oz.

.drop_size             = <float:32,minim>  1.0;          # 1 minim ≈ 1 medical drop
.prescription_dose     = <float:32,minim> 15.0;          # 15 minim = ¼ fl_dr
.minim_plural          = <float:32,minims> 60.0;         # 60 minim = 1 fl_dr

# --- peck (pk) ---
# 1 pk (US dry peck) = 8.80976754172×10⁻³ m³ ≈ 8.810 L
# Dimension: m³.  4 pk = 1 bushel;  2 pk = 1 dry gallon (not the same as US gallon).
# Used in US agriculture for dry commodities (apples, grain, etc.).

.apple_basket          = <uint:8,pk>       1;            # one peck of apples
.grain_sample          = <float:32,pk>     0.5;          # half-peck grain sample
.pk_long               = <uint:8,peck>     1;            # long-form spelling
.pk_plural             = <uint:8,pecks>    4;            # 4 pecks = 1 bushel

# --- bushel (bsh) ---
# 1 bsh (US bushel) = 4 pk = 3.523907016688×10⁻² m³ ≈ 35.24 L
# Dimension: m³.  Fundamental US dry measure for grain, produce, livestock feed.
# CBOT/CME commodity contracts for corn, wheat, soybeans are priced per bushel.

.wheat_yield           = <float:32,bsh>  60.0;           # 60 bushels/acre yield
.corn_contract         = <uint:32,bsh>   5000;            # CBOT corn futures contract
.bsh_long              = <float:32,bushel>   1.0;         # long-form spelling
.bsh_plural            = <float:32,bushels> 60.0;         # 60 bushels


# ══════════════════════════════════════════════════════════════════════════════
# 31. Compact prefix form — the tilde is optional on a physical unit
# ══════════════════════════════════════════════════════════════════════════════
# "kg" is "k~g": both spellings parse to the same value_unit_t, so they compare
# equal, reconcile against each other, and convert identically. The separated
# form stays canonical — bvn_unit_to_string emits "k~g" whichever was read.
#
# The base symbol is matched as the LONGEST alias suffix, which is what makes
# this safe: a bare unit alias always outranks a prefixed reading of the same
# token, so no spelling that already parsed can mean something new.

.c_mass        = <float:64,kg>        72.5;      # k~g   — kilogram
.c_distance    = <float:64,km>         1.5;      # k~m   — kilometer
.c_period      = <float:64,ms>        16.7;      # m~s   — millisecond
.c_frequency   = <float:64,MHz>     2400.0;      # M~Hz  — megahertz
.c_pressure    = <float:64,hPa>     1013.25;     # h~Pa  — hectopascal
.c_amount      = <float:64,mmol>       2.5;      # m~mol — millimole
.c_volume      = <float:64,mL>       250.0;      # m~L   — millilitre
.c_energy      = <float:64,MeV>       13.6;      # M~eV  — megaelectronvolt
.c_memory      = <uint:64,MiB>       512;        # Mi~B  — mebibyte (IEC)
.c_link        = <uint:64,Gbit>       10;        # G~bit — gigabit
.c_force       = <float:64,kg·m/s²>    9.81;     # compounds work unchanged
.c_inline      = 88.5 km/h;                      # inline unit suffix too

# Currencies take the compact prefix as well — the '$' sigil already separates
# the prefix from the code. The sigil itself stays mandatory: "kUSD" is an error.
.c_fund_nav    = <float_dec:64,k$USD>  250.0;    # k~$USD — thousands of USD
.c_gdp         = <float_dec:64,M$EUR> 42800.0;   # M~$EUR — millions of EUR
.c_gas_price   = <float_dec:64,G$ETH>   35.0;    # G~$ETH — Gwei

# Both spellings of one unit reconcile: the annotation and the inline unit below
# are the same unit written two ways.
.c_reconciles  = <float:64,k~m>        1.5 km;

# The bare unit always wins, so these are NOT prefixed readings:
.c_minute      = <float:64,min>        1.0;      # the minute, not milli-inch
.c_candela     = <float:64,cd>         1.0;      # the candela, not centi-day
.c_milli_inch  = <float:64,m~in>       1.0;      # milli-inch needs the tilde

# Refused compactly, because the token means something else in the wild:
#   pH  (acidity, not picohenry)      → write p~H
#   mph (miles per hour, not milliphot) → write m~ph
#   kph (km per hour, not kilophot)     → write k~ph
.c_inductance  = <float:64,p~H>       33.0;      # picohenry, spelled out
