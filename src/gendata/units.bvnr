  # The mean GREGORIAN month: a twelfth of the Gregorian year, 31556952/12 s
  # exactly. Native `mo` is a twelfth of the JULIAN year (2629800 s), 54 s
  # longer -- 21 ppm apart, dimensionally identical, and invisible to anything
  # downstream, which is the shape this format refuses to guess at.
  #
  # It completes the month family beside mo, mo_syn, mo_trop and mo_sid, and it
  # is the last unit two publishers named that nothing here could carry: UCUM
  # defines it as `mo_g` (a_g/12) and QUDT as `MO_MeanGREGORIAN` with
  # ucumCode "mo_g". Both were refused for want of a native target, and doc/11
  # §6.4 named it as one of the two classes still waiting.
  {
    .id      = <uint:32> 100261;
    .name    = "month_gregorian";
    .symbol  = "mo_greg";
    .factor  = 2629746.0;
    .dims    = { .time = 1; };
    .affine  = false;
    .offset  = 0.0;
    .prefix  = default;
    .aliases = ["gregorian_month", "mo_greg"];
  }
];

# Compact spellings that must NOT resolve as prefix+unit.
#
#   The compact form is only ever reachable where the '~' form would have been
#   a parse error, so nothing here is about ambiguity inside the unit table —
#   the longest-suffix match settles every one of those (a bare alias wins, so
#   "min" stays the minute and "cd" the candela). These are the opposite case:
#   a token that is a WELL-KNOWN annotation for something else, which the
#   compact form would otherwise accept as a valid — and quietly wrong —
#   physical unit. Rejecting them keeps `error_unit_illegal` as the answer to
#   "mph", which is the whole point of a unit-safe format. "Something else" is
#   usually a quantity bovnar does not model (acidity), but "kt" is the harder
#   case: it is a standard abbreviation for TWO units bovnar DOES model, the
#   kilotonne and the knot, and reading a speed as a mass is exactly the
#   failure this format exists to prevent. A token that cannot be resolved by
#   knowing the tables is one only the author can resolve, so ask them to:
#   k~t or kn.
#
#   Only the compact spelling is refused. The separated form still parses and
#   still means what it always did: p~H is picohenry, m~ph milliphot.
#
#   .spelling  the exact compact token to refuse (matched byte-for-byte)
#   .why       why it is refused — the reading a user would actually intend

.compact_exceptions = [
  { .spelling = "usb"; .why = "the bus, not microstilb (write u~sb or µ~sb)"; },
  { .spelling = "kt";  .why = "kilotonne or knot — say which (k~t or kn)";     },
  # "ppt" resolves as p~pt, the PICOPINT — a volume. Nobody writing "ppt" means
  # that: in the wild it is parts per trillion or parts per thousand, both
  # dimensionless ratios, and reading either as a volume is the whole failure
  # this format exists to prevent. Neither reading can be granted, because the
  # two differ by 10^9 and only the author knows which; so, as with "usb", the
  # compact spelling becomes an error and the separated form keeps its meaning.
  # p~pt is still the picopint, pptr is parts per trillion, ‰ is per thousand.
  { .spelling = "ppt"; .why = "parts per trillion (pptr), per thousand (‰), or the picopint (p~pt) — say which"; }
];
