#!bovnar 1.1
# qudt.bvnr — single source of truth for the QUDT unit profile.
#
# HOW THIS WORKS
#   Hand-edited. gen_profiles.py (at the repo root) regenerates the C profile
#   tables from this file on every build; never edit the generated *.gen.{h,inc}.
#
# WHAT THIS VOCABULARY IS
#   QUDT (Quantities, Units, Dimensions and Data Types), the RDF/OWL unit
#   ontology at qudt.org. Its units are IRIs under http://qudt.org/vocab/unit/,
#   and this profile spells them by their LOCAL NAME -- the part after the last
#   '/'. QUDT is the unit vocabulary of the digital-twin and building-semantics
#   world (DTDL, Brick, ASHRAE 223P, IOF), which is why the profile exists.
#
#   A FLAT profile. A QUDT local name is ONE WHOLE TOKEN: "KiloGM" is the
#   kilogram as a single symbol, and although it LOOKS like a prefix applied to
#   "GM", nothing here takes it apart. That is deliberate. QUDT's naming is
#   regular enough to tempt a parser into decomposing it and irregular enough
#   that the parser would be wrong -- "MI" is the mile, not a milli-anything.
#
# FULL IRIs ARE NOT ACCEPTED
#   "qudt:M-PER-SEC", never "qudt:http://qudt.org/vocab/unit/M-PER-SEC". A unit
#   slot is at most 255 bytes and a ':' inside it already means something here;
#   admitting a URI would put a second scheme separator inside a namespace
#   separator for no gain, since the local name is the identifying part.
#
# PROVENANCE — READ THIS BEFORE TRUSTING A ROW
#   The .bovnar target of every row is checked against this build's native
#   registry by gen_profiles.py, and the translation is pinned by
#   tests/bovnar_qudt_test.c. NEITHER checks the QUDT side: nothing in this
#   repository verifies that "KiloGM" is really QUDT's kilogram, or that a local
#   name spelled here exists in the vocabulary at all. That gap is the same
#   standing risk doc/11 records for the UCUM table. This list is therefore a
#   CONFIDENT SUBSET: a name that is not here fails loudly as error_unit_illegal,
#   which costs a producer an error message, while a name that is here and wrong
#   costs them a wrong number.
#
# WHAT IS DELIBERATELY ABSENT
#   QUDT's quantity kinds — those are a separate namespace, "qudt-qk:", in
#   qudt-qk.bvnr, because a kind of quantity is not a unit. QUDT's currency
#   units: bovnar has ISO 4217 natively, written with the $ sigil. Every unit
#   whose QUDT value this file cannot state exactly.

.schema_version = <uint:16> 1;

.mapped = [
  # Length
  { .code = "M";          .bovnar = "m";      },
  { .code = "KiloM";      .bovnar = "k~m";    },
  { .code = "HectoM";     .bovnar = "h~m";    },
  { .code = "DeciM";      .bovnar = "d~m";    },
  { .code = "CentiM";     .bovnar = "c~m";    },
  { .code = "MilliM";     .bovnar = "m~m";    },
  { .code = "MicroM";     .bovnar = "µ~m";    },
  { .code = "NanoM";      .bovnar = "n~m";    },
  { .code = "PicoM";      .bovnar = "p~m";    },
  { .code = "ANGSTROM";   .bovnar = "Å";      },
  { .code = "IN";         .bovnar = "in";     },
  { .code = "FT";         .bovnar = "ft";     },
  { .code = "YD";         .bovnar = "yd";     },
  { .code = "MI";         .bovnar = "mi";     },
  { .code = "MI_N";       .bovnar = "nmi";    },   # not NAUT_MI
  { .code = "LY";         .bovnar = "ly";     },
  # PARSEC, not PC: QUDT's "PC" does not exist and its PCA -- whose symbol
  # really is "pc" -- is the PICA, a typographic length. Matching on the
  # symbol is how that trap is walked into.
  { .code = "PARSEC";     .bovnar = "pc";     },
  { .code = "AU";         .bovnar = "au";     },

  # Area
  { .code = "M2";         .bovnar = "m^2";    },
  { .code = "KiloM2";     .bovnar = "k~m^2";  },
  { .code = "DeciM2";     .bovnar = "d~m^2";  },
  { .code = "CentiM2";    .bovnar = "c~m^2";  },
  { .code = "MilliM2";    .bovnar = "m~m^2";  },
  { .code = "HA";         .bovnar = "ha";     },
  { .code = "AC";         .bovnar = "ac";     },
  { .code = "IN2";        .bovnar = "in^2";   },
  { .code = "FT2";        .bovnar = "ft^2";   },
  { .code = "YD2";        .bovnar = "yd^2";   },

  # Volume
  { .code = "M3";         .bovnar = "m^3";    },
  { .code = "DeciM3";     .bovnar = "d~m^3";  },
  { .code = "CentiM3";    .bovnar = "c~m^3";  },
  { .code = "MilliM3";    .bovnar = "m~m^3";  },
  { .code = "L";          .bovnar = "L";      },
  { .code = "HectoL";     .bovnar = "h~L";    },
  { .code = "DeciL";      .bovnar = "d~L";    },
  { .code = "CentiL";     .bovnar = "c~L";    },
  { .code = "MilliL";     .bovnar = "m~L";    },
  { .code = "MicroL";     .bovnar = "µ~L";    },
  { .code = "IN3";        .bovnar = "in^3";   },
  { .code = "FT3";        .bovnar = "ft^3";   },
  { .code = "YD3";        .bovnar = "yd^3";   },

  # Mass
  { .code = "GM";         .bovnar = "g";      },
  { .code = "KiloGM";     .bovnar = "k~g";    },
  { .code = "MilliGM";    .bovnar = "m~g";    },
  { .code = "MicroGM";    .bovnar = "µ~g";    },
  { .code = "TON_Metric"; .bovnar = "t";      },
  { .code = "LB";         .bovnar = "lb";     },
  { .code = "OZ";         .bovnar = "oz";     },
  { .code = "OZ_TROY";    .bovnar = "oz_t";   },
  { .code = "GRAIN";      .bovnar = "gr";     },
  { .code = "TON_SHORT";  .bovnar = "tn_sh";  },
  { .code = "TON_LONG";   .bovnar = "tn_l";   },
  { .code = "CARAT";      .bovnar = "ct";     },
  { .code = "U";          .bovnar = "Da";     },   # unified atomic mass unit

  # Time
  { .code = "SEC";        .bovnar = "s";      },
  { .code = "MilliSEC";   .bovnar = "m~s";    },
  { .code = "MicroSEC";   .bovnar = "µ~s";    },
  { .code = "NanoSEC";    .bovnar = "n~s";    },
  { .code = "PicoSEC";    .bovnar = "p~s";    },
  { .code = "MIN";        .bovnar = "min";    },
  { .code = "HR";         .bovnar = "h";      },
  { .code = "DAY";        .bovnar = "d";      },
  { .code = "WK";         .bovnar = "wk";     },
  { .code = "YR";         .bovnar = "yr";     },

  # Temperature
  { .code = "K";          .bovnar = "K";      },
  { .code = "DEG_C";      .bovnar = "°C";     },
  { .code = "DEG_F";      .bovnar = "°F";     },
  { .code = "DEG_R";      .bovnar = "°Ra";    },

  # Electric current, amount, luminous intensity
  { .code = "A";          .bovnar = "A";      },
  { .code = "MilliA";     .bovnar = "m~A";    },
  { .code = "MicroA";     .bovnar = "µ~A";    },
  { .code = "KiloA";      .bovnar = "k~A";    },
  { .code = "MOL";        .bovnar = "mol";    },
  { .code = "MilliMOL";   .bovnar = "m~mol";  },
  { .code = "CD";         .bovnar = "cd";     },

  # Named SI-derived
  { .code = "HZ";         .bovnar = "Hz";     },
  { .code = "KiloHZ";     .bovnar = "k~Hz";   },
  { .code = "MegaHZ";     .bovnar = "M~Hz";   },
  { .code = "GigaHZ";     .bovnar = "G~Hz";   },
  { .code = "N";          .bovnar = "N";      },
  { .code = "KiloN";      .bovnar = "k~N";    },
  { .code = "PA";         .bovnar = "Pa";     },
  { .code = "HectoPA";    .bovnar = "h~Pa";   },
  { .code = "KiloPA";     .bovnar = "k~Pa";   },
  { .code = "MegaPA";     .bovnar = "M~Pa";   },
  { .code = "J";          .bovnar = "J";      },
  { .code = "KiloJ";      .bovnar = "k~J";    },
  { .code = "MegaJ";      .bovnar = "M~J";    },
  { .code = "W";          .bovnar = "W";      },
  { .code = "KiloW";      .bovnar = "k~W";    },
  { .code = "MegaW";      .bovnar = "M~W";    },
  { .code = "MilliW";     .bovnar = "m~W";    },
  { .code = "V";          .bovnar = "V";      },
  { .code = "KiloV";      .bovnar = "k~V";    },
  { .code = "MilliV";     .bovnar = "m~V";    },
  { .code = "MicroV";     .bovnar = "µ~V";    },
  { .code = "OHM";        .bovnar = "Ω";      },
  { .code = "KiloOHM";    .bovnar = "k~Ω";    },
  { .code = "MegaOHM";    .bovnar = "M~Ω";    },
  { .code = "FARAD";      .bovnar = "F";      },
  { .code = "MicroFARAD"; .bovnar = "µ~F";    },
  { .code = "C";          .bovnar = "C";      },
  { .code = "S";          .bovnar = "S";      },
  { .code = "WB";         .bovnar = "Wb";     },
  { .code = "T";          .bovnar = "T";      },
  { .code = "H";          .bovnar = "H";      },
  { .code = "MilliH";     .bovnar = "m~H";    },
  { .code = "LM";         .bovnar = "lm";     },
  { .code = "LUX";        .bovnar = "lx";     },
  { .code = "BQ";         .bovnar = "Bq";     },
  { .code = "GRAY";       .bovnar = "Gy";     },
  { .code = "SV";         .bovnar = "Sv";     },
  { .code = "KAT";        .bovnar = "kat";    },

  # Pressure and energy, non-SI
  { .code = "BAR";        .bovnar = "bar";    },
  { .code = "MilliBAR";   .bovnar = "m~bar";  },
  { .code = "ATM";        .bovnar = "atm";    },
  { .code = "PSI";        .bovnar = "psi";    },
  { .code = "TORR";       .bovnar = "Torr";   },
  { .code = "MilliM_HG";  .bovnar = "mmHg";   },
  { .code = "EV";         .bovnar = "eV";     },
  { .code = "ERG";        .bovnar = "erg";    },
  # The qualified codes only. QUDT carries CAL_TH (4.184 J) and CAL_IT
  # (4.1868), and BTU_IT beside four other BTUs; native cal is the
  # thermochemical one and native Btu the IT one, so those are the two that
  # map. There is no unqualified "CAL" or "BTU" in QUDT to map anyway.
  { .code = "CAL_TH";     .bovnar = "cal";    },
  { .code = "BTU_IT";     .bovnar = "Btu";    },
  { .code = "W-HR";       .bovnar = "W·h";    },
  { .code = "KiloW-HR";   .bovnar = "k~W·h";  },
  { .code = "MegaW-HR";   .bovnar = "M~W·h";  },

  # Compounds: the "-PER-" and exponent conventions
  { .code = "M-PER-SEC";      .bovnar = "m/s";     },
  { .code = "M-PER-SEC2";     .bovnar = "m/s^2";   },
  { .code = "KiloM-PER-HR";   .bovnar = "k~m/h";   },
  { .code = "MI-PER-HR";      .bovnar = "mph";     },
  { .code = "KN";             .bovnar = "kn";      },
  { .code = "KiloGM-PER-M3";  .bovnar = "k~g/m^3"; },
  { .code = "GM-PER-CentiM3"; .bovnar = "g/c~m^3"; },
  { .code = "MOL-PER-L";      .bovnar = "mol/L";   },
  { .code = "N-M";            .bovnar = "N·m";     },
  # rev/min, NOT rpm. QUDT's REV-PER-MIN is an ANGULAR VELOCITY: its
  # multiplier is 2π/60, one revolution being 2π radians -- which is what
  # native rev is too. Native rpm counts revolutions instead, 1/60 s⁻¹, so
  # mapping to it read every QUDT rotational speed 2π times too small while
  # remaining dimensionally perfect.
  { .code = "REV-PER-MIN";    .bovnar = "rev/min"; },

  # Angle and ratio
  { .code = "RAD";        .bovnar = "rad";    },
  { .code = "SR";         .bovnar = "sr";     },
  { .code = "DEG";        .bovnar = "°";      },
  { .code = "GRAD";       .bovnar = "grad";   },
  { .code = "ARCMIN";     .bovnar = "arcmin"; },
  { .code = "ARCSEC";     .bovnar = "arcsec"; },
  { .code = "PERCENT";    .bovnar = "%";      },
  { .code = "PPM";        .bovnar = "ppm";    },
  { .code = "PPB";        .bovnar = "ppb";    },
  { .code = "PH";         .bovnar = "pH";     },
  { .code = "DeciB";      .bovnar = "dB";     },   # not DECIBEL
  { .code = "NP";         .bovnar = "Np";     },   # not NEPER

  # Information. QUDT keeps the decimal and binary families apart, and so does
  # bovnar: KiloBYTE is 10^3 bytes and KibiBYTE is 2^10.
  { .code = "BIT";        .bovnar = "b";      },
  { .code = "BYTE";       .bovnar = "B";      },
  { .code = "KiloBYTE";   .bovnar = "k~B";    },
  { .code = "MegaBYTE";   .bovnar = "M~B";    },
  { .code = "GigaBYTE";   .bovnar = "G~B";    },
  { .code = "TeraBYTE";   .bovnar = "T~B";    },
  { .code = "KibiBYTE";   .bovnar = "Ki~B";   },
  { .code = "MebiBYTE";   .bovnar = "Mi~B";   },
  { .code = "GibiBYTE";   .bovnar = "Gi~B";   },
  { .code = "TebiBYTE";   .bovnar = "Ti~B";   },

  # ── Synchronisation with the other profiles ──────────────────────────────
  # Every row below names a unit QUDT defines, that bovnar carries natively,
  # and that ucum.bvnr, udunits.bvnr and unece.bvnr already mapped while this
  # table did not: 56 of them, which made qudt the least complete of the five
  # against its own vocabulary. Found by check_profile_factors.py and chosen the
  # same way the unece block was -- by QUDT's own rdfs:label, never by the
  # number alone, because dimensions collapse and a value-only match proposed
  # the lux for a luminance, the rem for the rad, and the watt for both the
  # volt-ampere and the var.

  # Length
  { .code = "FUR";        .bovnar = "fur";    },
  { .code = "FATH";       .bovnar = "fath";   },
  { .code = "CH";         .bovnar = "ch";     },
  { .code = "FT_US";      .bovnar = "ftUS";   },
  { .code = "MilliIN";    .bovnar = "thou";   },
  { .code = "MilLength";  .bovnar = "thou";   },

  # Mass
  { .code = "LB_M";       .bovnar = "lb";     },
  { .code = "OZ_M";       .bovnar = "oz";     },
  { .code = "Stone_UK";   .bovnar = "st";     },
  { .code = "TON";        .bovnar = "tn_sh";  },
  { .code = "TON_US";     .bovnar = "tn_sh";  },
  { .code = "TON_UK";     .bovnar = "tn_l";   },
  { .code = "TONNE";      .bovnar = "t";      },
  { .code = "MegaGM";     .bovnar = "t";      },
  { .code = "DWT";        .bovnar = "dwt";    },
  { .code = "PENNYWEIGHT"; .bovnar = "dwt";   },
  { .code = "SLUG";       .bovnar = "slug";   },
  { .code = "DeciTONNE";  .bovnar = "qntl";   },   # a tenth of a tonne
  { .code = "DeciTON_Metric"; .bovnar = "qntl"; },
  { .code = "AMU";        .bovnar = "Da";     },
  { .code = "DA";         .bovnar = "Da";     },

  # Volume
  { .code = "GAL_US";     .bovnar = "gal";      },
  { .code = "GAL_UK";     .bovnar = "gal_uk";   },
  { .code = "GAL_IMP";    .bovnar = "gal_uk";   },
  { .code = "QT_US";      .bovnar = "qt";       },
  { .code = "QT_UK";      .bovnar = "qt_uk";    },
  { .code = "PINT_US";    .bovnar = "pt";       },
  { .code = "PINT_UK";    .bovnar = "pt_uk";    },
  { .code = "PINT";       .bovnar = "pt_uk";    },   # QUDT's PINT is imperial
  { .code = "CUP";        .bovnar = "cup";      },
  { .code = "CUP_US";     .bovnar = "cup";      },
  { .code = "GI_US";      .bovnar = "gi";       },
  { .code = "GI_UK";      .bovnar = "gi_uk";    },
  { .code = "OZ_VOL_US";  .bovnar = "fl_oz";    },
  { .code = "OZ_VOL_UK";  .bovnar = "fl_oz_uk"; },
  { .code = "TBSP";       .bovnar = "tbsp";     },
  { .code = "TSP";        .bovnar = "tsp";      },
  { .code = "PK_US_DRY";  .bovnar = "pk";       },
  { .code = "BU_US";      .bovnar = "bsh";      },
  { .code = "BU_US_DRY";  .bovnar = "bsh";      },
  { .code = "BBL_US";     .bovnar = "bbl";      },
  { .code = "BBL_US_PET"; .bovnar = "bbl";      },

  # Force, pressure, energy, power
  { .code = "LB_F";       .bovnar = "lbf";    },
  { .code = "KiloGM_F";   .bovnar = "kgf";    },
  { .code = "KiloPOND";   .bovnar = "kgf";    },
  { .code = "KIP_F";      .bovnar = "kip";    },
  { .code = "KiloLB_F";   .bovnar = "kip";    },
  { .code = "DYN";        .bovnar = "dyn";    },
  { .code = "G";          .bovnar = "gn";     },   # QUDT's G is standard gravity
  { .code = "ATM_T";      .bovnar = "at";     },
  { .code = "IN_HG";      .bovnar = "inHg";   },
  { .code = "HP";         .bovnar = "hp";     },
  { .code = "HP_Metric";  .bovnar = "PS";     },
  { .code = "THM_US";     .bovnar = "thm";    },
  { .code = "FT-LB_F";    .bovnar = "ft_lb";  },
  { .code = "LB_F-FT";    .bovnar = "ft_lb";  },
  # Apparent and reactive power are NOT the watt. doc/07 §12 keeps all three
  # apart and a value-only match had proposed W for both of these.
  { .code = "V-A";          .bovnar = "VA";   },
  { .code = "V-A_Reactive"; .bovnar = "var";  },

  # Electricity and magnetism
  { .code = "GAUSS";      .bovnar = "G";      },   # native G is the gauss
  { .code = "Gs";         .bovnar = "G";      },
  { .code = "MX";         .bovnar = "Mx";     },
  { .code = "OERSTED";    .bovnar = "Oe";     },
  { .code = "MHO";        .bovnar = "S";      },

  # Radioactivity and dose
  { .code = "CI";         .bovnar = "Ci";     },
  { .code = "R";          .bovnar = "R";      },
  { .code = "REM";        .bovnar = "rem";    },
  { .code = "R_man";      .bovnar = "rem";    },
  # RAD_R is the RAD, the absorbed dose -- 0.01 Gy, not 0.01 Sv. The two are
  # numerically equal and semantically not, which is the whole of doc/07 §12.
  { .code = "RAD_R";      .bovnar = "c~Gy";   },
  { .code = "CentiGRAY";  .bovnar = "c~Gy";   },

  # Photometry. PHOT and STILB are equal in value and different in kind -- an
  # illuminance against a luminance -- so a value-only match cannot tell them
  # apart and bvn_units_compatible refuses the pair outright.
  { .code = "PHOT";       .bovnar = "ph";      },
  { .code = "STILB";      .bovnar = "sb";      },
  { .code = "LM-PER-M2";  .bovnar = "lx";      },
  { .code = "CD-PER-M2";  .bovnar = "cd/m^2";  },   # a LUMINANCE, not the lux

  # Viscosity, acceleration, textile, area
  { .code = "POISE";             .bovnar = "P";    },
  { .code = "GM-PER-CentiM-SEC"; .bovnar = "P";    },
  { .code = "ST";                .bovnar = "St";   },
  { .code = "CentiM2-PER-SEC";   .bovnar = "St";   },
  { .code = "GALILEO";           .bovnar = "Gal";  },
  { .code = "CentiM-PER-SEC2";   .bovnar = "Gal";  },
  { .code = "TEX";               .bovnar = "tex";  },
  { .code = "GM-PER-KiloM";      .bovnar = "tex";  },
  { .code = "MilliGM-PER-M";     .bovnar = "tex";  },
  { .code = "BARN";              .bovnar = "barn"; },

  # Angle and rotation
  { .code = "GON";        .bovnar = "grad";   },
  { .code = "REV";        .bovnar = "rev";    },
  { .code = "PER-MIN";    .bovnar = "rpm";    },   # reciprocal minute
];

# QUDT's units all map onto native ones or are refused; nothing here is
# assay-defined the way UCUM's arbitrary atoms are, so this profile contributes
# no opaque units at all. The empty list is deliberate and is what tells
# gen_profiles.py the profile owns no sub-range of the block.
.opaque = [];

.unsupported = [
  # Dimensionless "units" that are not quantities. QUDT uses these as the object
  # of a hasUnit assertion where the value genuinely has no unit; bovnar spells
  # that by omitting the unit, and translating them to the unity would make a
  # bare count compare equal to a percentage.
  { .code = "UNITLESS"; .why = "the absence of a unit — write no unit at all"; },
  { .code = "NUM";      .why = "a bare count — write no unit at all"; },

  # QUDT's MO is the SYNODAL month -- 2551442.976 s, 29.53 days, the lunar
  # cycle -- while native mo is a twelfth of the Julian year, 2629800 s. Three
  # per cent apart, dimensionally identical, and it was mapped straight onto mo.
  # Same shape as UDUNITS' tropical year (doc/11 §13.3); bovnar has no synodal
  # month to map it to.
  { .code = "MO";       .why = "the synodal (lunar) month, 29.53 days; native mo is a twelfth of the Julian year"; },

  # Currency. Bovnar has ISO 4217 natively with minor-unit metadata, written
  # with the mandatory $ sigil, and a currency is not a physical unit.
  { .code = "USD";      .why = "a currency — write $USD, which carries minor-unit metadata"; },
  { .code = "EUR";      .why = "a currency — write $EUR, which carries minor-unit metadata"; },

  # Units whose QUDT definition carries a reference this profile cannot state.
  { .code = "DECIBEL_M";  .why = "dBm — dB carries no reference level"; },
  { .code = "DECIBEL_W";  .why = "dBW — dB carries no reference level"; },
  { .code = "DECIBEL_V";  .why = "dBV — dB carries no reference level"; },
];
