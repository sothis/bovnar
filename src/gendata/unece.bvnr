#!bovnar 1.1
# unece.bvnr — single source of truth for the UNECE unit profile.
#
# HOW THIS WORKS
#   Hand-edited. gen_profiles.py (at the repo root) regenerates the C profile
#   tables from this file on every build; never edit the generated *.gen.{h,inc}.
#   To add or change a code, edit a record below and rebuild.
#
# WHAT THIS VOCABULARY IS
#   UN/ECE Recommendation 20, "Codes for Units of Measure Used in International
#   Trade", and Recommendation 21, "Codes for Passengers, Types of Cargo,
#   Packages and Packaging Materials". They are the unit code list of UN/EDIFACT,
#   UBL, Peppol/EN 16931, ISO 20022 and OPC UA's EUInformation, which is why the
#   profile exists: a producer whose unit arrives as "KGM" should not have to
#   translate it before it can be written down.
#
#   A FLAT profile (see the grammar note in bovnar_profiles.c). A Rec 20 code is
#   ONE WHOLE TOKEN and never decomposes: "KGM" is the kilogram, not a kilo
#   applied to a "GM", and "MTS" is the metre per second, not a mega-TS. There
#   are no operators, no exponents and no prefixes in this namespace at all.
#
# PROVENANCE — READ THIS BEFORE TRUSTING A ROW
#   The .bovnar target of every row is checked against this build's native
#   registry by gen_profiles.py, and the resulting translation is pinned by
#   tests/bovnar_unece_test.c. NEITHER of those checks the UNECE side: nothing in
#   this repository verifies that "KGM" is really UNECE's kilogram rather than
#   something this table asserts it to be. That gap is the same standing risk
#   doc/11 section 10.2 records for the UCUM table, and it is why this list is
#   deliberately a CONFIDENT SUBSET of Rec 20 rather than a transcription of all
#   of it: a code that is not here fails loudly as error_unit_illegal, which
#   costs a producer an error message, while a code that is here and wrong costs
#   them a wrong number.
#
#   When in doubt an entry goes in .unsupported, or is left out entirely.
#
# WHAT IS DELIBERATELY ABSENT
#   Rec 20's Annex II/III "level" and sector qualifiers. The X-prefixed Rec 21
#   codes that name packaging MATERIAL rather than a countable package. Every
#   code whose value this file cannot state exactly.
#
# SOURCE, VERSION AND LICENSING
#   Vocabulary  UN/CEFACT Recommendation No. 20, "Codes for Units of Measure
#               Used in International Trade", and Recommendation No. 21
#   Reached via QUDT 3.1.0's qudt:uneceCommonCode cross-reference. NO UNECE
#               ARTEFACT WAS READ: Rec 20 states its factors in prose, so there
#               is nothing machine-readable to resolve, and every code here came
#               through QUDT (retrieved 2026-07-30) and is checked against it
#   Publisher   United Nations Economic Commission for Europe / UN/CEFACT --
#               neither endorses this project
#   Licence     the EXTRACTION is from QUDT, under CC BY 4.0; what is UNECE's
#               here is the codes themselves. The generic UN website terms would
#               permit only personal, non-commercial use, which is plainly not
#               aimed at a code list published to be implemented -- the
#               operative instrument is the UN/CEFACT IPR Policy
#   Taken       UN/ECE common codes, and the conventional NAME of the unit in
#               a trailing comment on most rows -- a three-letter code is
#               unreadable without one, and unreviewable too. No Rec 20
#               definition, conversion or explanatory text
#   Modified    yes -- a subset, mapped onto bovnar's native unit registry
#
#   THIRD_PARTY_NOTICES.md carries the attribution and records the request for
#   written confirmation of the reuse terms.

.schema_version = <uint:16> 1;

# ── Rec 20: codes that translate onto the native registry ───────────────────
# .code is the UNECE common code, .bovnar a native unit expression parsed by
# bvn_parse_unit at table build time. There is no .metric field: a flat profile
# has no prefix mechanism, so a prefixed unit is spelled by its own code (MMT is
# the millimetre; there is no "m" to put in front of "MTR").
.mapped = [
  # Length
  { .code = "MTR"; .bovnar = "m";      },
  { .code = "DMT"; .bovnar = "d~m";    },
  { .code = "CMT"; .bovnar = "c~m";    },
  { .code = "MMT"; .bovnar = "m~m";    },
  { .code = "KMT"; .bovnar = "k~m";    },
  { .code = "INH"; .bovnar = "in";     },
  { .code = "FOT"; .bovnar = "ft";     },
  { .code = "YRD"; .bovnar = "yd";     },
  { .code = "SMI"; .bovnar = "mi";     },   # statute mile
  { .code = "NMI"; .bovnar = "nmi";    },

  # Area
  { .code = "MTK"; .bovnar = "m^2";    },
  { .code = "DMK"; .bovnar = "d~m^2";  },
  { .code = "CMK"; .bovnar = "c~m^2";  },
  { .code = "MMK"; .bovnar = "m~m^2";  },
  { .code = "KMK"; .bovnar = "k~m^2";  },
  { .code = "INK"; .bovnar = "in^2";   },
  { .code = "FTK"; .bovnar = "ft^2";   },
  { .code = "YDK"; .bovnar = "yd^2";   },
  { .code = "ACR"; .bovnar = "ac";     },
  { .code = "HAR"; .bovnar = "ha";     },

  # Volume
  { .code = "MTQ"; .bovnar = "m^3";    },
  { .code = "DMQ"; .bovnar = "d~m^3";  },
  { .code = "CMQ"; .bovnar = "c~m^3";  },
  { .code = "MMQ"; .bovnar = "m~m^3";  },
  { .code = "LTR"; .bovnar = "L";      },
  { .code = "MLT"; .bovnar = "m~L";    },
  { .code = "CLT"; .bovnar = "c~L";    },
  { .code = "DLT"; .bovnar = "d~L";    },
  { .code = "HLT"; .bovnar = "h~L";    },
  { .code = "INQ"; .bovnar = "in^3";   },
  { .code = "FTQ"; .bovnar = "ft^3";   },
  { .code = "YDQ"; .bovnar = "yd^3";   },
  { .code = "GLL"; .bovnar = "gal";    },   # US gallon
  { .code = "GLI"; .bovnar = "gal_uk"; },
  { .code = "BLL"; .bovnar = "bbl";    },   # barrel, US petroleum

  # Mass
  { .code = "KGM"; .bovnar = "k~g";    },
  { .code = "GRM"; .bovnar = "g";      },
  { .code = "DG";  .bovnar = "d~g";    },
  { .code = "CGM"; .bovnar = "c~g";    },
  { .code = "MGM"; .bovnar = "m~g";    },
  { .code = "MC";  .bovnar = "µ~g";    },   # microgram
  { .code = "TNE"; .bovnar = "t";      },   # tonne, metric
  { .code = "DTN"; .bovnar = "qntl";   },   # decitonne = quintal, 100 kg
  { .code = "LBR"; .bovnar = "lb";     },
  { .code = "ONZ"; .bovnar = "oz";     },
  { .code = "APZ"; .bovnar = "oz_t";   },   # troy ounce
  { .code = "GRN"; .bovnar = "gr";     },   # grain
  { .code = "STI"; .bovnar = "st";     },   # stone, UK
  { .code = "STN"; .bovnar = "tn_sh";  },   # short ton, US
  { .code = "LTN"; .bovnar = "tn_l";   },   # long ton, UK
  { .code = "CTM"; .bovnar = "ct";     },   # metric carat

  # Time
  { .code = "SEC"; .bovnar = "s";      },
  { .code = "MIN"; .bovnar = "min";    },
  { .code = "HUR"; .bovnar = "h";      },
  { .code = "DAY"; .bovnar = "d";      },
  { .code = "WEE"; .bovnar = "wk";     },
  { .code = "MON"; .bovnar = "mo";     },
  { .code = "ANN"; .bovnar = "yr";     },

  # Temperature. The native affine discipline applies unchanged: valid at
  # exponent 1 only, and a compound containing one yields no conversion value.
  { .code = "KEL"; .bovnar = "K";      },
  { .code = "CEL"; .bovnar = "°C";     },
  { .code = "FAH"; .bovnar = "°F";     },

  # Amount of substance, light
  { .code = "MOL"; .bovnar = "mol";    },
  { .code = "CDL"; .bovnar = "cd";     },
  { .code = "LUM"; .bovnar = "lm";     },
  { .code = "LUX"; .bovnar = "lx";     },

  # Force, pressure
  { .code = "NEW"; .bovnar = "N";      },
  { .code = "PAL"; .bovnar = "Pa";     },
  { .code = "KPA"; .bovnar = "k~Pa";   },
  { .code = "MPA"; .bovnar = "M~Pa";   },
  { .code = "BAR"; .bovnar = "bar";    },
  { .code = "MBR"; .bovnar = "m~bar";  },   # millibar
  { .code = "ATM"; .bovnar = "atm";    },   # standard atmosphere

  # Energy, power
  { .code = "JOU"; .bovnar = "J";      },
  { .code = "KJO"; .bovnar = "k~J";    },
  { .code = "WTT"; .bovnar = "W";      },
  { .code = "KWT"; .bovnar = "k~W";    },
  { .code = "MAW"; .bovnar = "M~W";    },
  { .code = "WHR"; .bovnar = "W·h";    },   # watt hour
  { .code = "KWH"; .bovnar = "k~W·h";  },
  { .code = "MWH"; .bovnar = "M~W·h";  },
  { .code = "BTU"; .bovnar = "Btu";    },

  # ── Thermochemical BTU, IT calorie, water column, long hundredweight ──
  #
  # Twenty-six codes that were refused only because the native registry had no
  # unit to land them on. Reached, like everything else in this file, through
  # QUDT's uneceCommonCode cross-reference, and each one checked against the
  # value that cross-reference gives.
  #
  # DEG_F here is a temperature INTERVAL -- a thermal resistance is per degree
  # of rise -- so it is Δ°F, which is linear and may stand inside a product.
  { .code = "CWI";.bovnar = "cwt_l"; },   # long hundredweight (112 lb)
  { .code = "D70";.bovnar = "cal_IT"; },   # calorie (international table)
  { .code = "E14";.bovnar = "k~cal_IT"; },   # kilocalorie (international table)
  { .code = "UA";.bovnar = "Torr"; },   # torr

  { .code = "D71";.bovnar = "cal_IT/(s·c~m·K)";  .reverse = false; },   # cal_IT per second centimetre kelvin
  { .code = "D72";.bovnar = "cal_IT/(s·c~m^2·K)";.reverse = false; },   # cal_IT per second square centimetre kelvin
  { .code = "D75";.bovnar = "cal_IT/g";          .reverse = false; },   # calorie (international table) per gram
  { .code = "J19";.bovnar = "Δ°F·h·ft^2/Btu_th"; .reverse = false; },   # degree Fahrenheit hour square foot per BTU (th)
  { .code = "J46";.bovnar = "Btu_th·ft/(h·ft^2·Δ°F)";.reverse = false; },   # BTU (th) foot per hour square foot degree Fahrenheit
  { .code = "J47";.bovnar = "Btu_th/h";          .reverse = false; },   # BTU (th) per hour
  { .code = "J48";.bovnar = "Btu_th·in/(ft^2·h·Δ°F)";.reverse = false; },   # BTU (th) inch per square foot hour degree Fahrenheit
  { .code = "J51";.bovnar = "Btu_th/min";        .reverse = false; },   # BTU (th) per minute
  { .code = "J52";.bovnar = "Btu_th/s";          .reverse = false; },   # BTU (th) per second
  { .code = "K24";.bovnar = "ft·mH2O/m";         .reverse = false; },   # foot of water column
  { .code = "K52";.bovnar = "k~cal_IT/(h·m·K)";  .reverse = false; },   # kilocalorie (IT) per hour metre degree Celsius
  { .code = "L14";.bovnar = "m^2·h·K/k~cal_IT";  .reverse = false; },   # square metre hour degree Celsius per kilocalorie (IT)
  { .code = "N51";.bovnar = "Btu_th/(ft^2·h)";   .reverse = false; },   # BTU (th) per square foot hour
  { .code = "N54";.bovnar = "Btu_th/(ft^2·s)";   .reverse = false; },   # BTU (th) per square foot second
  { .code = "N59";.bovnar = "Btu_th/ft^3";       .reverse = false; },   # BTU (th) per cubic foot
  { .code = "N61";.bovnar = "Btu_th/Δ°F";        .reverse = false; },   # BTU (th) per degree Fahrenheit
  { .code = "N63";.bovnar = "Btu_th/Δ°Ra";       .reverse = false; },   # BTU (th) per degree Rankine
  { .code = "N75";.bovnar = "Btu_th/(h·ft^2·Δ°F)";.reverse = false; },   # BTU (th) per hour square foot degree Fahrenheit
  { .code = "N85";.bovnar = "Δ°F·h/Btu_th";      .reverse = false; },   # degree Fahrenheit hour per BTU (th)
  { .code = "N87";.bovnar = "Δ°F·s/Btu_th";      .reverse = false; },   # degree Fahrenheit second per BTU (th)
  { .code = "N89";.bovnar = "Δ°F·h·ft^2/(Btu_th·in)";.reverse = false; },   # degree Fahrenheit hour square foot per BTU (th) inch
  { .code = "P38";.bovnar = "Btu_th/ft^2";       .reverse = false; },   # BTU (th) per square foot

  # Electricity and magnetism
  { .code = "AMP"; .bovnar = "A";      },
  { .code = "VLT"; .bovnar = "V";      },
  { .code = "OHM"; .bovnar = "Ω";      },
  { .code = "FAR"; .bovnar = "F";      },
  { .code = "COU"; .bovnar = "C";      },
  { .code = "SIE"; .bovnar = "S";      },
  { .code = "HEN"; .bovnar = "H";      },
  { .code = "WEB"; .bovnar = "Wb";     },
  { .code = "HTZ"; .bovnar = "Hz";     },
  { .code = "KHZ"; .bovnar = "k~Hz";   },
  { .code = "MHZ"; .bovnar = "M~Hz";   },

  # Radioactivity
  { .code = "BQL"; .bovnar = "Bq";     },
  { .code = "CUR"; .bovnar = "Ci";     },
  { .code = "GRY"; .bovnar = "Gy";     },

  # Speed
  { .code = "MTS"; .bovnar = "m/s";    },
  # The target is the COMPOUND, not the native kph atom. Both spell the same
  # quantity, but a named unit and its compound are structurally different
  # (doc/07 §11) and so are not bvn_unit_equal. The compound is what this code
  # has to be: udunits:km/h can only ever parse to the compound, and the
  # cross-vocabulary suite requires every spelling of one concept to agree.
  # The consequence -- <float:64,kph> 1.0 unece:KMH is error_unit_mismatch --
  # is the general named-vs-compound rule, not a quirk of this row.
  { .code = "KMH"; .bovnar = "k~m/h";  },
  { .code = "KNT"; .bovnar = "kn";     },   # knot

  # Angle and ratio
  { .code = "DD";  .bovnar = "°";      },   # degree of angle
  { .code = "P1";  .bovnar = "%";      },   # percent

  # ── Codes reached through QUDT's uneceCommonCode cross-reference ─────────
  # Every row below was found by check_profile_factors.py: its value is exactly
  # a native unit's and the table did not carry it. The VALUE is machine-checked
  # on every run; what is NOT machine-checkable, and what decided which of the
  # 151 candidates landed here, is whether the code MEANS that unit. Dimensions
  # collapse -- D13 (sievert) matched the gray, D44 (var) and D46 (volt-ampere)
  # both matched the watt, NU (newton metre) matched the joule -- so a suggestion
  # accepted on its number alone would have mapped a dose equivalent onto an
  # absorbed dose and a torque onto an energy. Each row was read against QUDT's
  # label for the unit carrying the code.
  #
  # Reached through a SECONDARY source (doc/11 §9.5): QUDT asserting what a Rec
  # 20 code means, not UN/ECE. Wrong here costs a wrong number, so the rule was
  # to leave out anything whose label did not name the unit outright.

  # Length
  { .code = "77";  .bovnar = "thou";   },   # milli-inch
  { .code = "A11"; .bovnar = "Å";      },   # angstrom
  { .code = "A12"; .bovnar = "au";     },   # astronomical unit
  { .code = "B57"; .bovnar = "ly";     },   # light year
  { .code = "C63"; .bovnar = "pc";     },   # parsec
  { .code = "AK";  .bovnar = "fath";   },   # fathom
  { .code = "M50"; .bovnar = "fur";    },   # furlong
  { .code = "M51"; .bovnar = "ftUS";   },   # US survey foot
  { .code = "X1";  .bovnar = "ch";     },   # chain

  # Area, volume
  { .code = "A14"; .bovnar = "barn";   },   # barn
  { .code = "BUA"; .bovnar = "bsh";    },   # bushel (US)
  { .code = "G23"; .bovnar = "pk";     },   # peck (US)
  { .code = "PY";  .bovnar = "pk";     },   # peck (US), second code
  { .code = "G21"; .bovnar = "cup";    },   # cup (US)
  { .code = "G24"; .bovnar = "tbsp";   },   # tablespoon
  { .code = "G25"; .bovnar = "tsp";    },   # teaspoon
  { .code = "GIA"; .bovnar = "gi";     },   # gill (US)
  { .code = "GII"; .bovnar = "gi_uk";  },   # gill (UK)
  { .code = "OZA"; .bovnar = "fl_oz";  },   # fluid ounce (US)
  { .code = "OZI"; .bovnar = "fl_oz_uk"; }, # fluid ounce (UK)
  { .code = "PT";  .bovnar = "pt";     },   # liquid pint (US)
  { .code = "PTL"; .bovnar = "pt";     },   # liquid pint (US), second code
  { .code = "PTI"; .bovnar = "pt_uk";  },   # pint (UK)
  { .code = "QT";  .bovnar = "qt";     },   # liquid quart (US)
  { .code = "QTL"; .bovnar = "qt";     },   # liquid quart (US), second code
  { .code = "QTI"; .bovnar = "qt_uk";  },   # quart (UK)

  # Mass
  { .code = "2U";  .bovnar = "t";      },   # megagram
  { .code = "DWT"; .bovnar = "dwt";    },   # pennyweight
  { .code = "D43"; .bovnar = "Da";     },   # unified atomic mass unit
  { .code = "F13"; .bovnar = "slug";   },   # slug

  # Force, pressure
  { .code = "C78"; .bovnar = "lbf";    },   # pound-force
  { .code = "B37"; .bovnar = "kgf";    },   # kilogram-force
  { .code = "B51"; .bovnar = "kgf";    },   # kilopond, the same unit
  { .code = "M75"; .bovnar = "kip";    },   # kip
  { .code = "DU";  .bovnar = "dyn";    },   # dyne
  { .code = "A58"; .bovnar = "dyn";    },   # erg per centimetre, the same unit
  { .code = "M77"; .bovnar = "N";      },   # kilogram metre per second squared
  { .code = "B12"; .bovnar = "N";      },   # joule per metre
  { .code = "PS";  .bovnar = "psi";    },   # pound-force per square inch
  { .code = "ATT"; .bovnar = "at";     },   # technical atmosphere
  { .code = "E42"; .bovnar = "at";     },   # kilogram-force per square centimetre
  { .code = "HN";  .bovnar = "mmHg";   },   # millimetre of mercury
  { .code = "F79"; .bovnar = "inHg";   },   # inch of mercury
  { .code = "C55"; .bovnar = "Pa";     },   # newton per square metre

  # Energy, power
  { .code = "A53"; .bovnar = "eV";     },   # electronvolt
  { .code = "A57"; .bovnar = "erg";    },   # erg
  { .code = "J94"; .bovnar = "erg";    },   # dyne centimetre, the same unit
  { .code = "D35"; .bovnar = "cal";    },   # thermochemical calorie, which native cal is
  { .code = "N72"; .bovnar = "thm";    },   # therm (US), which native thm is
  { .code = "J55"; .bovnar = "J";      },   # watt second
  { .code = "85";  .bovnar = "ft_lb";  },   # foot pound-force
  { .code = "M92"; .bovnar = "ft_lb";  },   # pound-force foot, the same unit
  { .code = "P14"; .bovnar = "W";      },   # joule per second
  { .code = "HJ";  .bovnar = "PS";     },   # metric horsepower
  # NOT the joule: a newton metre is a torque, and doc/07 §12 keeps the two
  # apart although they share a dimension.
  { .code = "NU";  .bovnar = "N·m";    },   # newton metre

  # Electricity and magnetism
  { .code = "81";  .bovnar = "H";      },   # henry
  { .code = "A8";  .bovnar = "C";      },   # ampere second
  { .code = "D33"; .bovnar = "T";      },   # tesla
  { .code = "F90"; .bovnar = "Wb";     },   # newton metre per ampere
  { .code = "NQ";  .bovnar = "S";      },   # mho
  { .code = "B65"; .bovnar = "Mx";     },   # maxwell
  { .code = "76";  .bovnar = "G";      },   # gauss
  { .code = "66";  .bovnar = "Oe";     },   # oersted
  # Apparent and reactive power are NOT the watt; bovnar carries all three
  # (doc/07 §12) and they share a dimension.
  { .code = "D46"; .bovnar = "VA";     },   # volt-ampere
  { .code = "D44"; .bovnar = "var";    },   # volt-ampere reactive

  # Radioactivity and dose
  { .code = "A95"; .bovnar = "Gy";     },   # gray
  { .code = "D13"; .bovnar = "Sv";     },   # sievert -- NOT the gray
  { .code = "C80"; .bovnar = "c~Gy";   },   # rad, the absorbed dose
  { .code = "D91"; .bovnar = "rem";    },   # rem
  { .code = "2C";  .bovnar = "R";      },   # roentgen

  # Amount, catalytic activity, photometry
  { .code = "C34"; .bovnar = "mol";    },   # mole
  { .code = "KAT"; .bovnar = "kat";    },   # katal
  { .code = "E95"; .bovnar = "kat";    },   # mole per second, the same unit
  { .code = "B60"; .bovnar = "lx";     },   # lumen per square metre
  { .code = "A24"; .bovnar = "cd/m^2"; },   # candela per square metre -- a
                                            # LUMINANCE, not the lux
  { .code = "P26"; .bovnar = "ph";     },   # phot
  { .code = "P31"; .bovnar = "sb";     },   # stilb

  # Viscosity, acceleration, textile
  { .code = "89";  .bovnar = "P";      },   # poise
  { .code = "N41"; .bovnar = "P";      },   # gram per centimetre second
  { .code = "91";  .bovnar = "St";     },   # stokes
  { .code = "M81"; .bovnar = "St";     },   # square centimetre per second
  { .code = "A76"; .bovnar = "Gal";    },   # galileo
  { .code = "M39"; .bovnar = "Gal";    },   # centimetre per square second
  { .code = "K40"; .bovnar = "gn";     },   # standard gravity
  { .code = "D34"; .bovnar = "tex";    },   # tex
  { .code = "C12"; .bovnar = "tex";    },   # milligram per metre, the same unit

  # Speed, rotation, frequency
  { .code = "HM";  .bovnar = "mph";    },   # mile per hour
  { .code = "M44"; .bovnar = "rev";    },   # revolution
  # C94 is the RECIPROCAL MINUTE and M46 the REVOLUTION PER MINUTE, and the two
  # are not the same quantity although C94 and native rpm are both 1/60 s⁻¹.
  # rpm counts revolutions; "reciprocal minute" says nothing about rotation, and
  # C94 mapped onto rpm asserted one. The compounds keep them apart the same way
  # C97 stays off the hertz, and M46 lands on rev/min because native rev is an
  # ANGLE of 2π radians -- which is what Rec 20's revolution per minute is, and
  # is why qudt:REV-PER-MIN maps there too.
  { .code = "C94"; .bovnar = "min^-1"; },   # reciprocal minute
  { .code = "M46"; .bovnar = "rev/min";},   # revolution per minute
  { .code = "C97"; .bovnar = "s^-1";   },   # reciprocal second
  # J38 (baud) is NOT here. QUDT models it as DIMENSIONLESS -- information
  # again, the same modelling difference as the bit and the byte -- while
  # native Bd is a symbol RATE, s⁻¹. The cross-reference cannot confirm
  # this one, so it stays out rather than gaining a waiver written to let
  # it through.

  # Angle. These are the ones a value-only match gets most wrong: an angle is
  # dimensionless, so a radian collides with every pure ratio in the registry.
  # Ratio. Only the two whose label names a generic parts-per unit outright.
  # The dozen codes spelling a ratio of two NAMED units -- mg/kg, mL/L, cm³/m³
  # -- are each worth exactly ppm or ‰ and are deliberately left out: they say
  # a ratio OF WHAT, and collapsing them onto the generic unit loses that in the
  # same way doc/11 §6.3 records for a UCUM annotation.
  { .code = "59";  .bovnar = "ppm";    },   # parts per million
  { .code = "61";  .bovnar = "ppb";    },   # parts per billion

  # ── Information: bits, bytes, their rates and their linear densities ──
  #
  # Fifty-seven of Rec 20's codes, and every one of them used to be refused. AD
  # (byte) and J63 (bit) are among the most-used codes in the whole list, so
  # this was not a gap at the margin. The cause was one number: QUDT, the
  # cross-reference this vocabulary is checked through, models information as
  # ENTROPY and states its bit as ln 2 rather than 1. Every code below is
  # therefore off the native target by exactly ln 2 (or 8·ln 2 for a byte) --
  # the same modelling difference the UCUM and UDUNITS profiles have always
  # waived for their own bit and byte, and no evidence about Rec 20 at all.
  #
  # E86 and E87 (tebibit per square and per cubic metre) are NOT here. The
  # cross-reference attaches them the other way round from the way every other
  # family in this block runs -- Kibi, Mebi, Gibi, Pebi and Exbi all go m, m²,
  # m³ in ascending code order, and Tebi comes out E85, E87, E86. A secondary
  # source contradicting its own pattern is evidence and not proof, so those
  # two stay refused rather than being mapped on a guess.
  { .code = "J63";.bovnar = "b"; },   # bit
  { .code = "AD";.bovnar = "B"; },   # byte
  { .code = "C37";.bovnar = "k~b"; },   # kilobit
  { .code = "D36";.bovnar = "M~b"; },   # megabit
  { .code = "B68";.bovnar = "G~b"; },   # gigabit
  { .code = "E83";.bovnar = "T~b"; },   # terabit
  { .code = "E78";.bovnar = "P~b"; },   # petabit
  { .code = "2P";.bovnar = "k~B"; },   # kilobyte
  { .code = "4L";.bovnar = "M~B"; },   # megabyte
  { .code = "E34";.bovnar = "G~B"; },   # gigabyte
  { .code = "E35";.bovnar = "T~B"; },   # terabyte
  { .code = "E36";.bovnar = "P~B"; },   # petabyte
  { .code = "C21";.bovnar = "Ki~b"; },   # kibibit
  { .code = "D11";.bovnar = "Mi~b"; },   # mebibit
  { .code = "B30";.bovnar = "Gi~b"; },   # gibibit
  { .code = "E64";.bovnar = "Ki~B"; },   # kibibyte
  { .code = "E63";.bovnar = "Mi~B"; },   # mebibyte
  { .code = "E62";.bovnar = "Gi~B"; },   # gibibyte
  { .code = "E61";.bovnar = "Ti~B"; },   # tebibyte
  { .code = "E60";.bovnar = "Pi~B"; },   # pebibyte
  { .code = "E59";.bovnar = "Ei~B"; },   # exbibyte
  { .code = "Q14";.bovnar = "b";         .reverse = false; },   # shannon — the bit under its information-theory name
  { .code = "Q12";.bovnar = "B";         .reverse = false; },   # octet — the byte under its telecoms name

  { .code = "B10";.bovnar = "b/s";       .reverse = false; },   # bit per second
  { .code = "P93";.bovnar = "B/s";       .reverse = false; },   # byte per second
  { .code = "Q13";.bovnar = "B/s";       .reverse = false; },   # octet per second
  { .code = "Q17";.bovnar = "b/s";       .reverse = false; },   # shannon per second
  { .code = "C74";.bovnar = "k~b/s";     .reverse = false; },   # kilobit per second
  { .code = "E20";.bovnar = "M~b/s";     .reverse = false; },   # megabit per second
  { .code = "B80";.bovnar = "G~b/s";     .reverse = false; },   # gigabit per second
  { .code = "E84";.bovnar = "T~b/s";     .reverse = false; },   # terabit per second
  { .code = "E79";.bovnar = "P~b/s";     .reverse = false; },   # petabit per second
  { .code = "E58";.bovnar = "E~b/s";     .reverse = false; },   # exabit per second
  { .code = "P94";.bovnar = "k~B/s";     .reverse = false; },   # kilobyte per second
  { .code = "P95";.bovnar = "M~B/s";     .reverse = false; },   # megabyte per second
  { .code = "E68";.bovnar = "G~B/s";     .reverse = false; },   # gigabyte per second
  { .code = "E88";.bovnar = "b/m";       .reverse = false; },   # bit per metre
  { .code = "E89";.bovnar = "b/m^2";     .reverse = false; },   # bit per square metre
  { .code = "E72";.bovnar = "Ki~b/m";    .reverse = false; },   # kibibit per metre
  { .code = "E73";.bovnar = "Ki~b/m^2";  .reverse = false; },   # kibibit per square metre
  { .code = "E74";.bovnar = "Ki~b/m^3";  .reverse = false; },   # kibibit per cubic metre
  { .code = "E75";.bovnar = "Mi~b/m";    .reverse = false; },   # mebibit per metre
  { .code = "E76";.bovnar = "Mi~b/m^2";  .reverse = false; },   # mebibit per square metre
  { .code = "E77";.bovnar = "Mi~b/m^3";  .reverse = false; },   # mebibit per cubic metre
  { .code = "E69";.bovnar = "Gi~b/m";    .reverse = false; },   # gibibit per metre
  { .code = "E70";.bovnar = "Gi~b/m^2";  .reverse = false; },   # gibibit per square metre
  { .code = "E71";.bovnar = "Gi~b/m^3";  .reverse = false; },   # gibibit per cubic metre
  { .code = "E85";.bovnar = "Ti~b/m";    .reverse = false; },   # tebibit per metre
  { .code = "E80";.bovnar = "Pi~b/m";    .reverse = false; },   # pebibit per metre
  { .code = "E81";.bovnar = "Pi~b/m^2";  .reverse = false; },   # pebibit per square metre
  { .code = "E82";.bovnar = "Pi~b/m^3";  .reverse = false; },   # pebibit per cubic metre
  { .code = "E65";.bovnar = "Ei~b/m";    .reverse = false; },   # exbibit per metre
  { .code = "E66";.bovnar = "Ei~b/m^2";  .reverse = false; },   # exbibit per square metre
  { .code = "E67";.bovnar = "Ei~b/m^3";  .reverse = false; },   # exbibit per cubic metre

  { .code = "C81"; .bovnar = "rad";    },   # radian
  { .code = "D27"; .bovnar = "sr";     },   # steradian
  { .code = "A91"; .bovnar = "grad";   },   # gon
  { .code = "D61"; .bovnar = "arcmin"; },   # minute of angle
  { .code = "D62"; .bovnar = "arcsec"; },   # second of angle
  { .code = "A48"; .bovnar = "°Ra";    },   # degree Rankine
  { .code = "2A";  .bovnar = "rad/s";  },   # radian per second
  { .code = "C25"; .bovnar = "m~rad";  },   # milliradian
  { .code = "B97"; .bovnar = "µ~rad";  },   # microradian

  # ── Codes worth a PREFIXED or COMPOUND unit ──────────────────────────────
  # A second synchronisation pass, and it exists because the first one could not
  # see any of this. check_profile_factors.py matched a publisher's code against
  # the native registry's SYMBOLS, so it could only ever propose a code worth a
  # bare atom -- and a flat vocabulary spells every prefixed and every compound
  # unit as one whole token. A97 is the hectopascal, KMQ the kilogram per cubic
  # metre, MSK the metre per square second: none of them is a native symbol, and
  # all of them were carried by qudt.bvnr while this table had no code for them.
  # The index now also holds every target the five tables already use, which is
  # what turned that class of gap from invisible into a printed list.
  #
  # Same rule as the block above: QUDT's rdfs:label for the unit carrying the
  # code, never the number. The number is what proposed the WATT for KVA and MVA
  # -- apparent power is not active power (doc/07 §12) -- and the HERTZ for the
  # three becquerel codes.

  # Length, time, and the reciprocals
  { .code = "HMT"; .bovnar = "h~m";     },   # hectometre
  { .code = "4H";  .bovnar = "µ~m";     },   # micrometre
  { .code = "C45"; .bovnar = "n~m";     },   # nanometre
  { .code = "C52"; .bovnar = "p~m";     },   # picometre
  { .code = "B98"; .bovnar = "µ~s";     },   # microsecond
  { .code = "C47"; .bovnar = "n~s";     },   # nanosecond
  { .code = "H70"; .bovnar = "p~s";     },   # picosecond
  # Both are the reciprocal metre and only C92 says so, so C92 leads -- which
  # costs nothing here (an exponent makes the target a compound, and a compound
  # has no flat spelling to write back at all) and keeps the ordering rule the
  # rest of this file relies on true everywhere rather than only where it bites.
  { .code = "C92"; .bovnar = "m^-1";    },   # reciprocal metre
  { .code = "Q25"; .bovnar = "m^-1";    },   # dioptre, exactly the same unit
  { .code = "E90"; .bovnar = "c~m^-1";  },   # reciprocal centimetre, the kayser

  # Area, volume, density
  { .code = "ARE"; .bovnar = "c~ha";    },   # are
  { .code = "4G";  .bovnar = "µ~L";     },   # microlitre
  { .code = "KMQ"; .bovnar = "k~g/m^3"; },   # kilogram per cubic metre
  { .code = "23";  .bovnar = "g/c~m^3"; },   # gram per cubic centimetre

  # Electricity and magnetism
  { .code = "KVT"; .bovnar = "k~V";     },   # kilovolt
  { .code = "2Z";  .bovnar = "m~V";     },   # millivolt
  { .code = "D82"; .bovnar = "µ~V";     },   # microvolt
  { .code = "B22"; .bovnar = "k~A";     },   # kiloampere
  { .code = "4K";  .bovnar = "m~A";     },   # milliampere
  { .code = "B84"; .bovnar = "µ~A";     },   # microampere
  { .code = "B49"; .bovnar = "k~Ω";     },   # kilohm
  { .code = "B75"; .bovnar = "M~Ω";     },   # megohm
  { .code = "4O";  .bovnar = "µ~F";     },   # microfarad
  { .code = "C14"; .bovnar = "m~H";     },   # millihenry
  { .code = "A86"; .bovnar = "G~Hz";    },   # gigahertz
  # Apparent and reactive power, prefixed. The kVA is the commonest unit in this
  # whole vocabulary and had no code here at all.
  { .code = "KVA"; .bovnar = "k~VA";    },   # kilovolt-ampere
  { .code = "MVA"; .bovnar = "M~VA";    },   # megavolt-ampere
  { .code = "KVR"; .bovnar = "k~var";   },   # kilovar
  { .code = "MAR"; .bovnar = "M~var";   },   # megavar

  # Force, pressure, energy, power
  { .code = "B47"; .bovnar = "k~N";     },   # kilonewton
  { .code = "M78"; .bovnar = "g·gn";    },   # pond, i.e. the gram-force
  { .code = "A97"; .bovnar = "h~Pa";    },   # hectopascal
  { .code = "3B";  .bovnar = "M~J";     },   # megajoule
  { .code = "K53"; .bovnar = "k~cal";   },   # kilocalorie
  { .code = "C31"; .bovnar = "m~W";     },   # milliwatt

  # Radioactivity. NOT the hertz: an activity is not a frequency (doc/07 §9),
  # and the two share a dimension and a factor exactly.
  { .code = "2Q";  .bovnar = "k~Bq";    },   # kilobecquerel
  { .code = "4N";  .bovnar = "M~Bq";    },   # megabecquerel
  { .code = "GBQ"; .bovnar = "G~Bq";    },   # gigabecquerel

  # Amount of substance
  { .code = "C18"; .bovnar = "m~mol";   },   # millimole
  { .code = "C36"; .bovnar = "mol/m^3"; },   # mole per cubic metre
  { .code = "C38"; .bovnar = "mol/L";   },   # mole per litre

  # Mechanics and thermodynamics. Every target here is the coherent SI unit of a
  # kind qudt-qk.bvnr already carries, and no unit namespace could spell it.
  { .code = "MSK"; .bovnar = "m/s^2";   },   # metre per second squared
  { .code = "MQS"; .bovnar = "m^3/s";   },   # cubic metre per second
  { .code = "KGS"; .bovnar = "k~g/s";   },   # kilogram per second
  { .code = "S4";  .bovnar = "m^2/s";   },   # square metre per second
  { .code = "B31"; .bovnar = "k~g·m/s"; },   # kilogram metre per second
  { .code = "C65"; .bovnar = "Pa·s";    },   # pascal second
  { .code = "JE";  .bovnar = "J/K";     },   # joule per kelvin
  { .code = "B11"; .bovnar = "J·k~g^-1·K^-1"; },  # joule per kilogram kelvin
  { .code = "D53"; .bovnar = "W·m^-1·K^-1";   },  # watt per metre kelvin

  # ── Closing the table against QUDT's Rec 20 cross-reference ──────────────
  #
  # WHAT "CLOSED" MEANS HERE, AND WHAT IT DOES NOT. Rec 20 states its factors in
  # prose, so unlike the other four vocabularies there is no publication this
  # repository can enumerate. The reachable set is every Rec 20 code that some
  # QUDT unit claims with `qudt:uneceCommonCode` -- and a code no QUDT unit
  # mentions is still outside this table, because nothing here can say what it
  # is worth. That is the same limit §11.1 and check_profile_factors.py's
  # `class Unece` already state; closing the table does not lift it.
  #
  # Each row below carries the native target its claiming QUDT unit already
  # maps to, named in the comment. So a UNECE row is never better evidenced
  # than the QUDT row behind it, which is the truth about this vocabulary, and
  # the two tables agree by construction rather than by coincidence.
  #
  # .reverse = false except where the slot had no writer at all; a completion
  # pass should not restyle what bovnar already emits.
  { .code = "22";    .bovnar = "d~L/g";               .reverse = false; },  # via qudt:DeciL-PER-GM
  { .code = "25";    .bovnar = "g/c~m^2";             .reverse = false; },  # via qudt:GM-PER-CentiM2
  { .code = "28";    .bovnar = "k~g/m^2";             .reverse = false; },  # via qudt:KiloGM-PER-M2
  { .code = "2B";    .bovnar = "rad/s^2";             .reverse = false; },  # via qudt:RAD-PER-SEC2
  { .code = "2I";    .bovnar = "Btu/h";               .reverse = false; },  # via qudt:BTU_IT-PER-HR
  { .code = "2J";    .bovnar = "c~m^3/s";             .reverse = false; },  # via qudt:CentiM3-PER-SEC
  { .code = "2K";    .bovnar = "ft^3/h";              .reverse = false; },  # via qudt:FT3-PER-HR
  { .code = "2L";    .bovnar = "ft^3/min";            .reverse = false; },  # via qudt:FT3-PER-MIN
  { .code = "2M";    .bovnar = "c~m/s";               .reverse = false; },  # via qudt:CentiM-PER-SEC
  { .code = "2R";    .bovnar = "k~Ci";                },  # via qudt:KiloCi
  { .code = "2X";    .bovnar = "m/min";               .reverse = false; },  # via qudt:M-PER-MIN
  { .code = "2Y";    .bovnar = "m~R";                 },  # via qudt:MilliR
  { .code = "33";    .bovnar = "k~Pa·m^2/g";          .reverse = false; },  # via qudt:KiloPA-M2-PER-GM
  { .code = "34";    .bovnar = "k~Pa/m~m";            .reverse = false; },  # via qudt:KiloPA-PER-MilliM
  { .code = "36";    .bovnar = "ft^3/min·ft^2";       .reverse = false; },  # via qudt:FT3-PER-MIN-FT2
  { .code = "37";    .bovnar = "oz/ft^2";             .reverse = false; },  # via qudt:OZ-PER-FT2
  { .code = "3H";    .bovnar = "k~g/k~g";             .reverse = false; },  # via qudt:KiloGM-PER-KiloGM
  { .code = "40";    .bovnar = "m~L/s";               .reverse = false; },  # via qudt:MilliL-PER-SEC
  { .code = "41";    .bovnar = "m~L/min";             .reverse = false; },  # via qudt:MilliL-PER-MIN
  { .code = "4C";    .bovnar = "c~St";                },  # via qudt:CentiST
  { .code = "4M";    .bovnar = "m~g/h";               .reverse = false; },  # via qudt:MilliGM-PER-HR
  { .code = "4P";    .bovnar = "N/m";                 .reverse = false; },  # via qudt:N-PER-M
  { .code = "4Q";    .bovnar = "oz·in";               .reverse = false; },  # via qudt:OZ-IN
  { .code = "4T";    .bovnar = "p~F";                 },  # via qudt:PicoFARAD
  { .code = "4U";    .bovnar = "lb/h";                .reverse = false; },  # via qudt:LB-PER-HR
  { .code = "4X";    .bovnar = "k~L/h";               .reverse = false; },  # via qudt:KiloL-PER-HR
  { .code = "74";    .bovnar = "m~Pa";                },  # via qudt:MilliPA
  { .code = "78";    .bovnar = "k~G";                 },  # via qudt:KiloGAUSS
  { .code = "80";    .bovnar = "lb/in^2";             .reverse = false; },  # via qudt:LB-PER-IN2
  { .code = "84";    .bovnar = "k~lbf/in^2";          .reverse = false; },  # via qudt:KiloLB_F-PER-IN2
  { .code = "87";    .bovnar = "lb/ft^3";             .reverse = false; },  # via qudt:LB-PER-FT3
  { .code = "A10";   .bovnar = "A·m^2/J·s";           .reverse = false; },  # via qudt:A-M2-PER-J-SEC
  { .code = "A13";   .bovnar = "a~J";                 },  # via qudt:AttoJ
  { .code = "A15";   .bovnar = "barn/eV";             .reverse = false; },  # via qudt:BARN-PER-EV
  { .code = "A16";   .bovnar = "barn/sr·eV";          .reverse = false; },  # via qudt:BARN-PER-SR-EV
  { .code = "A17";   .bovnar = "barn/sr";             .reverse = false; },  # via qudt:BARN-PER-SR
  { .code = "A18";   .bovnar = "Bq/k~g";              .reverse = false; },  # via qudt:BQ-PER-KiloGM
  { .code = "A19";   .bovnar = "Bq/m^3";              .reverse = false; },  # via qudt:BQ-PER-M3
  { .code = "A2";    .bovnar = "A/c~m";               .reverse = false; },  # via qudt:A-PER-CentiM
  { .code = "A20";   .bovnar = "Btu/s·ft^2·°Ra";      .reverse = false; },  # via qudt:BTU_IT-PER-SEC-FT2-DEG_R
  { .code = "A22";   .bovnar = "Btu/s·ft·°Ra";        .reverse = false; },  # via qudt:BTU_IT-PER-SEC-FT-DEG_R
  { .code = "A23";   .bovnar = "Btu/h·ft^2·°Ra";      .reverse = false; },  # via qudt:BTU_IT-PER-HR-FT2-DEG_R
  { .code = "A26";   .bovnar = "C·m";                 .reverse = false; },  # via qudt:C-M
  { .code = "A27";   .bovnar = "C·m^2/V";             .reverse = false; },  # via qudt:C-M2-PER-V
  { .code = "A28";   .bovnar = "C/c~m^3";             .reverse = false; },  # via qudt:C-PER-CentiM3
  { .code = "A29";   .bovnar = "C/m^3";               .reverse = false; },  # via qudt:C-PER-M3
  { .code = "A3";    .bovnar = "A/m~m";               .reverse = false; },  # via qudt:A-PER-MilliM
  { .code = "A30";   .bovnar = "C/m~m^3";             .reverse = false; },  # via qudt:C-PER-MilliM3
  { .code = "A31";   .bovnar = "C/k~g·s";             .reverse = false; },  # via qudt:C-PER-KiloGM-SEC
  { .code = "A32";   .bovnar = "C/mol";               .reverse = false; },  # via qudt:C-PER-MOL
  { .code = "A33";   .bovnar = "C/c~m^2";             .reverse = false; },  # via qudt:C-PER-CentiM2
  { .code = "A34";   .bovnar = "C/m^2";               .reverse = false; },  # via qudt:C-PER-M2
  { .code = "A35";   .bovnar = "C/m~m^2";             .reverse = false; },  # via qudt:C-PER-MilliM2
  { .code = "A36";   .bovnar = "c~m^3/mol";           .reverse = false; },  # via qudt:CentiM3-PER-MOL
  { .code = "A37";   .bovnar = "d~m^3/mol";           .reverse = false; },  # via qudt:DeciM3-PER-MOL
  { .code = "A38";   .bovnar = "m^3/C";               .reverse = false; },  # via qudt:M3-PER-C
  { .code = "A39";   .bovnar = "m^3/k~g";             .reverse = false; },  # via qudt:M3-PER-KiloGM
  { .code = "A4";    .bovnar = "A/c~m^2";             .reverse = false; },  # via qudt:A-PER-CentiM2
  { .code = "A40";   .bovnar = "m^3/mol";             .reverse = false; },  # via qudt:M3-PER-MOL
  { .code = "A41";   .bovnar = "A/m^2";               .reverse = false; },  # via qudt:A-PER-M2
  { .code = "A44";   .bovnar = "da~L";                },  # via qudt:DecaL
  { .code = "A45";   .bovnar = "da~m";                },  # via qudt:DecaM
  { .code = "A5";    .bovnar = "A·m^2";               .reverse = false; },  # via qudt:A-M2
  { .code = "A50";   .bovnar = "dyn·s/c~m^3";         .reverse = false; },  # via qudt:DYN-SEC-PER-CentiM3
  { .code = "A51";   .bovnar = "dyn·s/c~m";           .reverse = false; },  # via qudt:DYN-SEC-PER-CentiM
  { .code = "A52";   .bovnar = "dyn·s/c~m^5";         .reverse = false; },  # via qudt:DYN-SEC-PER-CentiM5
