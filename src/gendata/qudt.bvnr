#!bovnar 1.1
# qudt.bvnr — single source of truth for the QUDT unit profile.
#
# HOW THIS WORKS
#   Hand-edited. gen_profiles.py (at the repo root) regenerates the C profile
#   tables from this file on every build; never edit the generated *.gen.{h,inc}.
#
# WHAT THIS VOCABULARY IS
#   QUDT (Quantities, Units, Dimensions and Data Types), the RDF/OWL unit
#   ontology at qudt.org. Its units are IRIs under http://qudt.org/vocab/unit/,
#   and this profile spells them by their LOCAL NAME -- the part after the last
#   '/'. QUDT is the unit vocabulary of the digital-twin and building-semantics
#   world (DTDL, Brick, ASHRAE 223P, IOF), which is why the profile exists.
#
#   A FLAT profile. A QUDT local name is ONE WHOLE TOKEN: "KiloGM" is the
#   kilogram as a single symbol, and although it LOOKS like a prefix applied to
#   "GM", nothing here takes it apart. That is deliberate. QUDT's naming is
#   regular enough to tempt a parser into decomposing it and irregular enough
#   that the parser would be wrong -- "MI" is the mile, not a milli-anything.
#
# FULL IRIs ARE NOT ACCEPTED
#   "qudt:M-PER-SEC", never "qudt:http://qudt.org/vocab/unit/M-PER-SEC". A unit
#   slot is at most 255 bytes and a ':' inside it already means something here;
#   admitting a URI would put a second scheme separator inside a namespace
#   separator for no gain, since the local name is the identifying part.
#
# PROVENANCE — READ THIS BEFORE TRUSTING A ROW
#   The .bovnar target of every row is checked against this build's native
#   registry by gen_profiles.py, and the translation is pinned by
#   tests/bovnar_qudt_test.c. NEITHER checks the QUDT side: nothing in this
#   repository verifies that "KiloGM" is really QUDT's kilogram, or that a local
#   name spelled here exists in the vocabulary at all. That gap is the same
#   standing risk doc/11 records for the UCUM table. This list is therefore a
#   CONFIDENT SUBSET: a name that is not here fails loudly as error_unit_illegal,
#   which costs a producer an error message, while a name that is here and wrong
#   costs them a wrong number.
#
# WHAT IS DELIBERATELY ABSENT
#   QUDT's quantity kinds — those are a separate namespace, "qudt-qk:", in
#   qudt-qk.bvnr, because a kind of quantity is not a unit. QUDT's currency
#   units: bovnar has ISO 4217 natively, written with the $ sigil. Every unit
#   whose QUDT value this file cannot state exactly.

.schema_version = <uint:16> 1;

.mapped = [
  # Length
  { .code = "M";          .bovnar = "m";      },
  { .code = "KiloM";      .bovnar = "k~m";    },
  { .code = "HectoM";     .bovnar = "h~m";    },
  { .code = "DeciM";      .bovnar = "d~m";    },
  { .code = "CentiM";     .bovnar = "c~m";    },
  { .code = "MilliM";     .bovnar = "m~m";    },
  { .code = "MicroM";     .bovnar = "µ~m";    },
  { .code = "NanoM";      .bovnar = "n~m";    },
  { .code = "PicoM";      .bovnar = "p~m";    },
  { .code = "ANGSTROM";   .bovnar = "Å";      },
  { .code = "IN";         .bovnar = "in";     },
  { .code = "FT";         .bovnar = "ft";     },
  { .code = "YD";         .bovnar = "yd";     },
  { .code = "MI";         .bovnar = "mi";     },
  { .code = "MI_N";       .bovnar = "nmi";    },   # not NAUT_MI
  { .code = "LY";         .bovnar = "ly";     },
  # PARSEC, not PC: QUDT's "PC" does not exist and its PCA -- whose symbol
  # really is "pc" -- is the PICA, a typographic length. Matching on the
  # symbol is how that trap is walked into.
  { .code = "PARSEC";     .bovnar = "pc";     },
  { .code = "AU";         .bovnar = "au";     },

  # Area
  { .code = "M2";         .bovnar = "m^2";    },
  { .code = "KiloM2";     .bovnar = "k~m^2";  },
  { .code = "DeciM2";     .bovnar = "d~m^2";  },
  { .code = "CentiM2";    .bovnar = "c~m^2";  },
  { .code = "MilliM2";    .bovnar = "m~m^2";  },
  { .code = "HA";         .bovnar = "ha";     },
  { .code = "AC";         .bovnar = "ac";     },
  { .code = "IN2";        .bovnar = "in^2";   },
  { .code = "FT2";        .bovnar = "ft^2";   },
  { .code = "YD2";        .bovnar = "yd^2";   },

  # Volume
  { .code = "M3";         .bovnar = "m^3";    },
  { .code = "DeciM3";     .bovnar = "d~m^3";  },
  { .code = "CentiM3";    .bovnar = "c~m^3";  },
  { .code = "MilliM3";    .bovnar = "m~m^3";  },
  { .code = "L";          .bovnar = "L";      },
  { .code = "HectoL";     .bovnar = "h~L";    },
  { .code = "DeciL";      .bovnar = "d~L";    },
  { .code = "CentiL";     .bovnar = "c~L";    },
  { .code = "MilliL";     .bovnar = "m~L";    },
  { .code = "MicroL";     .bovnar = "µ~L";    },
  { .code = "IN3";        .bovnar = "in^3";   },
  { .code = "FT3";        .bovnar = "ft^3";   },
  { .code = "YD3";        .bovnar = "yd^3";   },

  # Mass
  { .code = "GM";         .bovnar = "g";      },
  { .code = "KiloGM";     .bovnar = "k~g";    },
  { .code = "MilliGM";    .bovnar = "m~g";    },
  { .code = "MicroGM";    .bovnar = "µ~g";    },
  { .code = "TON_Metric"; .bovnar = "t";      },
  { .code = "LB";         .bovnar = "lb";     },
  { .code = "OZ";         .bovnar = "oz";     },
  { .code = "OZ_TROY";    .bovnar = "oz_t";   },
  { .code = "GRAIN";      .bovnar = "gr";     },
  { .code = "TON_SHORT";  .bovnar = "tn_sh";  },
  { .code = "TON_LONG";   .bovnar = "tn_l";   },
  { .code = "CARAT";      .bovnar = "ct";     },
  { .code = "U";          .bovnar = "Da";     },   # unified atomic mass unit

  # Time
  { .code = "SEC";        .bovnar = "s";      },
  { .code = "MilliSEC";   .bovnar = "m~s";    },
  { .code = "MicroSEC";   .bovnar = "µ~s";    },
  { .code = "NanoSEC";    .bovnar = "n~s";    },
  { .code = "PicoSEC";    .bovnar = "p~s";    },
  { .code = "MIN";        .bovnar = "min";    },
  { .code = "HR";         .bovnar = "h";      },
  { .code = "DAY";        .bovnar = "d";      },
  { .code = "WK";         .bovnar = "wk";     },
  { .code = "YR";         .bovnar = "yr";     },

  # Temperature
  { .code = "K";          .bovnar = "K";      },
  { .code = "DEG_C";      .bovnar = "°C";     },
  { .code = "DEG_F";      .bovnar = "°F";     },
  { .code = "DEG_R";      .bovnar = "°Ra";    },

  # Electric current, amount, luminous intensity
  { .code = "A";          .bovnar = "A";      },
  { .code = "MilliA";     .bovnar = "m~A";    },
  { .code = "MicroA";     .bovnar = "µ~A";    },
  { .code = "KiloA";      .bovnar = "k~A";    },
  { .code = "MOL";        .bovnar = "mol";    },
  { .code = "MilliMOL";   .bovnar = "m~mol";  },
  { .code = "CD";         .bovnar = "cd";     },

  # Named SI-derived
  { .code = "HZ";         .bovnar = "Hz";     },
  { .code = "KiloHZ";     .bovnar = "k~Hz";   },
  { .code = "MegaHZ";     .bovnar = "M~Hz";   },
  { .code = "GigaHZ";     .bovnar = "G~Hz";   },
  { .code = "N";          .bovnar = "N";      },
  { .code = "KiloN";      .bovnar = "k~N";    },
  { .code = "PA";         .bovnar = "Pa";     },
  { .code = "HectoPA";    .bovnar = "h~Pa";   },
  { .code = "KiloPA";     .bovnar = "k~Pa";   },
  { .code = "MegaPA";     .bovnar = "M~Pa";   },
  { .code = "J";          .bovnar = "J";      },
  { .code = "KiloJ";      .bovnar = "k~J";    },
  { .code = "MegaJ";      .bovnar = "M~J";    },
  { .code = "W";          .bovnar = "W";      },
  { .code = "KiloW";      .bovnar = "k~W";    },
  { .code = "MegaW";      .bovnar = "M~W";    },
  { .code = "MilliW";     .bovnar = "m~W";    },
  { .code = "V";          .bovnar = "V";      },
  { .code = "KiloV";      .bovnar = "k~V";    },
  { .code = "MilliV";     .bovnar = "m~V";    },
  { .code = "MicroV";     .bovnar = "µ~V";    },
  { .code = "OHM";        .bovnar = "Ω";      },
  { .code = "KiloOHM";    .bovnar = "k~Ω";    },
  { .code = "MegaOHM";    .bovnar = "M~Ω";    },
  { .code = "FARAD";      .bovnar = "F";      },
  { .code = "MicroFARAD"; .bovnar = "µ~F";    },
  { .code = "C";          .bovnar = "C";      },
  { .code = "S";          .bovnar = "S";      },
  { .code = "WB";         .bovnar = "Wb";     },
  { .code = "T";          .bovnar = "T";      },
  { .code = "H";          .bovnar = "H";      },
  { .code = "MilliH";     .bovnar = "m~H";    },
  { .code = "LM";         .bovnar = "lm";     },
  { .code = "LUX";        .bovnar = "lx";     },
  { .code = "BQ";         .bovnar = "Bq";     },
  { .code = "GRAY";       .bovnar = "Gy";     },
  { .code = "SV";         .bovnar = "Sv";     },
  { .code = "KAT";        .bovnar = "kat";    },

  # Pressure and energy, non-SI
  { .code = "BAR";        .bovnar = "bar";    },
  { .code = "MilliBAR";   .bovnar = "m~bar";  },
  { .code = "ATM";        .bovnar = "atm";    },
  { .code = "PSI";        .bovnar = "psi";    },
  { .code = "TORR";       .bovnar = "Torr";   },
  { .code = "MilliM_HG";  .bovnar = "mmHg";   },
  { .code = "EV";         .bovnar = "eV";     },
  { .code = "ERG";        .bovnar = "erg";    },
  # The qualified codes only. QUDT carries CAL_TH (4.184 J) and CAL_IT
  # (4.1868), and BTU_IT beside four other BTUs; native cal is the
  # thermochemical one and native Btu the IT one, so those are the two that
  # map. There is no unqualified "CAL" or "BTU" in QUDT to map anyway.
  { .code = "CAL_TH";     .bovnar = "cal";    },
  { .code = "BTU_IT";     .bovnar = "Btu";    },
  { .code = "W-HR";       .bovnar = "W·h";    },
  { .code = "KiloW-HR";   .bovnar = "k~W·h";  },
  { .code = "MegaW-HR";   .bovnar = "M~W·h";  },

  # Compounds: the "-PER-" and exponent conventions
  { .code = "M-PER-SEC";      .bovnar = "m/s";     },
  { .code = "M-PER-SEC2";     .bovnar = "m/s^2";   },
  { .code = "KiloM-PER-HR";   .bovnar = "k~m/h";   },
  { .code = "MI-PER-HR";      .bovnar = "mph";     },
  { .code = "KN";             .bovnar = "kn";      },
  { .code = "KiloGM-PER-M3";  .bovnar = "k~g/m^3"; },
  { .code = "GM-PER-CentiM3"; .bovnar = "g/c~m^3"; },
  { .code = "MOL-PER-L";      .bovnar = "mol/L";   },
  { .code = "N-M";            .bovnar = "N·m";     },
  # rev/min, NOT rpm. QUDT's REV-PER-MIN is an ANGULAR VELOCITY: its
  # multiplier is 2π/60, one revolution being 2π radians -- which is what
  # native rev is too. Native rpm counts revolutions instead, 1/60 s⁻¹, so
  # mapping to it read every QUDT rotational speed 2π times too small while
  # remaining dimensionally perfect.
  { .code = "REV-PER-MIN";    .bovnar = "rev/min"; },

  # Angle and ratio
  { .code = "RAD";        .bovnar = "rad";    },
  { .code = "SR";         .bovnar = "sr";     },
  { .code = "DEG";        .bovnar = "°";      },
  { .code = "GRAD";       .bovnar = "grad";   },
  { .code = "ARCMIN";     .bovnar = "arcmin"; },
  { .code = "ARCSEC";     .bovnar = "arcsec"; },
  { .code = "PERCENT";    .bovnar = "%";      },
  { .code = "PPM";        .bovnar = "ppm";    },
  { .code = "PPB";        .bovnar = "ppb";    },
  { .code = "PH";         .bovnar = "pH";     },
  { .code = "DeciB";      .bovnar = "dB";     },   # not DECIBEL
  { .code = "NP";         .bovnar = "Np";     },   # not NEPER

  # Information. QUDT keeps the decimal and binary families apart, and so does
  # bovnar: KiloBYTE is 10^3 bytes and KibiBYTE is 2^10.
  { .code = "BIT";        .bovnar = "b";      },
  { .code = "BYTE";       .bovnar = "B";      },
  { .code = "KiloBYTE";   .bovnar = "k~B";    },
  { .code = "MegaBYTE";   .bovnar = "M~B";    },
  { .code = "GigaBYTE";   .bovnar = "G~B";    },
  { .code = "TeraBYTE";   .bovnar = "T~B";    },
  { .code = "KibiBYTE";   .bovnar = "Ki~B";   },
  { .code = "MebiBYTE";   .bovnar = "Mi~B";   },
  { .code = "GibiBYTE";   .bovnar = "Gi~B";   },
  { .code = "TebiBYTE";   .bovnar = "Ti~B";   },

  # ── More refusals an existing native expression already covered ───────
  #
  # A degree Celsius or Fahrenheit INSIDE a compound is the interval, and the
  # intervals are K and Δ°F -- which is how DEG_C-PER-SEC and the whole
  # BTU_TH family above already read. These are the rest of the same shape,
  # refused while their siblings were mapped.
  #
  # The others are units the registry has and the derivation did not find,
  # because it only ever tried a single native unit times a decade: a decimetre
  # cubed IS a litre, a slug per foot second IS slug/(ft·s), and DRAM_US, LB_T
  # and Hundredweight_UK are the apothecary dram, troy pound and long
  # hundredweight the registry has just gained.
  { .code = "DEG_C-PER-HR";                    .bovnar = "K/h";                 .reverse = false; },
  { .code = "DEG_C-PER-MIN";                   .bovnar = "K/min";               .reverse = false; },
  { .code = "DEG_C-PER-BAR";                   .bovnar = "K/bar";               .reverse = false; },
  { .code = "DEG_C_GROWING_CEREAL-DAY";        .bovnar = "K·d";                 .reverse = false; },
  { .code = "PER-DEG_C";                       .bovnar = "K^-1";                .reverse = false; },
  { .code = "PERCENT-PER-DEG_C";               .bovnar = "%/K";                 .reverse = false; },
  { .code = "M-PER-DEG_C-M";                   .bovnar = "m/(K·m)";             .reverse = false; },
  { .code = "BAR-PER-DEG_C";                   .bovnar = "bar/K";               .reverse = false; },
  { .code = "DEG_F-PER-HR";                    .bovnar = "Δ°F/h";               .reverse = false; },
  { .code = "DEG_F-PER-MIN";                   .bovnar = "Δ°F/min";             .reverse = false; },
  { .code = "DEG_F-PER-SEC";                   .bovnar = "Δ°F/s";               .reverse = false; },
  { .code = "BTU_IT-PER-DEG_F";                .bovnar = "Btu/Δ°F";             .reverse = false; },
  { .code = "BTU_IT-PER-FT2-HR-DEG_F";         .bovnar = "Btu/(ft^2·h·Δ°F)";    .reverse = false; },
  { .code = "BTU_IT-PER-FT2-SEC-DEG_F";        .bovnar = "Btu/(ft^2·s·Δ°F)";    .reverse = false; },
  { .code = "BTU_IT-PER-HR-FT2-DEG_F";         .bovnar = "Btu/(h·ft^2·Δ°F)";    .reverse = false; },
  { .code = "BTU_IT-PER-SEC-FT2-DEG_F";        .bovnar = "Btu/(s·ft^2·Δ°F)";    .reverse = false; },
  { .code = "LB-DEG_F";                        .bovnar = "lb·Δ°F";              .reverse = false; },
  { .code = "DRAM_US";                         .bovnar = "dr_ap";                },
  { .code = "LB_T";                            .bovnar = "lb_t";                 },
  { .code = "Hundredweight_UK";                .bovnar = "cwt_l";                },
  { .code = "DeciM3-PER-MIN";                  .bovnar = "L/min";               .reverse = false; },
  { .code = "GRAIN-PER-GAL";                   .bovnar = "gr/gal";              .reverse = false; },
  { .code = "SLUG-PER-FT-SEC";                 .bovnar = "slug/(ft·s)";         .reverse = false; },
  { .code = "NUM-PER-KiloGM";                  .bovnar = "k~g^-1";              .reverse = false; },
  { .code = "PER-KiloVA-HR";                  .bovnar = "k~VA^-1·h^-1";        .reverse = false; },
  { .code = "MilliL-PER-CentiM2-MIN";          .bovnar = "m~L/(c~m^2·min)";     .reverse = false; },
  { .code = "KiloGM_F-PER-M2";                 .bovnar = "kgf/m^2";             .reverse = false; },
  { .code = "KiloLB_F-PER-FT";                 .bovnar = "k~lbf/ft";            .reverse = false; },

  # ── The thermochemical BTU, the IT calorie, and the water column ──────
  #
  # Forty-four codes, refused until bu_btu_th, bu_calorie_it, bu_meter_water,
  # bu_troy_pound and bu_long_hundredweight existed. Nothing here is a new
  # reading of QUDT: each row's factor was checked against QUDT's own
  # conversionMultiplier and agrees to within the tolerance, most of them
  # exactly.
  #
  # The DEG_F and DEG_R in these codes are temperature INTERVALS -- a specific
  # heat is per degree of RISE -- so they map to Δ°F and Δ°Ra, which are linear
  # and may stand inside a product. Plain °F is affine and may not.
  { .code = "BTU_TH";                          .bovnar = "Btu_th";               },
  { .code = "KiloBTU_TH";                      .bovnar = "k~Btu_th";             },
  { .code = "CAL_IT";                          .bovnar = "cal_IT";               },
  { .code = "KiloCAL_IT";                      .bovnar = "k~cal_IT";             },
  { .code = "CWT_LONG";                        .bovnar = "cwt_l";                },
  { .code = "MilliM_H2O";                      .bovnar = "m~mH2O";               },

  { .code = "BTU_TH-PER-SEC";                  .bovnar = "Btu_th/s";            .reverse = false; },
  { .code = "BTU_TH-PER-HR";                   .bovnar = "Btu_th/h";            .reverse = false; },
  { .code = "BTU_TH-PER-MIN";                  .bovnar = "Btu_th/min";          .reverse = false; },
  { .code = "BTU_TH-PER-LB";                   .bovnar = "Btu_th/lb";           .reverse = false; },
  { .code = "BTU_TH-PER-LB-DEG_F";             .bovnar = "Btu_th/(lb·Δ°F)";     .reverse = false; },
  { .code = "BTU_TH-PER-LB-DEG_R";             .bovnar = "Btu_th/(lb·Δ°Ra)";    .reverse = false; },
  { .code = "BTU_TH-PER-DEG_F";                .bovnar = "Btu_th/Δ°F";          .reverse = false; },
  { .code = "BTU_TH-PER-DEG_R";                .bovnar = "Btu_th/Δ°Ra";         .reverse = false; },
  { .code = "BTU_TH-PER-FT2";                  .bovnar = "Btu_th/ft^2";         .reverse = false; },
  { .code = "BTU_TH-PER-FT2-HR";               .bovnar = "Btu_th/(ft^2·h)";     .reverse = false; },
  { .code = "BTU_TH-PER-FT2-MIN";              .bovnar = "Btu_th/(ft^2·min)";   .reverse = false; },
  { .code = "BTU_TH-PER-FT2-SEC";              .bovnar = "Btu_th/(ft^2·s)";     .reverse = false; },
  { .code = "BTU_TH-PER-FT3";                  .bovnar = "Btu_th/ft^3";         .reverse = false; },
  { .code = "BTU_TH-PER-HR-FT2-DEG_F";         .bovnar = "Btu_th/(h·ft^2·Δ°F)"; .reverse = false; },
  { .code = "BTU_TH-PER-SEC-FT2-DEG_F";        .bovnar = "Btu_th/(s·ft^2·Δ°F)"; .reverse = false; },
  { .code = "BTU_TH-FT-PER-FT2-HR-DEG_F";      .bovnar = "Btu_th·ft/(ft^2·h·Δ°F)";.reverse = false; },
  { .code = "BTU_TH-FT-PER-HR-FT2-DEG_F";      .bovnar = "Btu_th·ft/(h·ft^2·Δ°F)";.reverse = false; },
  { .code = "BTU_TH-IN-PER-FT2-HR-DEG_F";      .bovnar = "Btu_th·in/(ft^2·h·Δ°F)";.reverse = false; },
  { .code = "BTU_TH-IN-PER-FT2-SEC-DEG_F";     .bovnar = "Btu_th·in/(ft^2·s·Δ°F)";.reverse = false; },
  { .code = "KiloBTU_TH-PER-HR";               .bovnar = "k~Btu_th/h";          .reverse = false; },
  { .code = "DEG_F-HR-FT2-PER-BTU_TH";         .bovnar = "Δ°F·h·ft^2/Btu_th";   .reverse = false; },
  { .code = "DEG_F-HR-PER-BTU_TH";             .bovnar = "Δ°F·h/Btu_th";        .reverse = false; },
  { .code = "DEG_F-SEC-PER-BTU_TH";            .bovnar = "Δ°F·s/Btu_th";        .reverse = false; },
  { .code = "DEG_F-HR-FT2-PER-BTU_TH-IN";      .bovnar = "Δ°F·h·ft^2/(Btu_th·in)";.reverse = false; },
  { .code = "CAL_IT-PER-GM";                   .bovnar = "cal_IT/g";            .reverse = false; },
  { .code = "CAL_IT-PER-GM-DEG_C";             .bovnar = "cal_IT/(g·K)";        .reverse = false; },
  { .code = "CAL_IT-PER-GM-K";                 .bovnar = "cal_IT/(g·K)";        .reverse = false; },
  { .code = "CAL_IT-PER-SEC-CentiM-K";         .bovnar = "cal_IT/(s·c~m·K)";    .reverse = false; },
  { .code = "CAL_IT-PER-SEC-CentiM2-K";        .bovnar = "cal_IT/(s·c~m^2·K)";  .reverse = false; },
  { .code = "KiloCAL_IT-PER-GM-K";             .bovnar = "k~cal_IT/(g·K)";      .reverse = false; },
  { .code = "KiloCAL_IT-PER-HR-M-DEG_C";       .bovnar = "k~cal_IT/(h·m·K)";    .reverse = false; },
  { .code = "M2-HR-DEG_C-PER-KiloCAL_IT";      .bovnar = "m^2·h·K/k~cal_IT";    .reverse = false; },
  { .code = "BTU_IT-PER-LB-DEG_F";             .bovnar = "Btu/(lb·Δ°F)";        .reverse = false; },
  { .code = "CAL_TH-PER-GM-DEG_C";             .bovnar = "cal/(g·K)";           .reverse = false; },
  { .code = "CAL_TH-PER-CentiM-SEC-DEG_C";     .bovnar = "cal/(c~m·s·K)";       .reverse = false; },
  { .code = "KiloCAL-PER-CentiM-SEC-DEG_C";    .bovnar = "k~cal/(c~m·s·K)";     .reverse = false; },
  { .code = "KiloCAL-PER-GM-DEG_C";            .bovnar = "k~cal/(g·K)";         .reverse = false; },
  { .code = "KiloCAL-PER-MOL-DEG_C";           .bovnar = "k~cal/(mol·K)";       .reverse = false; },
  { .code = "FT_H2O";                          .bovnar = "ft·mH2O/m";           .reverse = false; },

  # ── The rest of the information family ───────────────────────────────
  #
  # QUDT states information as ENTROPY: its BIT is ln 2 = 0.693 and its BYTE
  # 8·ln 2, the coherent unit of entropy being the nat. bovnar's bit is 1.
  # That is a modelling difference, not a wrong conversion, and the two rows
  # above already accept it (check_profile_factors.py records it as a waived
  # model). Every row below is the SAME difference at another decade or
  # binary power, so refusing them was refusing the model twice: a reader who
  # can have BIT and KibiBYTE has no reason to be denied KiloBIT and MebiBIT.
  #
  # Ratios were taken against QUDT's own BIT and BYTE rather than against 1,
  # so each row below is an exact power of ten or of two off the atom it
  # names — the ln 2 cancels — with four exceptions where QUDT's published
  # value does not follow its own model. Those are marked; see the waiver.

  { .code = "KiloBIT";                         .bovnar = "k~b"; },
  { .code = "MegaBIT";                         .bovnar = "M~b"; },
  { .code = "GigaBIT";                         .bovnar = "G~b"; },
  { .code = "TeraBIT";                         .bovnar = "T~b"; },
  { .code = "PetaBIT";                         .bovnar = "P~b"; },
  { .code = "ExaBIT";                          .bovnar = "E~b"; },

  { .code = "KibiBIT";                         .bovnar = "Ki~b"; },
  { .code = "MebiBIT";                         .bovnar = "Mi~b"; },
  { .code = "GibiBIT";                         .bovnar = "Gi~b"; },
  { .code = "TebiBIT";                         .bovnar = "Ti~b"; },
  # QUDT's PebiBIT/ExbiBIT (and the PebiBYTE/ExbiBYTE they are an eighth of)
  # are not 2^50 and 2^60 of its own BIT — they are out by 8.9 and 7.5. The
  # NAME is unambiguous, so these map and the disagreement is waived, exactly
  # as UCUM's inverted phot is.
  { .code = "PebiBIT";                         .bovnar = "Pi~b"; },
  { .code = "ExbiBIT";                         .bovnar = "Ei~b"; },

  { .code = "PetaBYTE";                        .bovnar = "P~B"; },
  { .code = "ExaBYTE";                         .bovnar = "E~B"; },
  { .code = "PebiBYTE";                        .bovnar = "Pi~B"; },
  { .code = "ExbiBYTE";                        .bovnar = "Ei~B"; },

  # An octet IS a byte, and a shannon IS a bit; both carry `.reverse = false`
  # so the canonical spelling stays BYTE and BIT.
  { .code = "OCTET";                           .bovnar = "B";                   .reverse = false; },
  { .code = "SHANNON";                         .bovnar = "b";                   .reverse = false; },

  # Rates and linear densities. QUDT drops the ln 2 from its own model in the
  # binary PER-M families and in ExaBIT-PER-SEC, stating a bare power of two
  # or ten; the codes still name bits, so they map and the waiver records it.
  { .code = "BIT-PER-SEC";                     .bovnar = "b/s";                 .reverse = false; },
  { .code = "BYTE-PER-SEC";                    .bovnar = "B/s";                 .reverse = false; },
  { .code = "OCTET-PER-SEC";                   .bovnar = "B/s";                 .reverse = false; },
  { .code = "SHANNON-PER-SEC";                 .bovnar = "b/s";                 .reverse = false; },
  { .code = "KiloBIT-PER-SEC";                 .bovnar = "k~b/s";               .reverse = false; },
  { .code = "MegaBIT-PER-SEC";                 .bovnar = "M~b/s";               .reverse = false; },
  { .code = "GigaBIT-PER-SEC";                 .bovnar = "G~b/s";               .reverse = false; },
  { .code = "TeraBIT-PER-SEC";                 .bovnar = "T~b/s";               .reverse = false; },
  { .code = "PetaBIT-PER-SEC";                 .bovnar = "P~b/s";               .reverse = false; },
  { .code = "KiloBYTE-PER-SEC";                .bovnar = "k~B/s";               .reverse = false; },
  { .code = "MegaBYTE-PER-SEC";                .bovnar = "M~B/s";               .reverse = false; },
  { .code = "GigaBYTE-PER-SEC";                .bovnar = "G~B/s";               .reverse = false; },

  { .code = "BIT-PER-M";                       .bovnar = "b/m";                 .reverse = false; },
  { .code = "BIT-PER-M2";                      .bovnar = "b/m^2";               .reverse = false; },
  { .code = "BIT-PER-M3";                      .bovnar = "b/m^3";               .reverse = false; },
  { .code = "GigaBIT-PER-M";                   .bovnar = "G~b/m";               .reverse = false; },
  { .code = "KibiBIT-PER-M";                   .bovnar = "Ki~b/m";              .reverse = false; },
  { .code = "KibiBIT-PER-M2";                  .bovnar = "Ki~b/m^2";            .reverse = false; },
  { .code = "KibiBIT-PER-M3";                  .bovnar = "Ki~b/m^3";            .reverse = false; },
  { .code = "MebiBIT-PER-M";                   .bovnar = "Mi~b/m";              .reverse = false; },
  { .code = "MebiBIT-PER-M2";                  .bovnar = "Mi~b/m^2";            .reverse = false; },
  { .code = "MebiBIT-PER-M3";                  .bovnar = "Mi~b/m^3";            .reverse = false; },
  { .code = "GibiBIT-PER-M";                   .bovnar = "Gi~b/m";              .reverse = false; },
  { .code = "GibiBIT-PER-M2";                  .bovnar = "Gi~b/m^2";            .reverse = false; },
  { .code = "GibiBIT-PER-M3";                  .bovnar = "Gi~b/m^3";            .reverse = false; },
  { .code = "TebiBIT-PER-M";                   .bovnar = "Ti~b/m";              .reverse = false; },
  { .code = "TebiBIT-PER-M2";                  .bovnar = "Ti~b/m^2";            .reverse = false; },
  { .code = "TebiBIT-PER-M3";                  .bovnar = "Ti~b/m^3";            .reverse = false; },
  { .code = "PebiBIT-PER-M";                   .bovnar = "Pi~b/m";              .reverse = false; },
  { .code = "PebiBIT-PER-M2";                  .bovnar = "Pi~b/m^2";            .reverse = false; },
  { .code = "PebiBIT-PER-M3";                  .bovnar = "Pi~b/m^3";            .reverse = false; },
  { .code = "ExbiBIT-PER-M";                   .bovnar = "Ei~b/m";              .reverse = false; },
  { .code = "ExbiBIT-PER-M2";                  .bovnar = "Ei~b/m^2";            .reverse = false; },
  { .code = "ExbiBIT-PER-M3";                  .bovnar = "Ei~b/m^3";            .reverse = false; },

  # ── Synchronisation with the other profiles ──────────────────────────────
  # Every row below names a unit QUDT defines, that bovnar carries natively,
  # and that ucum.bvnr, udunits.bvnr and unece.bvnr already mapped while this
  # table did not: 56 of them, which made qudt the least complete of the five
  # against its own vocabulary. Found by check_profile_factors.py and chosen the
  # same way the unece block was -- by QUDT's own rdfs:label, never by the
  # number alone, because dimensions collapse and a value-only match proposed
  # the lux for a luminance, the rem for the rad, and the watt for both the
  # volt-ampere and the var.

  # Length
  { .code = "FUR";        .bovnar = "fur";    },
  { .code = "FATH";       .bovnar = "fath";   },
  { .code = "CH";         .bovnar = "ch";     },
  { .code = "FT_US";      .bovnar = "ftUS";   },
  { .code = "MilliIN";    .bovnar = "thou";   },
  { .code = "MilLength";  .bovnar = "thou";   },

  # Mass
  { .code = "LB_M";       .bovnar = "lb";     },
  { .code = "OZ_M";       .bovnar = "oz";     },
  { .code = "Stone_UK";   .bovnar = "st";     },
  { .code = "TON";        .bovnar = "tn_sh";  },
  { .code = "TON_US";     .bovnar = "tn_sh";  },
  { .code = "TON_UK";     .bovnar = "tn_l";   },
  { .code = "TONNE";      .bovnar = "t";      },
  { .code = "MegaGM";     .bovnar = "t";      },
  { .code = "DWT";        .bovnar = "dwt";    },
  { .code = "PENNYWEIGHT"; .bovnar = "dwt";   },
  { .code = "SLUG";       .bovnar = "slug";   },
  { .code = "DeciTONNE";  .bovnar = "qntl";   },   # a tenth of a tonne
  { .code = "DeciTON_Metric"; .bovnar = "qntl"; },
  { .code = "AMU";        .bovnar = "Da";     },
  { .code = "DA";         .bovnar = "Da";     },

  # Volume
  { .code = "GAL_US";     .bovnar = "gal";      },
  { .code = "GAL_UK";     .bovnar = "gal_uk";   },
  { .code = "GAL_IMP";    .bovnar = "gal_uk";   },
  { .code = "QT_US";      .bovnar = "qt";       },
  { .code = "QT_UK";      .bovnar = "qt_uk";    },
  { .code = "PINT_US";    .bovnar = "pt";       },
  { .code = "PINT_UK";    .bovnar = "pt_uk";    },
  { .code = "PINT";       .bovnar = "pt_uk";    },   # QUDT's PINT is imperial
  { .code = "CUP";        .bovnar = "cup";      },
  { .code = "CUP_US";     .bovnar = "cup";      },
  { .code = "GI_US";      .bovnar = "gi";       },
  { .code = "GI_UK";      .bovnar = "gi_uk";    },
  { .code = "OZ_VOL_US";  .bovnar = "fl_oz";    },
  { .code = "OZ_VOL_UK";  .bovnar = "fl_oz_uk"; },
  { .code = "TBSP";       .bovnar = "tbsp";     },
  { .code = "TSP";        .bovnar = "tsp";      },
  { .code = "PK_US_DRY";  .bovnar = "pk";       },
  { .code = "BU_US";      .bovnar = "bsh";      },
  { .code = "BU_US_DRY";  .bovnar = "bsh";      },
  { .code = "BBL_US";     .bovnar = "bbl";      },
  { .code = "BBL_US_PET"; .bovnar = "bbl";      },

  # Force, pressure, energy, power
  { .code = "LB_F";       .bovnar = "lbf";    },
  { .code = "KiloGM_F";   .bovnar = "kgf";    },
  { .code = "KiloPOND";   .bovnar = "kgf";    },
  { .code = "KIP_F";      .bovnar = "kip";    },
  { .code = "KiloLB_F";   .bovnar = "kip";    },
  { .code = "DYN";        .bovnar = "dyn";    },
  { .code = "G";          .bovnar = "gn";     },   # QUDT's G is standard gravity
  { .code = "ATM_T";      .bovnar = "at";     },
  { .code = "IN_HG";      .bovnar = "inHg";   },
  { .code = "HP";         .bovnar = "hp";     },
  { .code = "HP_Metric";  .bovnar = "PS";     },
  { .code = "THM_US";     .bovnar = "thm";    },
  { .code = "FT-LB_F";    .bovnar = "ft_lb";  },
  { .code = "LB_F-FT";    .bovnar = "ft_lb";  },
  # Apparent and reactive power are NOT the watt. doc/07 §12 keeps all three
  # apart and a value-only match had proposed W for both of these.
  { .code = "V-A";          .bovnar = "VA";   },
  { .code = "V-A_Reactive"; .bovnar = "var";  },

  # Electricity and magnetism
  { .code = "GAUSS";      .bovnar = "G";      },   # native G is the gauss
  { .code = "Gs";         .bovnar = "G";      },
  { .code = "MX";         .bovnar = "Mx";     },
  { .code = "OERSTED";    .bovnar = "Oe";     },
  { .code = "MHO";        .bovnar = "S";      },

  # Radioactivity and dose
  { .code = "CI";         .bovnar = "Ci";     },
  { .code = "R";          .bovnar = "R";      },
  { .code = "REM";        .bovnar = "rem";    },
  { .code = "R_man";      .bovnar = "rem";    },
  # RAD_R is the RAD, the absorbed dose -- 0.01 Gy, not 0.01 Sv. The two are
  # numerically equal and semantically not, which is the whole of doc/07 §12.
  # CentiGRAY leads because a flat profile writes back the FIRST code naming a
  # unit: a centigray that never said "rad" should not acquire the word here.
  { .code = "CentiGRAY";  .bovnar = "c~Gy";   },
  { .code = "RAD_R";      .bovnar = "c~Gy";   },

  # Photometry. PHOT and STILB are equal in value and different in kind -- an
  # illuminance against a luminance -- so a value-only match cannot tell them
  # apart and bvn_units_compatible refuses the pair outright.
  { .code = "PHOT";       .bovnar = "ph";      },
  { .code = "STILB";      .bovnar = "sb";      },
  { .code = "LM-PER-M2";  .bovnar = "lx";      },
  { .code = "CD-PER-M2";  .bovnar = "cd/m^2";  },   # a LUMINANCE, not the lux

  # Viscosity, acceleration, textile, area
  { .code = "POISE";             .bovnar = "P";    },
  { .code = "GM-PER-CentiM-SEC"; .bovnar = "P";    },
  { .code = "ST";                .bovnar = "St";   },
  { .code = "CentiM2-PER-SEC";   .bovnar = "St";   },
  { .code = "GALILEO";           .bovnar = "Gal";  },
  { .code = "CentiM-PER-SEC2";   .bovnar = "Gal";  },
  { .code = "TEX";               .bovnar = "tex";  },
  { .code = "GM-PER-KiloM";      .bovnar = "tex";  },
  { .code = "MilliGM-PER-M";     .bovnar = "tex";  },
  { .code = "BARN";              .bovnar = "barn"; },

  # Angle and rotation
  { .code = "GON";        .bovnar = "grad";   },
  { .code = "REV";        .bovnar = "rev";    },
  # PER-MIN is the RECIPROCAL MINUTE, so its target is the compound min^-1 and
  # NOT native rpm. The two are worth the same 1/60 s⁻¹ and are not the same
  # quantity: rpm counts revolutions, which is a claim about rotation that
  # "reciprocal minute" does not make -- the mirror image of the REV-PER-MIN
  # note above, and the same rule that keeps C97/PER-SEC off the hertz.
  { .code = "PER-MIN";    .bovnar = "min^-1"; },
  { .code = "PER-SEC";    .bovnar = "s^-1";   },   # unece spells this C97

  # ── Second synchronisation pass: prefixed and compound targets ────────────
  # The counterpart of the block at the end of unece.bvnr, and found the same
  # way. Every row below is a QUDT unit whose value is one this build already
  # spells and which this table did not carry -- most of them the coherent SI
  # unit of a kind qudt-qk.bvnr maps, which made the two QUDT namespaces
  # disagree about what their own publisher defines.
  { .code = "M2-PER-SEC";        .bovnar = "m^2/s";   },
  { .code = "M3-PER-SEC";        .bovnar = "m^3/s";   },
  { .code = "KiloGM-PER-SEC";    .bovnar = "k~g/s";   },
  { .code = "KiloGM-M-PER-SEC";  .bovnar = "k~g·m/s"; },
  { .code = "PA-SEC";            .bovnar = "Pa·s";    },
  { .code = "J-PER-K";           .bovnar = "J/K";     },
  { .code = "J-PER-KiloGM-K";    .bovnar = "J·k~g^-1·K^-1"; },
  { .code = "W-PER-M-K";         .bovnar = "W·m^-1·K^-1";   },
  { .code = "MOL-PER-M3";        .bovnar = "mol/m^3"; },
  { .code = "RAD-PER-SEC";       .bovnar = "rad/s";   },
  # PER-M leads DIOPTER for the same reason, and with the same non-consequence,
  # as unece:C92 leading Q25.
  { .code = "PER-M";             .bovnar = "m^-1";    },
  { .code = "DIOPTER";           .bovnar = "m^-1";    },
  { .code = "PER-CentiM";        .bovnar = "c~m^-1";  },
  { .code = "ARE";               .bovnar = "c~ha";    },
  { .code = "POND";              .bovnar = "g·gn";    },
  { .code = "KiloCAL_TH";        .bovnar = "k~cal";   },
  { .code = "DRAM_UK";           .bovnar = "dr";      },   # avoirdupois dram
  # Parts per thousand. ucum:[ppth] and native ‰ both had it; PPM and PPB were
  # here and the one between them was not. NOT reached through unece:NX, which
  # QUDT attaches to its PPT (10⁻¹²) as well -- a cross-reference that names two
  # units nine decades apart cannot settle anything.
  { .code = "PPTH";              .bovnar = "‰";       },

  # ── Closing the table against QUDT unit local names ─────────────────────
  #
  # Every row below was produced by carrying QUDT's OWN cross-reference over to
  # native, not by matching numbers: QUDT publishes a `qudt:ucumCode` (and a
  # `qudt:udunitsCode`) for most of what it defines, and this repository has
  # already proved its UCUM table against ucum-essence.xml. So a row here is a
  # row there, read twice -- which is both why the spelling is one a reader can
  # check and why §14's cross-vocabulary suite cannot find these two tables
  # disagreeing. A value match could not have done it: it cannot tell a sievert
  # from a gray.
  #
  # Where no cross-reference resolved, a value match was allowed only for a code
  # with a NON-ZERO dimension vector. Every dimensionless native unit shares one
  # dimension vector, so "worth 1 and dimensionless" matches the bit, the
  # radian and every ratio alike; those codes are refused below instead.
  #
  # .reverse = false throughout: these rows are here to be READ, and none of
  # them should change what bovnar writes.
  { .code = "A-HR";                          .bovnar = "A·h";                 .reverse = false; },
  { .code = "A-HR-PER-DeciM3";               .bovnar = "A·h/d~m^3";           .reverse = false; },
  { .code = "A-HR-PER-KiloGM";               .bovnar = "A·h/k~g";             .reverse = false; },
  { .code = "A-HR-PER-M2";                   .bovnar = "A·h/m^2";             .reverse = false; },
  { .code = "A-HR-PER-M3";                   .bovnar = "A·h/m^3";             .reverse = false; },
  { .code = "A-M2";                          .bovnar = "A·m^2";               .reverse = false; },
  { .code = "A-M2-PER-J-SEC";                .bovnar = "A·m^2/J·s";           .reverse = false; },
  { .code = "A-MIN";                         .bovnar = "A·min";               .reverse = false; },
  { .code = "A-PER-A-HR";                    .bovnar = "A/A·h";               .reverse = false; },
  { .code = "A-PER-CentiM";                  .bovnar = "A/c~m";               .reverse = false; },
  { .code = "A-PER-CentiM2";                 .bovnar = "A/c~m^2";             .reverse = false; },
  { .code = "A-PER-DEG_C";                   .bovnar = "A/K";                 .reverse = false; },
  { .code = "A-PER-GM";                      .bovnar = "A/g";                 .reverse = false; },
  { .code = "A-PER-J";                       .bovnar = "A/J";                 .reverse = false; },
  { .code = "A-PER-K";                       .bovnar = "A/K";                 .reverse = false; },
  { .code = "A-PER-KiloGM";                  .bovnar = "A/k~g";               .reverse = false; },
  { .code = "A-PER-M";                       .bovnar = "A/m";                 .reverse = false; },
  { .code = "A-PER-M2";                      .bovnar = "A/m^2";               .reverse = false; },
  { .code = "A-PER-M2-K2";                   .bovnar = "A/m^2·K^2";           .reverse = false; },
  { .code = "A-PER-MilliM";                  .bovnar = "A/m~m";               .reverse = false; },
  { .code = "A-PER-MilliM2";                 .bovnar = "A/m~m^2";             .reverse = false; },
  { .code = "A-PER-PA";                      .bovnar = "A/Pa";                .reverse = false; },
  { .code = "A-PER-RAD";                     .bovnar = "A/rad";               .reverse = false; },
  { .code = "A-SEC";                         .bovnar = "A·s";                 .reverse = false; },
  { .code = "A-SEC2";                        .bovnar = "A·s^2";               .reverse = false; },
  { .code = "A2-SEC";                        .bovnar = "A^2·s";               .reverse = false; },
  { .code = "ANGSTROM3";                     .bovnar = "Å^3";                 .reverse = false; },
  { .code = "AT";                            .bovnar = "A";                   .reverse = false; },
  { .code = "AT-PER-M";                      .bovnar = "A/m";                 .reverse = false; },
  { .code = "ATM-M3-PER-MOL";                .bovnar = "atm·m^3/mol";         .reverse = false; },
  { .code = "ATM-PER-M";                     .bovnar = "atm/m";               .reverse = false; },
  { .code = "ATM_T-PER-M";                   .bovnar = "at/m";                .reverse = false; },
  { .code = "A_Ab";                          .bovnar = "da~A";                },
  { .code = "A_Ab-CentiM2";                  .bovnar = "da~A·c~m^2";          .reverse = false; },
  { .code = "A_Ab-PER-CentiM2";              .bovnar = "da~A/c~m^2";          .reverse = false; },
  { .code = "AttoA";                         .bovnar = "a~A";                 },
  { .code = "AttoC";                         .bovnar = "a~C";                 },
  { .code = "AttoFARAD";                     .bovnar = "a~F";                 },
  { .code = "AttoJ";                         .bovnar = "a~J";                 },
  { .code = "AttoJ-SEC";                     .bovnar = "a~J·s";               .reverse = false; },
  { .code = "AttoSEC";                       .bovnar = "a~s";                 },
  { .code = "BAR-L-PER-SEC";                 .bovnar = "bar·L/s";             .reverse = false; },
  { .code = "BAR-M3-PER-SEC";                .bovnar = "bar·m^3/s";           .reverse = false; },
  { .code = "BAR-PER-BAR";                   .bovnar = "bar/bar";             .reverse = false; },
  { .code = "BAR-PER-K";                     .bovnar = "bar/K";               .reverse = false; },
  { .code = "BARAD";                         .bovnar = "µ~bar";               },
  { .code = "BARN-PER-EV";                   .bovnar = "barn/eV";             .reverse = false; },
  { .code = "BARN-PER-SR";                   .bovnar = "barn/sr";             .reverse = false; },
  { .code = "BARN-PER-SR-EV";                .bovnar = "barn/sr·eV";          .reverse = false; },
