  { .code = "IN_HG_60DEG_F";               .why = "QUDT states no conversionMultiplier for this unit"; },
  { .code = "IU-PER-MilliGM";             .why = "QUDT models the international unit as an AMOUNT OF SUBSTANCE and states this at 1 µmol/kg. An IU is assay-defined -- 1 IU of vitamin A is 0.3 µg retinol and 1 IU of vitamin D is 0.025 µg, so it is not a fixed molar quantity at all -- which is why UCUM declares [IU] arbitrary and bovnar carries it as an opaque unit commensurable with nothing. Mapping this would have made one library answer two ways about one quantity. Write ucum:[IU].mg-1, which keeps the arbitrariness"; },
