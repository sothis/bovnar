{
  "problemMatcher": [
    {
      "owner": "msvc",
      "pattern": [
        {
          "regexp": "^(.+)\\((\\d+)(?:,(\\d+))?\\)\\s*:\\s+(fatal error|error|warning)\\s+([A-Z]+\\d+)\\s*:\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      ]
    }
  ]
}
