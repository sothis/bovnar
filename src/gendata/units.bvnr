  # ── The ratio family below ppb ──────────────────────────────────────────
  # The dimensionless ratios stopped at ppb, and five profile codes were
  # refused for that one reason: ucum:[pptr], and udunits:ppt / pptv / ppq /
  # ppqv. Both publishers state them exactly (1e-12 and 1e-15) and both agree
  # with each other, which is the evidence a factor needs.
  #
  # THE SYMBOL IS "pptr", NOT "ppt", and for two independent reasons.
  #
  # The binding one is the rule at the top of this file: no existing document
  # may change meaning. "ppt" already resolves — as the compact form of p~pt,
  # the picopint — so claiming it would take a spelling away from the unit that
  # has it. check_alias_prefix_collisions in gen_units.py refuses exactly that,
  # and KNOWN_ALIAS_SHADOWS is not an escape hatch for a NEW unit.
  #
  # The second reason is that it would be the wrong symbol anyway. "ppt" is
  # ambiguous in the wild — parts per thousand in some industries, parts per
  # trillion in atmospheric chemistry, a factor of 10^9 apart, which is the
  # shape of the "kt" problem the compact-exception list refuses outright.
  # UCUM resolves it by spelling the two [ppth] and [pptr]; "pptr" is UCUM's
  # own token for this unit, so the symbol is borrowed rather than invented and
  # it cannot be read as per-thousand by anybody. A document that means per
  # thousand writes ‰, which has been the spelling for it all along.
  #
  # "pptv"/"ppqv" (the "by volume" spellings) are accepted as aliases because
  # UDUNITS defines them as the same 1e-12 and 1e-15; neither collides.
  {
    .id      = <uint:32> 100215;
    .name    = "ppt";
    .symbol  = "pptr";
    .factor  = 1e-12;
    .dims    = {};
    .affine  = false;
    .offset  = 0.0;
    .prefix  = ratio;
    .aliases = ["parts_per_trillion", "pptr", "pptv"];
  },
  {
    .id      = <uint:32> 100216;
    .name    = "ppq";
    .symbol  = "ppq";
    .factor  = 1e-15;
    .dims    = {};
    .affine  = false;
    .offset  = 0.0;
    .prefix  = ratio;
    .aliases = ["parts_per_quadrillion", "ppqv", "ppq"];
  },

