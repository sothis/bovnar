  # ── The units bu_survey_*, bu_darcy and friends unblocked ────────────
  # OM's acre-foot is the SURVEY one (1233.489 m^3), which is what ac_ft
  # now is; the PostScript point and pica are the DTP ones, 1/72 and 1/6
  # inch.
  { .code = "acre-USSurvey";                           .bovnar = "acUS";                },
  { .code = "fathom-USSurvey";                         .bovnar = "fathUS";              },
  { .code = "mile-USSurvey";                           .bovnar = "miUS";                },
  { .code = "rod-US";                                  .bovnar = "rdUS";                },
