<?xml version="1.0" encoding="UTF-8"?>
<!--
  freedesktop.org shared-mime-info database entry for the Bovnar (BVNR) format.

  Install system-wide:
      install -Dm644 text-vnd.bovnar.xml \
          /usr/share/mime/packages/text-vnd.bovnar.xml
      update-mime-database /usr/share/mime

  Or per-user:
      install -Dm644 text-vnd.bovnar.xml \
          ~/.local/share/mime/packages/text-vnd.bovnar.xml
      update-mime-database ~/.local/share/mime

  Detection is by the *.bvnr (and *.bovnar) glob, which is the reliable mechanism for a text
  format with no fixed byte signature (the same approach shared-mime-info uses
  for *.toml, *.ini, etc.). The one <magic> rule is the version directive,
  which an extension-less document may or may not carry.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/vnd.bovnar">
    <comment>Bovnar document</comment>
    <acronym>BVNR</acronym>
    <expanded-acronym>Bovnar typed, unit-aware serialisation</expanded-acronym>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.bvnr"/>
    <!-- The registration lists a second extension; it is rarer and the same type. -->
    <glob pattern="*.bovnar"/>
    <!-- The version directive (spec 1.1 and later) on the first line. -->
    <magic priority="50">
      <match type="string" value="#!bovnar " offset="0"/>
    </magic>
    <!-- No content heuristic beyond the directive. There used to be one — a
         newline followed by "." within the first 4 KiB — and it typed any
         extension-less text file with a line beginning with a full stop as a
         Bovnar document, system-wide. A document without the directive is
         recognised by its extension. -->
    <icon name="text-x-generic"/>
  </mime-type>
</mime-info>
